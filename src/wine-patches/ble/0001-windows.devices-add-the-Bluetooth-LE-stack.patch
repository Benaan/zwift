+        LeaveCriticalSection( &impl->cs );
+        return RO_E_CLOSED;
+    }
+    parent = impl->parent;
+    IBluetoothLEDevice_AddRef( parent );
+    LeaveCriticalSection( &impl->cs );
+    if (FAILED(hr = IBluetoothLEDevice_QueryInterface(parent, &IID_IBluetoothLEDevice3, (void **)&device3)))
+    {
+        IBluetoothLEDevice_Release( parent );
+        return hr;
+    }
+    hr = IBluetoothLEDevice3_get_DeviceAccessInformation(device3, out);
+    IBluetoothLEDevice3_Release(device3);
+    IBluetoothLEDevice_Release( parent );
+    return hr;
