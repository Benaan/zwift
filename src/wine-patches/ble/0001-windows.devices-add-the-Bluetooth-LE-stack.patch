+static HRESULT WINAPI custom_pairing_add_PairingRequested( IDeviceInformationCustomPairing *iface,
+        ITypedEventHandler_DeviceInformationCustomPairing_DevicePairingRequestedEventArgs *handler,
+        EventRegistrationToken *token )
+{
+    struct device_custom_pairing *impl = impl_from_IDeviceInformationCustomPairing( iface );
+    struct custom_pairing_handler *entry;
+
+    if (!handler || !token) return E_POINTER;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+
+    ITypedEventHandler_DeviceInformationCustomPairing_DevicePairingRequestedEventArgs_AddRef(
+            entry->handler = handler );
+    EnterCriticalSection( &impl->cs );
+    entry->token.value = InterlockedIncrement( &impl->next_token );
+    list_add_tail( &impl->handlers, &entry->entry );
+    LeaveCriticalSection( &impl->cs );
+    *token = entry->token;
+    return S_OK;
+}
+
+static HRESULT WINAPI custom_pairing_remove_PairingRequested( IDeviceInformationCustomPairing *iface,
+                                                              EventRegistrationToken token )
+{
+    struct device_custom_pairing *impl = impl_from_IDeviceInformationCustomPairing( iface );
+    struct custom_pairing_handler *handler, *next, *found = NULL;
+
+    EnterCriticalSection( &impl->cs );
+    LIST_FOR_EACH_ENTRY_SAFE( handler, next, &impl->handlers, struct custom_pairing_handler, entry )
+    {
+        if (handler->token.value == token.value)
+        {
+            list_remove( &handler->entry );
+            found = handler;
+            break;
+        }
+    }
+    LeaveCriticalSection( &impl->cs );
+    if (!found) return E_INVALIDARG;
+
+    /* Release outside the lock: the app's handler destructor may call back in. */
+    ITypedEventHandler_DeviceInformationCustomPairing_DevicePairingRequestedEventArgs_Release( found->handler );
+    free( found );
+    return S_OK;
+}
