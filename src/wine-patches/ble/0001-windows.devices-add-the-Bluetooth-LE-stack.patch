         if (FAILED(hr = marshal_object_in_agile_reference(impl, riid, obj)))
         {
             free(impl);
@@ -463,6 +486,7 @@ HRESULT WINAPI RoGetAgileReference(enum AgileReferenceOptions option, REFIID rii
         }
     }
 
+    TRACE("done\n");
     InitializeCriticalSection(&impl->cs);
 
