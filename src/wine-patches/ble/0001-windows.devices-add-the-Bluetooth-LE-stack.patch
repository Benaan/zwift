+/* Thin wrappers around the driver's connection reference IOCTLs. They exchange
+ * a small IRP only, so they do not block on the BlueZ DBus round trip; the
+ * driver queues the actual disconnect once the last reference is released. */
+static void bluetoothledevice_device_ioctl( HANDLE device, ULONG code, const void *in, DWORD in_size )
+{
+    DWORD bytes;
+
+    if (!DeviceIoControl( device, code, (void *)in, in_size, NULL, 0, &bytes, NULL ))
+        WARN( "ioctl %#lx failed: %#lx\n", code, GetLastError() );
+}
+void bluetoothledevice_connection_hold( HANDLE device )
+{
+    TRACE( "(%p)\n", device );
+    bluetoothledevice_device_ioctl( device, IOCTL_WINEBTH_DEVICE_ACQUIRE, NULL, 0 );
+}
+void bluetoothledevice_connection_release( HANDLE device )
+{
+    TRACE( "(%p)\n", device );
+    bluetoothledevice_device_ioctl( device, IOCTL_WINEBTH_DEVICE_RELEASE, NULL, 0 );
+}
+void bluetoothledevice_set_maintain( HANDLE device, BOOL value )
+{
+    TRACE( "(%p, %u)\n", device, value );
+    bluetoothledevice_device_ioctl( device, IOCTL_WINEBTH_DEVICE_SET_MAINTAIN, &value, sizeof(value) );
+}
