+static HRESULT characteristic_operation( struct characteristic *impl, struct winebth_gatt_params *params )
+{
+    DWORD bytes;
+    TRACE("characteristic %#x, operation %u, size %u\n", impl->props.AttributeHandle, params->operation, params->size);
+    params->service_handle = impl->props.ServiceHandle;
+    params->characteristic_handle = impl->props.AttributeHandle;
+    if (!DeviceIoControl( impl->device, IOCTL_WINEBTH_LE_GATT_OPERATION, params, sizeof(*params),
+                         params, sizeof(*params), &bytes, NULL ))
+    {
+        HRESULT hr = HRESULT_FROM_WIN32( GetLastError() );
+        WARN( "characteristic %#x operation %u failed: %#x\n", impl->props.AttributeHandle, params->operation, hr );
+        return hr;
+    }
+    TRACE( "characteristic %#x operation %u ok: cccd %u size %u\n", impl->props.AttributeHandle,
+           params->operation, params->cccd, params->size );
+    return S_OK;
+}
+static HRESULT WINAPI characteristic_QueryInterface( IGattCharacteristic *iface, REFIID iid, void **out )
+{
+    struct characteristic *impl = impl_from_characteristic( iface );
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IGattCharacteristic))
+        *out = iface;
+    else if (IsEqualGUID(iid, &IID_IGattCharacteristic2)) *out = &impl->IGattCharacteristic2_iface;
+    else if (IsEqualGUID(iid, &IID_IGattCharacteristic3)) *out = &impl->IGattCharacteristic3_iface;
+    if (!*out) return E_NOINTERFACE;
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
