+static void bluez_ad_append( struct winebluetooth_ad_data *data, BYTE type, const void *bytes, unsigned int size )
+{
+    if (size > 254 || size + 2 > sizeof(data->data) - data->size)
+    {
+        WARN( "Advertisement property exceeds supported size.\n" );
+        return;
+    }
+    data->data[data->size++] = size + 1;
+    data->data[data->size++] = type;
+    memcpy( data->data + data->size, bytes, size );
+    data->size += size;
+}
