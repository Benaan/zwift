+static void watcher_notify_received( struct adv_watcher *impl, const struct winebth_advertisement *adv )
+{
+    struct received_args *args;
+    IBluetoothLEAdvertisementFilter *filter;
+    IBluetoothSignalStrengthFilter *signal;
+    IReference_INT16 *threshold = NULL, *out_threshold = NULL;
+    BOOL matches;
+    INT16 rssi;
+    if (!(args = calloc( 1, sizeof(*args) ))) return;
+    args->IBluetoothLEAdvertisementReceivedEventArgs_iface.lpVtbl = &received_args_vtbl;
+    args->ref = 1;
+    args->address = adv->address;
+    args->rssi = adv->rssi;
+    args->timestamp.UniversalTime = adv->timestamp;
+    if (FAILED(advertisement_parse( adv->data, adv->size, &args->advertisement )))
+    {
+        free( args );
+        return;
+    }
+    EnterCriticalSection( &impl->cs );
+    if ((filter = impl->advertisement_filter)) IBluetoothLEAdvertisementFilter_AddRef( filter );
+    if ((signal = impl->signal_filter)) IBluetoothSignalStrengthFilter_AddRef( signal );
+    LeaveCriticalSection( &impl->cs );
+    matches = advertisement_matches( args->advertisement, filter );
+    if (signal)
+    {
+        INT16 value;
+        /* Apply both RSSI thresholds. OutOfRangeTimeout and SamplingInterval are
+         * accepted but not implemented: BlueZ reports every advertisement as it
+         * arrives and does not expose a signal-strength sampling window, so the
+         * in/out-of-range hysteresis cannot be timed here. */
+        if (SUCCEEDED(IBluetoothSignalStrengthFilter_get_InRangeThresholdInDBm( signal, &threshold )) && threshold &&
+            SUCCEEDED(IReference_INT16_get_Value( threshold, &rssi )) && adv->rssi < rssi) matches = FALSE;
+        if (SUCCEEDED(IBluetoothSignalStrengthFilter_get_OutOfRangeThresholdInDBm( signal, &out_threshold )) && out_threshold &&
+            SUCCEEDED(IReference_INT16_get_Value( out_threshold, &value )) && adv->rssi <= value) matches = FALSE;
+        if (threshold) IReference_INT16_Release( threshold );
+        if (out_threshold) IReference_INT16_Release( out_threshold );
+    }
+    if (filter) IBluetoothLEAdvertisementFilter_Release( filter );
+    if (signal) IBluetoothSignalStrengthFilter_Release( signal );
+    if (matches)
+    {
+        TRACE( "delivering advertisement %I64x rssi %d size %u\n",
+               (unsigned long long)args->address, args->rssi, adv->size );
+        watcher_invoke( impl, &impl->received_handlers,
+                        (IInspectable *)&args->IBluetoothLEAdvertisementReceivedEventArgs_iface, TRUE );
+    }
+    else
+        TRACE( "advertisement %I64x rssi %d dropped by filter\n",
+               (unsigned long long)args->address, args->rssi );
+    IBluetoothLEAdvertisementReceivedEventArgs_Release( &args->IBluetoothLEAdvertisementReceivedEventArgs_iface );
+}
+
+static HRESULT handler_add( struct adv_watcher *impl, struct list *list, const IID *iid, IUnknown *handler,
+                            EventRegistrationToken *token )
+{
+    struct watcher_handler *entry;
+
+    if (!handler || !token) return E_INVALIDARG;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    IUnknown_AddRef( handler );
+    entry->handler = handler;
+    entry->iid = iid;
+    /* Best effort: an agile handler resolves to itself, a marshaled one to a proxy.
+     * Use delayed marshaling: eager RoGetAgileReference() marshals on the registering
+     * thread and can deadlock in the loader while the UI thread registers a handler. */
+    TRACE( "handler %p iid %s, getting agile reference\n", handler, debugstr_guid( iid ) );
+    if (FAILED(RoGetAgileReference( AGILEREFERENCE_DELAYEDMARSHAL, iid, handler, &entry->agile )))
+        entry->agile = NULL;
+    TRACE( "handler %p agile %p\n", handler, entry->agile );
+    entry->token.value = InterlockedIncrement( &impl->next_token );
+    EnterCriticalSection( &impl->cs );
+    list_add_tail( list, &entry->entry );
+    *token = entry->token;
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static HRESULT handler_remove( struct adv_watcher *impl, struct list *list, EventRegistrationToken token )
+{
+    struct watcher_handler *entry, *next;
+
+    EnterCriticalSection( &impl->cs );
+    LIST_FOR_EACH_ENTRY_SAFE( entry, next, list, struct watcher_handler, entry )
+    {
+        if (entry->token.value != token.value) continue;
+        list_remove( &entry->entry );
+        LeaveCriticalSection( &impl->cs );
+        IUnknown_Release( entry->handler );
+        if (entry->agile) IAgileReference_Release( entry->agile );
+        free( entry );
+        return S_OK;
+    }
+    LeaveCriticalSection( &impl->cs );
+    return E_INVALIDARG;
+}
