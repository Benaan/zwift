+/* Release this device's connection reference exactly once, whichever of
+ * IClosable::Close() or the final Release() happens first. */
+static void ble_device_release_connection( struct ble_device *impl )
+{
+    BOOL held;
+
+    EnterCriticalSection(&impl->cs);
+    held = impl->conn_held;
+    impl->conn_held = FALSE;
+    LeaveCriticalSection(&impl->cs);
+
+    if (held)
+        bluetoothledevice_connection_release( impl->device );
+}
+static HRESULT WINAPI device_closable_Close( IClosable *iface )
+{
+    struct ble_device *impl = impl_from_IClosable(iface);
+    LONG was_closed;
+
+    TRACE( "(%p, address %#I64x)\n", iface, impl->addr );
+    EnterCriticalSection(&impl->cs);
+    was_closed = InterlockedExchange(&impl->closed, TRUE);
+    SetEvent(impl->stop);
+    LeaveCriticalSection(&impl->cs);
+
+    if (!was_closed)
+        ble_device_release_connection( impl );
+    return S_OK;
+}
