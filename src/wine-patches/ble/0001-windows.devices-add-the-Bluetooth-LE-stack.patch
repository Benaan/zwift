+static HRESULT gatt_io_async( IUnknown *invoker, IUnknown *param, PROPVARIANT *out, BOOL called_async )
+{
+    struct characteristic *impl = impl_from_characteristic((IGattCharacteristic *)invoker);
+    struct gatt_request *request = impl_from_gatt_request((IInspectable *)param);
+    struct winebth_gatt_params params = request->params;
+    HRESULT hr;
+
+    if (!called_async) return STATUS_PENDING;
+    EnterCriticalSection(&impl->operation_cs);
+    if (params.operation == WINEBTH_GATT_START_NOTIFY || params.operation == WINEBTH_GATT_STOP_NOTIFY)
+    {
+        /* Preserve the requested Notify/Indicate configuration: only skip the
+         * backend request when it would not change the active configuration. */
+        params.cccd = request->cccd;
+        if ((params.operation == WINEBTH_GATT_START_NOTIFY && impl->cccd == request->cccd) ||
+            (params.operation == WINEBTH_GATT_STOP_NOTIFY && !impl->cccd))
+            hr = S_OK;
+        else
+        {
+            /* Record the notification cursor before enabling notifications. Some
+             * peripherals push a value as soon as the CCCD
+             * is written; without seeding the cursor beforehand the poll worker
+             * would treat that first value as already seen and never deliver it. */
+            if (params.operation == WINEBTH_GATT_START_NOTIFY)
+            {
+                struct winebth_gatt_params cursor = {.operation = WINEBTH_GATT_POLL};
+                if (SUCCEEDED(characteristic_operation(impl, &cursor)))
+                {
+                    impl->sequence = cursor.sequence;
+                    impl->generation = cursor.generation;
+                }
+            }
+            hr = characteristic_operation(impl, &params);
+        }
+        if (SUCCEEDED(hr)) impl->cccd = request->cccd;
+    }
+    else hr = characteristic_operation(impl, &params);
+    LeaveCriticalSection(&impl->operation_cs);
+    if (params.operation == WINEBTH_GATT_READ)
+    {
+        struct read_result *result;
+        if (!(result = calloc(1, sizeof(*result)))) return E_OUTOFMEMORY;
+        result->IGattReadResult_iface.lpVtbl = &read_result_vtbl;
+        result->ref = 1;
+        result->status = gatt_status(hr);
+        if (SUCCEEDED(hr) && FAILED(hr = bluetooth_buffer_create(params.value, params.size, &result->buffer)))
+        {
+            free(result);
+            return hr;
+        }
+        out->vt = VT_UNKNOWN;
+        out->punkVal = (IUnknown *)&result->IGattReadResult_iface;
+    }
+    else if (request->object_result)
+    {
+        struct write_result *result;
+        if (!(result = calloc(1, sizeof(*result)))) return E_OUTOFMEMORY;
+        result->IGattWriteResult_iface.lpVtbl = &write_result_vtbl;
+        result->ref = 1;
+        result->status = gatt_status(hr);
+        result->error = hr;
+        out->vt = VT_UNKNOWN;
+        out->punkVal = (IUnknown *)&result->IGattWriteResult_iface;
+    }
+    else
+    {
+        out->vt = VT_UI4;
+        out->ulVal = gatt_status(hr);
+    }
+    return S_OK;
+}
+static HRESULT characteristic_async( IGattCharacteristic *iface, unsigned int operation, IBuffer *buffer,
+                                     GattClientCharacteristicConfigurationDescriptorValue cccd, BOOL object_result,
+                                     const GUID *iid, void **out )
+{
+    struct gatt_request *request;
+    IBufferByteAccess *access;
+    BYTE *data;
+    HRESULT hr = S_OK;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(request = calloc(1, sizeof(*request)))) return E_OUTOFMEMORY;
+    request->IInspectable_iface.lpVtbl = &gatt_request_vtbl;
+    request->ref = 1;
+    request->params.operation = operation;
+    request->cccd = cccd;
+    request->object_result = object_result;
+    if (buffer)
+    {
+        hr = IBuffer_get_Length(buffer, &request->params.size);
+        if (SUCCEEDED(hr) && request->params.size > sizeof(request->params.value)) hr = E_INVALIDARG;
+        if (SUCCEEDED(hr)) hr = IBuffer_QueryInterface(buffer, &IID_IBufferByteAccess, (void **)&access);
+        if (SUCCEEDED(hr))
+        {
+            if (SUCCEEDED(hr = IBufferByteAccess_Buffer(access, &data)))
+                memcpy(request->params.value, data, request->params.size);
+            IBufferByteAccess_Release(access);
+        }
+    }
+    if (SUCCEEDED(hr))
+    {
+        if (object_result)
+            hr = async_operation_inspectable_create(iid, (IUnknown *)iface, (IUnknown *)&request->IInspectable_iface,
+                                                     gatt_io_async, (IAsyncOperation_IInspectable **)out);
+        else
+            hr = async_operation_status_create(iid, (IUnknown *)iface, (IUnknown *)&request->IInspectable_iface,
+                                                gatt_io_async, (IAsyncOperation_GattCommunicationStatus **)out);
+    }
+    IInspectable_Release(&request->IInspectable_iface);
+    return hr;
+}
