+static HRESULT cccd_read_async( IUnknown *invoker, IUnknown *param, PROPVARIANT *out, BOOL called_async )
+{
+    struct characteristic *impl = impl_from_characteristic((IGattCharacteristic *)invoker);
+    struct winebth_gatt_params params = {.operation = WINEBTH_GATT_READ_CCCD};
+    struct cccd_result *result;
+    HRESULT hr;
+
+    if (!called_async) return STATUS_PENDING;
+    if (!(result = calloc(1, sizeof(*result)))) return E_OUTOFMEMORY;
+    result->IGattReadClientCharacteristicConfigurationDescriptorResult_iface.lpVtbl = &cccd_result_vtbl;
+    result->ref = 1;
+
+    /* Query the shared, authoritative configuration instead of returning this
+     * object's cached value, so disconnects, missing descriptors and other
+     * subscribers are reflected and backend errors are propagated. */
+    EnterCriticalSection(&impl->operation_cs);
+    hr = characteristic_operation(impl, &params);
+    if (SUCCEEDED(hr))
+    {
+        result->value = params.cccd;
+        impl->cccd = params.cccd;
+    }
+    LeaveCriticalSection(&impl->operation_cs);
+    result->status = gatt_status(hr);
+
+    out->vt = VT_UNKNOWN;
+    out->punkVal = (IUnknown *)&result->IGattReadClientCharacteristicConfigurationDescriptorResult_iface;
+    return S_OK;
+}
+static HRESULT WINAPI characteristic_ReadClientCharacteristicConfigurationDescriptorAsync( IGattCharacteristic *iface,
+          IAsyncOperation_GattReadClientCharacteristicConfigurationDescriptorResult **out )
+{
+    TRACE( "iface %p\n", iface );
+    return async_operation_inspectable_create(&IID_IAsyncOperation_GattReadClientCharacteristicConfigurationDescriptorResult,
+              (IUnknown *)iface, NULL, cccd_read_async, (IAsyncOperation_IInspectable **)out);
+}
+static HRESULT characteristic_cccd( IGattCharacteristic *iface, GattClientCharacteristicConfigurationDescriptorValue value, BOOL object_result, void **out )
+{
+    struct characteristic *impl = impl_from_characteristic(iface);
+    TRACE( "iface %p handle %#x value %d notify %d indicate %d\n", iface, impl->props.AttributeHandle, value,
+           impl->props.IsNotifiable, impl->props.IsIndicatable );
+    if (value != GattClientCharacteristicConfigurationDescriptorValue_None &&
+        value != GattClientCharacteristicConfigurationDescriptorValue_Notify &&
+        value != GattClientCharacteristicConfigurationDescriptorValue_Indicate) return E_INVALIDARG;
+    if ((value == GattClientCharacteristicConfigurationDescriptorValue_Notify && !impl->props.IsNotifiable) ||
+        (value == GattClientCharacteristicConfigurationDescriptorValue_Indicate && !impl->props.IsIndicatable)) return E_INVALIDARG;
+    return characteristic_async(iface, value ? WINEBTH_GATT_START_NOTIFY : WINEBTH_GATT_STOP_NOTIFY, NULL, value, object_result,
+                                object_result ? &IID_IAsyncOperation_GattWriteResult : &IID_IAsyncOperation_GattCommunicationStatus, out);
+}
+static HRESULT WINAPI characteristic_WriteClientCharacteristicConfigurationDescriptorAsync( IGattCharacteristic *iface,
+          GattClientCharacteristicConfigurationDescriptorValue value, IAsyncOperation_GattCommunicationStatus **out )
+{
+    return characteristic_cccd(iface, value, FALSE, (void **)out);
+}
