+static void test_advertisement_collections(void)
+{
+    const WCHAR *class_name = RuntimeClass_Windows_Devices_Bluetooth_Advertisement_BluetoothLEAdvertisement;
+    GUID uuid = {0x1826, 0, 0x1000, {0x80, 0, 0, 0x80, 0x5f, 0x9b, 0x34, 0xfb}}, values[2];
+    IBluetoothLEAdvertisement *advertisement;
+    IVector_GUID *uuids;
+    IVectorView_GUID *view;
+    IIterable_GUID *iterable;
+    IIterator_GUID *iterator;
+    IVectorView_BluetoothLEManufacturerData *manufacturers;
+    IVectorView_BluetoothLEAdvertisementDataSection *sections;
+    IInspectable *instance;
+    HSTRING name, local_name;
+    UINT32 size, copied, index;
+    boolean found, current;
+    HRESULT hr;
+
+    WindowsCreateString(class_name, wcslen(class_name), &name);
+    hr = RoActivateInstance(name, &instance);
+    WindowsDeleteString(name);
+    ok(hr == S_OK, "Activation failed: %#lx.\n", hr);
+    if (FAILED(hr)) return;
+    hr = IInspectable_QueryInterface(instance, &IID_IBluetoothLEAdvertisement, (void **)&advertisement);
+    IInspectable_Release(instance);
+    ok(hr == S_OK, "QueryInterface failed: %#lx.\n", hr);
+    if (FAILED(hr)) return;
+    hr = IBluetoothLEAdvertisement_get_LocalName(advertisement, &local_name);
+    ok(hr == S_OK, "get_LocalName failed: %#lx.\n", hr);
+    ok(WindowsIsStringEmpty(local_name), "Expected empty name.\n");
+    WindowsDeleteString(local_name);
+    hr = IBluetoothLEAdvertisement_get_ServiceUuids(advertisement, &uuids);
+    ok(hr == S_OK, "get_ServiceUuids failed: %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IVector_GUID_get_Size(uuids, &size);
+        ok(hr == S_OK && !size, "Expected empty vector, hr %#lx, size %u.\n", hr, size);
+        copied = 123;
+        hr = IVector_GUID_GetMany(uuids, 0, ARRAY_SIZE(values), values, &copied);
+        ok(hr == S_OK && !copied, "Empty GetMany: hr %#lx, copied %u.\n", hr, copied);
+        hr = IVector_GUID_Append(uuids, uuid);
+        ok(hr == S_OK, "Append failed: %#lx.\n", hr);
+        hr = IVector_GUID_IndexOf(uuids, uuid, &index, &found);
+        ok(hr == S_OK && found && !index, "IndexOf: hr %#lx, found %d, index %u.\n", hr, found, index);
+        hr = IVector_GUID_GetView(uuids, &view);
+        ok(hr == S_OK, "GetView failed: %#lx.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            hr = IVectorView_GUID_GetAt(view, 0, values);
+            ok(hr == S_OK && IsEqualGUID(values, &uuid), "Unexpected UUID, hr %#lx.\n", hr);
+            copied = 123;
+            hr = IVectorView_GUID_GetMany(view, 1, ARRAY_SIZE(values), values, &copied);
+            ok(hr == S_OK && !copied, "End GetMany: hr %#lx, copied %u.\n", hr, copied);
+            IVectorView_GUID_Release(view);
+        }
+        hr = IVector_GUID_QueryInterface(uuids, &IID_IIterable_GUID, (void **)&iterable);
+        ok(hr == S_OK, "Iterable QI failed: %#lx.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            hr = IIterable_GUID_First(iterable, &iterator);
+            ok(hr == S_OK, "First failed: %#lx.\n", hr);
+            if (SUCCEEDED(hr))
+            {
+                hr = IIterator_GUID_GetMany(iterator, ARRAY_SIZE(values), values, &copied);
+                ok(hr == S_OK && copied == 1 && IsEqualGUID(values, &uuid), "Iterator GetMany: %#lx, %u.\n", hr, copied);
+                hr = IIterator_GUID_get_HasCurrent(iterator, &current);
+                ok(hr == S_OK && !current, "Iterator did not advance, hr %#lx.\n", hr);
+                IIterator_GUID_Release(iterator);
+            }
+            IIterable_GUID_Release(iterable);
+        }
+        hr = IVector_GUID_Clear(uuids);
+        ok(hr == S_OK, "Clear failed: %#lx.\n", hr);
+        IVector_GUID_Release(uuids);
+    }
+    hr = IBluetoothLEAdvertisement_GetManufacturerDataByCompanyId(advertisement, 0xffff, &manufacturers);
+    ok(hr == S_OK, "Manufacturer lookup failed: %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IVectorView_BluetoothLEManufacturerData_get_Size(manufacturers, &size);
+        ok(hr == S_OK && !size, "Unexpected manufacturer count %u, hr %#lx.\n", size, hr);
+        IVectorView_BluetoothLEManufacturerData_Release(manufacturers);
+    }
+    hr = IBluetoothLEAdvertisement_GetSectionsByType(advertisement, 0xff, &sections);
+    ok(hr == S_OK, "Section lookup failed: %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IVectorView_BluetoothLEAdvertisementDataSection_get_Size(sections, &size);
+        ok(hr == S_OK && !size, "Unexpected section count %u, hr %#lx.\n", size, hr);
+        IVectorView_BluetoothLEAdvertisementDataSection_Release(sections);
+    }
+    IBluetoothLEAdvertisement_Release(advertisement);
+}
+
+static void test_uuid_helper(void)
+{
+    const WCHAR *name = RuntimeClass_Windows_Devices_Bluetooth_BluetoothUuidHelper;
+    const UINT32 ids[] = {0, 1, 0x1800, 0x1818, 0x1826, 0xffff, 0x10000, 0x12345678, 0x80000000, 0xffffffff};
+    IActivationFactory *factory;
+    IBluetoothUuidHelperStatics *statics;
+    IReference_UINT32 *ref;
+    GUID uuid, expected;
+    UINT32 value;
+    unsigned int i;
+    HSTRING str;
+    HRESULT hr;
+
+    hr = WindowsCreateString(name, wcslen(name), &str);
+    ok(hr == S_OK, "WindowsCreateString returned %#lx\n", hr);
+    hr = RoGetActivationFactory(str, &IID_IActivationFactory, (void **)&factory);
+    WindowsDeleteString(str);
+    if (hr == REGDB_E_CLASSNOTREG) { win_skip("BluetoothUuidHelper unavailable.\n"); return; }
+    ok(hr == S_OK, "activation returned %#lx\n", hr);
+    if (FAILED(hr)) return;
+    check_interface(factory, &IID_IUnknown);
+    check_interface(factory, &IID_IInspectable);
+    check_interface(factory, &IID_IAgileObject);
+    hr = IActivationFactory_QueryInterface(factory, &IID_IBluetoothUuidHelperStatics, (void **)&statics);
+    ok(hr == S_OK, "QueryInterface returned %#lx\n", hr);
+    IActivationFactory_Release(factory);
+    if (FAILED(hr)) return;
+    check_interface(statics, &IID_IUnknown);
+    check_interface(statics, &IID_IInspectable);
+    check_interface(statics, &IID_IAgileObject);
+    for (i = 0; i < ARRAY_SIZE(ids); i++)
+    {
+        expected = BTH_LE_ATT_BLUETOOTH_BASE_GUID;
+        expected.Data1 = ids[i];
+        hr = IBluetoothUuidHelperStatics_FromShortId(statics, ids[i], &uuid);
+        ok(hr == S_OK, "FromShortId returned %#lx\n", hr);
+        ok(IsEqualGUID(&uuid, &expected), "unexpected UUID %s\n", debugstr_guid(&uuid));
+        ref = NULL;
+        hr = IBluetoothUuidHelperStatics_TryGetShortId(statics, uuid, &ref);
+        ok(hr == S_OK && ref, "TryGetShortId returned %#lx, %p\n", hr, ref);
+        if (ref)
+        {
+            value = ~ids[i];
+            hr = IReference_UINT32_get_Value(ref, &value);
+            ok(hr == S_OK && value == ids[i], "got %#lx, %#x expected %#x\n", hr, value, ids[i]);
+            IReference_UINT32_Release(ref);
+        }
+    }
+    /* A vendor UUID is not a short Bluetooth UUID, even if Data1 fits 16 bits. */
+    uuid = (GUID){1, 0x19ca, 0x4651, {0x86, 0xe5, 0xfa, 0x29, 0xdc, 0xdd, 0x09, 0xd1}};
+    ref = (void *)0xdeadbeef;
+    hr = IBluetoothUuidHelperStatics_TryGetShortId(statics, uuid, &ref);
+    ok(hr == S_OK && !ref, "vendor UUID returned %#lx, %p\n", hr, ref);
+    /* A mismatch anywhere in the remaining 96 bits must reject the UUID. */
+    for (i = sizeof(uuid.Data1); i < sizeof(uuid); i++)
+    {
+        uuid = BTH_LE_ATT_BLUETOOTH_BASE_GUID;
+        uuid.Data1 = 0x1800;
+        ((BYTE *)&uuid)[i] ^= 1;
+        ref = (void *)0xdeadbeef;
+        hr = IBluetoothUuidHelperStatics_TryGetShortId(statics, uuid, &ref);
+        ok(hr == S_OK && !ref, "non-base UUID byte %u returned %#lx, %p\n", i, hr, ref);
+    }
+    IBluetoothUuidHelperStatics_Release(statics);
+}
+
+static void test_bluetoothdeviceid_from_id( void )
+{
+    const WCHAR *name = RuntimeClass_Windows_Devices_Bluetooth_BluetoothDeviceId;
+    static const WCHAR le_id[] = L"BluetoothLE#BluetoothLE00:11:22:33:44:55-aa:bb:cc:dd:ee:ff";
+    static const WCHAR classic_id[] = L"Bluetooth#Bluetooth00:11:22:33:44:55-aa:bb:cc:dd:ee:ff";
+    static const WCHAR malformed_id[] = L"not-a-device-id";
+    IBluetoothDeviceIdStatics *statics;
+    IBluetoothDeviceId *id;
+    HSTRING str;
+    boolean value;
+    HRESULT hr;
+
+    WindowsCreateString(name, wcslen(name), &str);
+    hr = RoGetActivationFactory(str, &IID_IBluetoothDeviceIdStatics, (void **)&statics);
+    WindowsDeleteString(str);
+    ok(hr == S_OK, "BluetoothDeviceId activation returned %#lx\n", hr);
+    if (FAILED(hr)) return;
+
+    id = (void *)0xdeadbeef;
+    hr = IBluetoothDeviceIdStatics_FromId(statics, NULL, &id);
+    ok(hr == E_INVALIDARG && !id, "NULL id returned %#lx, %p\n", hr, id);
+
+    WindowsCreateString(le_id, ARRAY_SIZE(le_id) - 1, &str);
+    id = NULL;
+    hr = IBluetoothDeviceIdStatics_FromId(statics, str, &id);
+    ok(hr == S_OK && id, "FromId returned %#lx, %p\n", hr, id);
+    if (SUCCEEDED(hr))
+    {
+        hr = IBluetoothDeviceId_get_IsLowEnergyDevice(id, &value);
+        ok(hr == S_OK && value, "IsLowEnergyDevice: %#lx, %u\n", hr, value);
+        hr = IBluetoothDeviceId_get_IsClassicDevice(id, &value);
+        ok(hr == S_OK && !value, "IsClassicDevice: %#lx, %u\n", hr, value);
+        IBluetoothDeviceId_Release(id);
+    }
+    WindowsDeleteString(str);
+
+    WindowsCreateString(classic_id, ARRAY_SIZE(classic_id) - 1, &str);
+    id = NULL;
+    hr = IBluetoothDeviceIdStatics_FromId(statics, str, &id);
+    ok(hr == S_OK && id, "FromId returned %#lx, %p\n", hr, id);
+    if (SUCCEEDED(hr))
+    {
+        hr = IBluetoothDeviceId_get_IsClassicDevice(id, &value);
+        ok(hr == S_OK && value, "IsClassicDevice: %#lx, %u\n", hr, value);
+        hr = IBluetoothDeviceId_get_IsLowEnergyDevice(id, &value);
+        ok(hr == S_OK && !value, "IsLowEnergyDevice: %#lx, %u\n", hr, value);
+        IBluetoothDeviceId_Release(id);
+    }
+    WindowsDeleteString(str);
+
+    WindowsCreateString(malformed_id, ARRAY_SIZE(malformed_id) - 1, &str);
+    id = (void *)0xdeadbeef;
+    hr = IBluetoothDeviceIdStatics_FromId(statics, str, &id);
+    ok(hr == E_INVALIDARG && !id, "malformed id returned %#lx, %p\n", hr, id);
+    WindowsDeleteString(str);
+
+    IBluetoothDeviceIdStatics_Release(statics);
+}
