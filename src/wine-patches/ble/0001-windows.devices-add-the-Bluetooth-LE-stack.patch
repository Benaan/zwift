+static HRESULT data_writer_write_string(IDataWriter *iface, HSTRING value, boolean measure, UINT32 *byte_count)
+{
+    struct data_writer *impl = impl_from_IDataWriter(iface);
+    const WCHAR *str;
+    UINT32 len, size;
+
+    str = WindowsGetStringRawBuffer(value, &len);
+    if (!len)
+    {
+        if (byte_count) *byte_count = 0;
+        return S_OK;
+    }
+
+    if (impl->unicode_encoding == UnicodeEncoding_Utf8)
+    {
+        char *utf8;
+        int utf8_size;
+        HRESULT hr;
+
+        if (!(utf8_size = WideCharToMultiByte(CP_UTF8, 0, str, len, NULL, 0, NULL, NULL)))
+            return HRESULT_FROM_WIN32(GetLastError());
+        size = utf8_size;
+        if (byte_count) *byte_count = size;
+        if (measure) return S_OK;
+        if (!(utf8 = malloc(size))) return E_OUTOFMEMORY;
+        WideCharToMultiByte(CP_UTF8, 0, str, len, utf8, size, NULL, NULL);
+        hr = data_writer_WriteBytes(iface, size, (BYTE *)utf8);
+        free(utf8);
+        return hr;
+    }
+
+    /* WriteString/MeasureString report the encoded size, which for UTF-16 is two bytes per code unit. */
+    size = len * sizeof(WCHAR);
+    if (byte_count) *byte_count = size;
+    if (measure) return S_OK;
+
+    if (impl->unicode_encoding == UnicodeEncoding_Utf16BE)
+    {
+        WCHAR *copy;
+        UINT32 i;
+        HRESULT hr;
+
+        if (!(copy = malloc(size))) return E_OUTOFMEMORY;
+        for (i = 0; i < len; i++) copy[i] = (str[i] >> 8) | (str[i] << 8);
+        hr = data_writer_WriteBytes(iface, size, (BYTE *)copy);
+        free(copy);
+        return hr;
+    }
+
+    return data_writer_WriteBytes(iface, size, (BYTE *)str);
