+}
+
+static HRESULT WINAPI session_get_DeviceId( IGattSession *iface, IBluetoothDeviceId **out )
+{
+    struct session *impl = impl_from_session(iface);
+    HSTRING id;
+    HRESULT hr;
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (impl->closed) return RO_E_CLOSED;
+    if (FAILED(hr = IBluetoothLEDevice_get_DeviceId(impl->parent, &id))) return hr;
+    hr = bluetoothdeviceid_create(id, out);
+    WindowsDeleteString(id);
+    return hr;
+}
+static HRESULT WINAPI session_get_CanMaintainConnection( IGattSession *iface, boolean *out )
+{
+    TRACE( "iface %p\n", iface );
+    if (!out) return E_POINTER;
+    if (impl_from_session(iface)->closed) return RO_E_CLOSED;
+    *out = TRUE;
+    return S_OK;
+}
+static HRESULT WINAPI session_get_MaintainConnection( IGattSession *iface, boolean *out )
+{
+    struct session *impl = impl_from_session(iface);
+    if (!out) return E_POINTER;
+    if (impl->closed) return RO_E_CLOSED;
+    EnterCriticalSection(&impl->cs);
+    *out = impl->maintain;
+    LeaveCriticalSection(&impl->cs);
+    TRACE( "iface %p -> %u\n", iface, *out );
+    return S_OK;
+}
+static HRESULT WINAPI session_get_MaxPduSize( IGattSession *iface, UINT16 *out )
+{
+    struct session *impl = impl_from_session(iface);
+    struct winebth_gatt_params params = {.operation = WINEBTH_GATT_GET_MTU, .service_handle = impl->service_handle};
+    DWORD bytes;
+    if (!out) return E_POINTER;
+    *out = 0;
+    if (impl->closed) return RO_E_CLOSED;
+    if (!DeviceIoControl(impl->device, IOCTL_WINEBTH_LE_GATT_OPERATION, &params, sizeof(params),
+                         &params, sizeof(params), &bytes, NULL)) return HRESULT_FROM_WIN32(GetLastError());
+    if (params.size < 23 || params.size > 517) return E_UNEXPECTED;
+    *out = params.size;
+    TRACE( "iface %p -> %u\n", iface, *out );
+    return S_OK;
+}
+static HRESULT session_read_state( struct session *impl, struct winebth_le_state *state )
+{
+    DWORD bytes;
+    if (impl->closed) return RO_E_CLOSED;
+    if (!DeviceIoControl(impl->device, IOCTL_WINEBTH_LE_GET_STATE, NULL, 0, state, sizeof(*state), &bytes, NULL))
+        return HRESULT_FROM_WIN32(GetLastError());
+    return S_OK;
+}
+static HRESULT WINAPI session_get_SessionStatus( IGattSession *iface, GattSessionStatus *out )
+{
+    struct session *impl = impl_from_session(iface);
+    struct winebth_le_state state;
+    HRESULT hr;
+    if (!out) return E_POINTER;
+    if (FAILED(hr = session_read_state( impl, &state ))) return hr;
+    *out = state.connected && state.services_resolved ? GattSessionStatus_Active : GattSessionStatus_Closed;
+    return S_OK;
+}
+static void session_notify( struct session *impl, BOOL status_event, GattSessionStatus status )
+{
+    struct session_handler *handlers = NULL;
+    struct session_args *args = NULL;
+    unsigned int count, i;
+    if (status_event)
+    {
+        if (!(args = calloc(1, sizeof(*args)))) return;
+        args->IGattSessionStatusChangedEventArgs_iface.lpVtbl = &session_args_vtbl;
+        args->ref = 1;
+        args->status = status;
+    }
+    EnterCriticalSection(&impl->cs);
+    count = impl->closed ? 0 : impl->count;
+    if (count && (handlers = malloc(count * sizeof(*handlers))))
+    {
+        memcpy(handlers, impl->handlers, count * sizeof(*handlers));
+        for (i = 0; i < count; i++)
+        {
+            ITypedEventHandler_IInspectable_IInspectable_AddRef(handlers[i].handler);
+            if (handlers[i].agile) IAgileReference_AddRef(handlers[i].agile);
+        }
+    }
+    LeaveCriticalSection(&impl->cs);
+    if (handlers)
+    {
+        for (i = 0; i < count; i++)
+        {
+            if (handlers[i].status == status_event)
+            {
+                ITypedEventHandler_IInspectable_IInspectable *handler = handlers[i].handler;
+                void *resolved = NULL;
+
+                /* Resolve in this apartment so a non-agile handler is invoked through a proxy. */
+                if (handlers[i].agile &&
+                    SUCCEEDED(IAgileReference_Resolve(handlers[i].agile, session_handler_iid(handlers[i].status), &resolved)))
+                    handler = (ITypedEventHandler_IInspectable_IInspectable *)resolved;
+
+                ITypedEventHandler_IInspectable_IInspectable_Invoke(handler,
+                    (IInspectable *)&impl->IGattSession_iface, (IInspectable *)args);
+                if (resolved) IUnknown_Release((IUnknown *)resolved);
+            }
+            ITypedEventHandler_IInspectable_IInspectable_Release(handlers[i].handler);
+            if (handlers[i].agile) IAgileReference_Release(handlers[i].agile);
+        }
+        free(handlers);
+    }
+    if (args) IGattSessionStatusChangedEventArgs_Release(&args->IGattSessionStatusChangedEventArgs_iface);
+}
+static DWORD WINAPI session_worker( void *data )
+{
+    struct session *impl = data;
+    GattSessionStatus status = GattSessionStatus_Closed, previous = GattSessionStatus_Closed;
+    UINT16 mtu = 0, previous_mtu = 0;
+    UINT64 address = 0, advertisement_sequence = 0;
+    ULONGLONG retry = 0, retry_delay = 1000;
+    BOOL first_iteration = TRUE, mtu_known = FALSE;
+    HRESULT init = RoInitialize(RO_INIT_MULTITHREADED);
+    session_get_SessionStatus(&impl->IGattSession_iface, &previous);
+    mtu_known = SUCCEEDED(session_get_MaxPduSize(&impl->IGattSession_iface, &previous_mtu)) && previous_mtu != 0;
+    /* Fire the initial status event so subscribers that joined after the
+     * session was already Active learn the current value. The session
+     * otherwise relies on transitions, so a session that was Active
+     * from the start would never fire. */
+    if (previous != GattSessionStatus_Closed) session_notify(impl, TRUE, previous);
+    while (WaitForSingleObject(impl->stop, 200) == WAIT_TIMEOUT)
+    {
+        struct winebth_le_state state;
+        BOOL maintain;
+        if (FAILED(session_read_state( impl, &state )))
+        {
+            /* The PDO backing this session was removed and its handle cannot be
+             * rebound. Stop reconnecting the vanished object; a rediscovered device
+             * gets a new device object and session. */
+            if (status != GattSessionStatus_Closed) session_notify(impl, TRUE, GattSessionStatus_Closed);
+            break;
+        }
+        status = state.connected && state.services_resolved ? GattSessionStatus_Active : GattSessionStatus_Closed;
+        /* A fresh advertisement means the device is actually reachable, so pull the
+         * next attempt in. Cap the pull so a device that advertises continuously but
+         * still refuses to connect cannot turn into a reconnect storm: at most one
+         * prompt attempt per second. */
+        if (state.advertisement_sequence && state.advertisement_sequence != advertisement_sequence)
+        {
+            ULONGLONG now = GetTickCount64();
+
+            advertisement_sequence = state.advertisement_sequence;
+            if (status == GattSessionStatus_Closed)
+            {
+                if (retry_delay > 1000) retry_delay = 1000;
+                if (retry > now + 1000) retry = now + 1000;
+            }
+        }
+        if (first_iteration || status != previous)
+        {
+            session_notify(impl, TRUE, status);
+            first_iteration = FALSE;
+            /* A working link proves the address is reachable again: start the next
+             * reconnect attempt from the base delay instead of the capped one. */
+            if (status == GattSessionStatus_Active) retry_delay = 1000;
+        }
+        previous = status;
+        /* Read the MTU once per active connection. Polling it every 200 ms (as the
+         * previous code did) kept the D-Bus link busy with property reads, which is
+         * both wasteful and destabilizing for the LE link. */
+        if (status != GattSessionStatus_Active)
+        {
+            previous_mtu = 0;
+            mtu_known = FALSE;
+        }
+        else if (!mtu_known &&
+                 SUCCEEDED(session_get_MaxPduSize(&impl->IGattSession_iface, &mtu)))
+        {
+            mtu_known = TRUE;
+            previous_mtu = mtu;
+            session_notify(impl, FALSE, status);
+        }
+        EnterCriticalSection(&impl->cs);
+        maintain = impl->maintain && !impl->closed;
+        LeaveCriticalSection(&impl->cs);
+        if (maintain && status == GattSessionStatus_Closed && GetTickCount64() >= retry)
+        {
+            ULONGLONG now = GetTickCount64(), jitter;
+
+            if (SUCCEEDED(IBluetoothLEDevice_get_BluetoothAddress(impl->parent, &address)))
+                bluetooth_connect_address(address);
+            /* Bounded exponential backoff with jitter so failed sessions for the same
+             * unreachable address do not all retry in lockstep. */
+            jitter = retry_delay / 5;
+            if (jitter) jitter = (now ^ (address ? address : 1)) % jitter;
+            retry = now + retry_delay + jitter;
+            if (retry_delay < 30000) retry_delay *= 2;
+            if (retry_delay > 30000) retry_delay = 30000;
+        }
+    }
+    EnterCriticalSection(&impl->cs);
+    impl->running = FALSE;
+    LeaveCriticalSection(&impl->cs);
+    if (SUCCEEDED(init)) RoUninitialize();
+    IGattSession_Release(&impl->IGattSession_iface);
+    return 0;
+}
+/* Called with cs held. */
+static HRESULT session_start( struct session *impl )
+{
+    HANDLE thread;
+    HRESULT hr;
+    if (impl->running) { ResetEvent(impl->stop); return S_OK; }
+    ResetEvent(impl->stop);
+    impl->running = TRUE;
+    IGattSession_AddRef(&impl->IGattSession_iface);
+    if (!(thread = CreateThread(NULL, 0, session_worker, impl, 0, NULL)))
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        impl->running = FALSE;
+        IGattSession_Release(&impl->IGattSession_iface);
+        return hr;
+    }
+    CloseHandle(thread);
+    return S_OK;
+}
+static HRESULT WINAPI session_put_MaintainConnection( IGattSession *iface, boolean value )
+{
+    struct session *impl = impl_from_session(iface);
+    HRESULT hr = S_OK;
+    TRACE( "iface %p, value %u\n", iface, value );
+    EnterCriticalSection(&impl->cs);
+    if (impl->closed) hr = RO_E_CLOSED;
+    else if (!value || SUCCEEDED(hr = session_start(impl))) impl->maintain = !!value;
+    LeaveCriticalSection(&impl->cs);
+    if (SUCCEEDED(hr))
+        bluetoothledevice_set_maintain( impl->device, !!value );
+    return hr;
+}
+static HRESULT session_add_handler( struct session *impl, IUnknown *handler, BOOL status, EventRegistrationToken *token )
+{
+    IAgileReference *agile = NULL;
+    struct session_handler *tmp;
+    HRESULT hr;
+    if (!handler || !token) return E_POINTER;
+    token->value = 0;
+    /* Best effort: marshal the handler so the session worker can invoke a non-agile one. */
+    if (FAILED(RoGetAgileReference( AGILEREFERENCE_DELAYEDMARSHAL, session_handler_iid( status ), handler, &agile )))
+        agile = NULL;
+    EnterCriticalSection(&impl->cs);
+    if (impl->closed) hr = RO_E_CLOSED;
+    else if (!(tmp = realloc(impl->handlers, (impl->count + 1) * sizeof(*tmp)))) hr = E_OUTOFMEMORY;
+    else
+    {
+        impl->handlers = tmp;
+        if (SUCCEEDED(hr = session_start(impl)))
+        {
+            token->value = ++impl->next_token;
+            impl->handlers[impl->count].handler = (ITypedEventHandler_IInspectable_IInspectable *)handler;
+            impl->handlers[impl->count].token = *token;
+            impl->handlers[impl->count].status = status;
+            impl->handlers[impl->count++].agile = agile;
+            IUnknown_AddRef(handler);
+        }
+    }
+    LeaveCriticalSection(&impl->cs);
+    if (FAILED(hr) && agile) IAgileReference_Release(agile);
+    return hr;
+}
+static HRESULT session_remove_handler( struct session *impl, EventRegistrationToken token, BOOL status )
+{
+    ITypedEventHandler_IInspectable_IInspectable *handler = NULL;
+    IAgileReference *agile = NULL;
+    unsigned int i;
+    EnterCriticalSection(&impl->cs);
+    for (i = 0; i < impl->count; i++)
+        if (impl->handlers[i].token.value == token.value && impl->handlers[i].status == status)
+        {
+            handler = impl->handlers[i].handler;
+            agile = impl->handlers[i].agile;
+            memmove(&impl->handlers[i], &impl->handlers[i + 1], (--impl->count - i) * sizeof(*impl->handlers));
+            break;
+        }
+    LeaveCriticalSection(&impl->cs);
+    if (handler) ITypedEventHandler_IInspectable_IInspectable_Release(handler);
+    if (agile) IAgileReference_Release(agile);
+    return S_OK;
+}
+static HRESULT WINAPI session_add_MaxPduSizeChanged( IGattSession *iface,
+    ITypedEventHandler_GattSession_IInspectable *handler, EventRegistrationToken *token )
+{
+    return session_add_handler(impl_from_session(iface), (IUnknown *)handler, FALSE, token);
+}
+static HRESULT WINAPI session_remove_MaxPduSizeChanged( IGattSession *iface, EventRegistrationToken token )
+{
+    return session_remove_handler(impl_from_session(iface), token, FALSE);
+}
+static HRESULT WINAPI session_add_SessionStatusChanged( IGattSession *iface,
+    ITypedEventHandler_GattSession_GattSessionStatusChangedEventArgs *handler, EventRegistrationToken *token )
+{
+    return session_add_handler(impl_from_session(iface), (IUnknown *)handler, TRUE, token);
+}
+static HRESULT WINAPI session_remove_SessionStatusChanged( IGattSession *iface, EventRegistrationToken token )
+{
+    return session_remove_handler(impl_from_session(iface), token, TRUE);
+}
+static const IGattSessionVtbl session_vtbl =
+{
+    session_QueryInterface, session_AddRef, session_Release, session_GetIids,
+    session_GetRuntimeClassName, session_GetTrustLevel, session_get_DeviceId,
+    session_get_CanMaintainConnection, session_put_MaintainConnection, session_get_MaintainConnection,
+    session_get_MaxPduSize, session_get_SessionStatus, session_add_MaxPduSizeChanged,
+    session_remove_MaxPduSizeChanged, session_add_SessionStatusChanged, session_remove_SessionStatusChanged
+};
+DEFINE_IINSPECTABLE(session_closable, IClosable, struct session, IGattSession_iface);
+/* Release this session's connection reference exactly once, whichever of
+ * IClosable::Close() or the final Release() happens first. */
+static void session_release_connection( struct session *impl )
+{
+    BOOL held;
+
+    EnterCriticalSection(&impl->cs);
+    held = impl->conn_held;
+    impl->conn_held = FALSE;
+    LeaveCriticalSection(&impl->cs);
+
+    if (held)
+    {
+        /* The app may have pinned the link with MaintainConnection; clear that
+         * before dropping our reference so the driver can disconnect. */
+        bluetoothledevice_set_maintain( impl->device, FALSE );
+        bluetoothledevice_connection_release( impl->device );
+    }
+}
+static HRESULT WINAPI session_closable_Close( IClosable *iface )
+{
+    struct session *impl = impl_from_IClosable(iface);
+    BOOL was_closed;
+
+    TRACE( "(%p)\n", iface );
+    EnterCriticalSection(&impl->cs);
+    was_closed = impl->closed;
+    impl->closed = TRUE;
+    impl->maintain = FALSE;
+    SetEvent(impl->stop);
+    LeaveCriticalSection(&impl->cs);
+
+    if (!was_closed)
+        session_release_connection( impl );
+    return S_OK;
+}
+static const IClosableVtbl session_closable_vtbl =
+{
+    session_closable_QueryInterface, session_closable_AddRef, session_closable_Release,
+    session_closable_GetIids, session_closable_GetRuntimeClassName, session_closable_GetTrustLevel,
+    session_closable_Close
+};
+/* Classify an id accepted by BluetoothDeviceId.FromId. Windows uses
+ * "BluetoothLE#" for low-energy and "Bluetooth#" for classic device IDs;
+ * Wine additionally exposes LE devices as device interface paths. */
+static HRESULT bluetoothdeviceid_classify( const WCHAR *id, BOOL *low_energy, BOOL *classic )
+{
+    *low_energy = FALSE;
+    *classic = FALSE;
+    if (!wcsncmp( id, L"BluetoothLE#", 12 )) *low_energy = TRUE;
+    else if (!wcsncmp( id, L"Bluetooth#", 10 )) *classic = TRUE;
+    else if (!wcsncmp( id, L"\\\\?\\", 4 )) *low_energy = TRUE;
+    else return E_INVALIDARG;
+    return S_OK;
+}
+
+HRESULT bluetoothdeviceid_create( HSTRING id, IBluetoothDeviceId **out )
+{
+    struct device_id *impl;
+    const WCHAR *raw;
+    BOOL low_energy, classic;
+    HRESULT hr;
+
+    TRACE( "(%s, %p)\n", debugstr_hstring( id ), out );
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!id || WindowsIsStringEmpty( id )) return E_INVALIDARG;
+    if (!(raw = WindowsGetStringRawBuffer( id, NULL ))) return E_INVALIDARG;
+    if (FAILED(hr = bluetoothdeviceid_classify( raw, &low_energy, &classic ))) return hr;
+    if (!(impl = calloc( 1, sizeof( *impl )))) return E_OUTOFMEMORY;
+    if (FAILED(hr = WindowsDuplicateString( id, &impl->id )))
+    {
+        free( impl );
+        return hr;
+    }
+    impl->IBluetoothDeviceId_iface.lpVtbl = &device_id_vtbl;
+    impl->ref = 1;
+    impl->low_energy = low_energy;
+    impl->classic = classic;
+    *out = &impl->IBluetoothDeviceId_iface;
+    return S_OK;
+}
+
+HRESULT gatt_session_create( HANDLE device, IBluetoothLEDevice *parent, UINT16 service_handle, IGattSession **out )
+{
+    struct session *impl;
+    HRESULT hr;
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(impl = calloc(1, sizeof(*impl)))) return E_OUTOFMEMORY;
+    if (!DuplicateHandle(GetCurrentProcess(), device, GetCurrentProcess(), &impl->device, 0, FALSE, DUPLICATE_SAME_ACCESS))
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        free(impl);
+        return hr;
+    }
+    if (!(impl->stop = CreateEventW(NULL, TRUE, FALSE, NULL)))
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        CloseHandle(impl->device);
+        free(impl);
+        return hr;
+    }
+    InitializeCriticalSection(&impl->cs);
+    impl->IGattSession_iface.lpVtbl = &session_vtbl;
+    impl->IClosable_iface.lpVtbl = &session_closable_vtbl;
+    impl->ref = 1;
+    impl->parent = parent;
+    IBluetoothLEDevice_AddRef(parent);
+    impl->service_handle = service_handle;
+    bluetoothledevice_connection_hold( impl->device );
+    impl->conn_held = TRUE;
+    *out = &impl->IGattSession_iface;
+    return S_OK;
+}
