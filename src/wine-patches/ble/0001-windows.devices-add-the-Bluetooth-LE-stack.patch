+/* Return the vtable a boxed object should use. The native vccorlib returns a
+ * generic IBox/IBoxArray vtable. Wine does not implement that generic vtable, but
+ * the vtable the compiler already installed in the object is ABI-compatible for
+ * in-process C++/CX consumers, so keep it. */
+void *WINAPI GetIBoxArrayVtable(void *obj)
+{
+    TRACE("(%p)\n", obj);
+    return obj ? *(void **)obj : NULL;
+}
+
+void *WINAPI GetIBoxVtable(void *obj)
+{
+    TRACE("(%p)\n", obj);
+    return obj ? *(void **)obj : NULL;
+}
