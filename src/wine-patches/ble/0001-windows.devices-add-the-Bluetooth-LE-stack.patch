+
+static ULONG WINAPI gatt_session_factory_Release( IActivationFactory *iface )
+{
+    struct gatt_session_statics *impl = gatt_session_impl_from_IActivationFactory( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    TRACE( "(%p)\n", iface );
+    return ref;
+}
