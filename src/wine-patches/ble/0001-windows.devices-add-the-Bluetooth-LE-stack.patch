+HRESULT gatt_service_create( HANDLE device, IBluetoothLEDevice *parent, const BTH_LE_GATT_SERVICE *svc,
+                             HSTRING device_id, IGattDeviceService **out )
+{
+    struct gatt_service *impl;
+    HRESULT hr;
+    *out = NULL;
+    if (!(impl = calloc(1, sizeof(*impl)))) return E_OUTOFMEMORY;
+    if (!DuplicateHandle(GetCurrentProcess(), device, GetCurrentProcess(), &impl->device, 0, FALSE, DUPLICATE_SAME_ACCESS))
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        free(impl);
+        return hr;
+    }
     impl->IGattDeviceService_iface.lpVtbl = &gatt_service_vtbl;
+    impl->IGattDeviceService2_iface.lpVtbl = &service2_vtbl;
+    impl->IGattDeviceService3_iface.lpVtbl = &service3_vtbl;
+    impl->IClosable_iface.lpVtbl = &service_closable_vtbl;
+    InitializeCriticalSection( &impl->cs );
     impl->ref = 1;
     impl->service = *svc;
-    *service = &impl->IGattDeviceService_iface;
+    impl->parent = parent;
+    IBluetoothLEDevice_AddRef(parent);
+    if (device_id) hr = WindowsDuplicateString( device_id, &impl->device_id );
+    *out = &impl->IGattDeviceService_iface;
     return S_OK;
 }
