+static void test_radio( IRadio *radio )
+{
+    struct { RadioState state; DWORD sentinel; } state = {RadioState_Unknown, 0xdeadbeef};
+    RadioKind kind;
+    EventRegistrationToken first, second;
+    HSTRING name;
+    HRESULT hr;
+
+    check_interface(radio, &IID_IRadio);
+    check_interface(radio, &IID_IAgileObject);
+    hr = IRadio_get_Kind(radio, &kind);
+    ok(hr == S_OK, "get_Kind returned %#lx\n", hr);
+    if (kind != RadioKind_Bluetooth) return;
+    hr = IRadio_add_StateChanged(radio, &state_handler, &first);
+    ok(hr == S_OK, "add_StateChanged returned %#lx\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IRadio_add_StateChanged(radio, &state_handler, &second);
+        ok(hr == S_OK, "second add_StateChanged returned %#lx\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            ok(first.value != second.value, "duplicate event tokens\n");
+            hr = IRadio_remove_StateChanged(radio, second);
+            ok(hr == S_OK, "remove_StateChanged returned %#lx\n", hr);
+        }
+        hr = IRadio_remove_StateChanged(radio, first);
+        ok(hr == S_OK, "remove_StateChanged returned %#lx\n", hr);
+    }
+    hr = IRadio_get_State(radio, &state.state);
+    ok(hr == S_OK, "get_State returned %#lx\n", hr);
+    ok(state.state <= RadioState_Disabled, "invalid state %u\n", state.state);
+    ok(state.sentinel == 0xdeadbeef, "State overwrote adjacent memory\n");
+    hr = IRadio_get_Name(radio, &name);
+    ok(hr == S_OK, "get_Name returned %#lx\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        trace("Bluetooth radio %s, state %u\n", debugstr_w(WindowsGetStringRawBuffer(name, NULL)), state.state);
+        WindowsDeleteString(name);
+    }
+}
