+static HRESULT WINAPI pairing_get_IsPaired( IDeviceInformationPairing *iface, boolean *out )
+{
+    struct device_pairing *impl = impl_from_IDeviceInformationPairing( iface );
+    HSTRING id = NULL;
+    const WCHAR *buf;
+    UINT32 len;
+    WCHAR *path;
+    HANDLE device;
+    BOOL paired = FALSE;
+    DWORD bytes;
+
+    if (!out) return E_POINTER;
+    *out = FALSE;
+
+    /* Report the BlueZ Device1.Paired state. A device that is paired without a stored key
+     * (the "ghost bond" the Windows client detects) still reads as paired here, so the
+     * caller can decide to UnpairAsync before pairing again. */
+    if (FAILED(IDeviceInformation_get_Id( impl->device, &id ))) return S_OK;
+    buf = WindowsGetStringRawBuffer( id, &len );
+    if (!(path = malloc( (len + 1) * sizeof(WCHAR) ))) { WindowsDeleteString( id ); return E_OUTOFMEMORY; }
+    memcpy( path, buf, len * sizeof(WCHAR) );
+    path[len] = 0;
+    WindowsDeleteString( id );
+
+    if ((device = CreateFileW( path, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                               NULL, OPEN_EXISTING, 0, NULL )) != INVALID_HANDLE_VALUE)
+    {
+        if (DeviceIoControl( device, IOCTL_WINEBTH_DEVICE_GET_PAIRED, NULL, 0, &paired, sizeof(paired), &bytes, NULL ))
+            *out = paired ? TRUE : FALSE;
+        CloseHandle( device );
+    }
+    free( path );
+    return S_OK;
+}
