+static DWORD WINAPI watcher_thread( void *param )
+{
+    struct adv_watcher *impl = param;
+    struct radio_scan { HANDLE radio; UINT64 sequence; BOOL discovery; } *radios = NULL, *tmp;
+    BLUETOOTH_FIND_RADIO_PARAMS params = {sizeof(params)};
+    struct winebth_advertisement adv;
+    HBLUETOOTH_RADIO_FIND find;
+    HANDLE radio, stop_event = impl->stop_event;
+    BluetoothError error = BluetoothError_RadioNotAvailable;
+    BluetoothLEScanningMode mode;
+    DWORD bytes;
+    UINT32 count = 0, i;
+    HRESULT hr = RoInitialize( RO_INIT_MULTITHREADED );
+
+    EnterCriticalSection( &impl->cs );
+    mode = impl->mode;
+    LeaveCriticalSection( &impl->cs );
+
+    if ((find = BluetoothFindFirstRadio( &params, &radio )))
+    {
+        do
+        {
+            adv.sequence = 0;
+            if ((tmp = realloc( radios, (count + 1) * sizeof(*radios) )))
+            {
+                radios = tmp;
+                /* BlueZ always performs active scanning, so Passive and Active are
+                 * distinguished only from None here; the scan parameters that would
+                 * make Passive request no scan responses are not exposed over D-Bus. */
+                if (DeviceIoControl( radio, IOCTL_WINEBTH_RADIO_GET_ADVERTISEMENT, &adv, sizeof(adv.sequence),
+                                     &adv, sizeof(adv), &bytes, NULL ) &&
+                    (mode == BluetoothLEScanningMode_None ||
+                     DeviceIoControl( radio, IOCTL_WINEBTH_RADIO_START_LE_DISCOVERY, NULL, 0, NULL, 0, &bytes, NULL )))
+                {
+                    radios[count].radio = radio;
+                    radios[count].discovery = mode != BluetoothLEScanningMode_None;
+                    radios[count++].sequence = 0;
+                    continue;
+                }
+            }
+            CloseHandle( radio );
+        } while (BluetoothFindNextRadio( find, &radio ));
+        BluetoothFindRadioClose( find );
+    }
+    if (count) error = BluetoothError_Success;
+    while (count && WaitForSingleObject( stop_event, 100 ) == WAIT_TIMEOUT)
+    {
+        for (i = 0; i < count; i++)
+        {
+            /* Bound each batch so a busy adapter cannot starve Stop or other radios. */
+            unsigned int batch;
+            for (batch = 0; batch < 64 && WaitForSingleObject( stop_event, 0 ) == WAIT_TIMEOUT; batch++)
+            {
+                adv.sequence = radios[i].sequence;
+                if (!DeviceIoControl( radios[i].radio, IOCTL_WINEBTH_RADIO_GET_ADVERTISEMENT,
+                                      &adv, sizeof(adv.sequence), &adv, sizeof(adv), &bytes, NULL ))
+                {
+                    error = BluetoothError_RadioNotAvailable;
+                    SetEvent( stop_event );
+                    break;
+                }
+                radios[i].sequence = adv.sequence;
+                if (!adv.address) break;
+                if (adv.size <= sizeof(adv.data)) watcher_notify_received( impl, &adv );
+            }
+        }
+    }
+    for (i = 0; i < count; i++)
+    {
+        if (radios[i].discovery)
+            DeviceIoControl( radios[i].radio, IOCTL_WINEBTH_RADIO_STOP_DISCOVERY, NULL, 0, NULL, 0, &bytes, NULL );
+        CloseHandle( radios[i].radio );
+    }
+    free( radios );
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == BluetoothLEAdvertisementWatcherStatus_Stopping) error = BluetoothError_Success;
+    impl->status = error == BluetoothError_Success ? BluetoothLEAdvertisementWatcherStatus_Stopped :
+                                                   BluetoothLEAdvertisementWatcherStatus_Aborted;
+    impl->stop_event = NULL;
+    LeaveCriticalSection( &impl->cs );
+    CloseHandle( stop_event );
+    watcher_notify_stopped( impl, error );
+    if (SUCCEEDED(hr)) RoUninitialize();
+    IBluetoothLEAdvertisementWatcher_Release( &impl->IBluetoothLEAdvertisementWatcher_iface );
+    return 0;
+}
