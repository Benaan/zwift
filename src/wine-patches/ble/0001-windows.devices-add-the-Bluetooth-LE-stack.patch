+static HRESULT WINAPI service3_get_Session( IGattDeviceService3 *iface, IGattSession **out )
+{
+    struct gatt_service *impl = impl_from_IGattDeviceService3(iface);
+    IGattSession *session;
+    HRESULT hr;
+    if (!out) return E_POINTER;
+    *out = NULL;
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->closed)
+    {
+        LeaveCriticalSection( &impl->cs );
+        return RO_E_CLOSED;
+    }
+    if (!(session = impl->session))
+    {
+        if (FAILED(hr = gatt_session_create(impl->device, impl->parent, impl->service.AttributeHandle, &session)))
+        {
+            LeaveCriticalSection( &impl->cs );
+            return hr;
+        }
+        impl->session = session;
+    }
+    IGattSession_AddRef( session );
+    LeaveCriticalSection( &impl->cs );
+
+    *out = session;
