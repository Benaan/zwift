+static void test_session_from_device_id( IBluetoothLEDevice *device )
+{
+    const WCHAR *name = RuntimeClass_Windows_Devices_Bluetooth_BluetoothDeviceId;
+    IAsyncOperationCompletedHandler_IInspectable *handler;
+    IBluetoothDeviceIdStatics *ids;
+    IGattSessionStatics *sessions;
+    IBluetoothDeviceId *id, *session_id;
+    IAsyncOperation_GattSession *async;
+    IGattSession *session = NULL;
+    GattSessionStatus status;
+    IClosable *closable;
+    HSTRING str, device_id, result_id;
+    boolean maintain;
+    HANDLE event;
+    UINT16 mtu;
+    HRESULT hr;
+    INT32 comparison;
+    DWORD wait;
+
+    WindowsCreateString(name, wcslen(name), &str);
+    hr = RoGetActivationFactory(str, &IID_IBluetoothDeviceIdStatics, (void **)&ids);
+    WindowsDeleteString(str);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (FAILED(hr)) return;
+    hr = IBluetoothLEDevice_get_DeviceId(device, &device_id);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IBluetoothDeviceIdStatics_FromId(ids, device_id, &id);
+    IBluetoothDeviceIdStatics_Release(ids);
+    ok(hr == S_OK, "FromId returned %#lx\n", hr);
+    if (FAILED(hr)) { WindowsDeleteString(device_id); return; }
+
+    name = RuntimeClass_Windows_Devices_Bluetooth_GenericAttributeProfile_GattSession;
+    WindowsCreateString(name, wcslen(name), &str);
+    hr = RoGetActivationFactory(str, &IID_IGattSessionStatics, (void **)&sessions);
+    WindowsDeleteString(str);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IGattSessionStatics_FromDeviceIdAsync(sessions, id, &async);
+    IGattSessionStatics_Release(sessions);
+    ok(hr == S_OK, "FromDeviceIdAsync returned %#lx\n", hr);
+    if (FAILED(hr)) goto done;
+    event = CreateEventW(NULL, TRUE, FALSE, NULL);
+    handler = inspectable_async_handler_create(event, &IID_IAsyncOperationCompletedHandler_GattSession);
+    hr = IAsyncOperation_GattSession_put_Completed(async, (IAsyncOperationCompletedHandler_GattSession *)handler);
+    ok(hr == S_OK, "put_Completed returned %#lx\n", hr);
+    wait = WaitForSingleObject(event, 10000);
+    ok(wait == WAIT_OBJECT_0, "session creation timed out: %lu\n", wait);
+    if (wait == WAIT_OBJECT_0)
+    {
+        hr = IAsyncOperation_GattSession_GetResults(async, &session);
+        ok(hr == S_OK && session, "GetResults returned %#lx, %p\n", hr, session);
+    }
+    IAsyncOperation_GattSession_Release(async);
+    /* The delegate owns this event until a potentially late completion. */
+    if (wait == WAIT_OBJECT_0) CloseHandle(event);
+    IAsyncOperationCompletedHandler_IInspectable_Release(handler);
+    if (!session) goto done;
+
+    hr = IGattSession_get_DeviceId(session, &session_id);
+    ok(hr == S_OK, "get_DeviceId returned %#lx\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IBluetoothDeviceId_get_Id(session_id, &result_id);
+        ok(hr == S_OK, "get_Id returned %#lx\n", hr);
+        WindowsCompareStringOrdinal(device_id, result_id, &comparison);
+        ok(!comparison, "session device ID changed\n");
+        WindowsDeleteString(result_id);
+        IBluetoothDeviceId_Release(session_id);
+    }
+    hr = IGattSession_get_MaintainConnection(session, &maintain);
+    ok(hr == S_OK && !maintain, "initial MaintainConnection: %#lx, %u\n", hr, maintain);
+    hr = IGattSession_get_SessionStatus(session, &status);
+    ok(hr == S_OK, "get_SessionStatus returned %#lx\n", hr);
+    if (SUCCEEDED(hr) && status == GattSessionStatus_Active)
+    {
+        hr = IGattSession_get_MaxPduSize(session, &mtu);
+        ok(hr == S_OK && mtu >= 23 && mtu <= 517, "device session MTU: %#lx, %u\n", hr, mtu);
+        hr = IGattSession_put_MaintainConnection(session, TRUE);
+        ok(hr == S_OK, "put_MaintainConnection returned %#lx\n", hr);
+        hr = IGattSession_get_MaintainConnection(session, &maintain);
+        ok(hr == S_OK && maintain, "MaintainConnection: %#lx, %u\n", hr, maintain);
