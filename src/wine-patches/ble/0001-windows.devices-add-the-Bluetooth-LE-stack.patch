+static void test_gatt_session( IGattDeviceService *service )
+{
+    IGattDeviceService3 *service3;
+    IBluetoothDeviceId *device_id;
+    IGattSession *session;
+    GattSessionStatus status;
+    HSTRING id = NULL;
+    boolean value;
+    HRESULT hr;
+
+    hr = IGattDeviceService_QueryInterface(service, &IID_IGattDeviceService3, (void **)&service3);
+    if (hr == E_NOINTERFACE) { win_skip("IGattDeviceService3 unavailable.\n"); return; }
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (FAILED(hr)) return;
+    hr = IGattDeviceService3_get_Session(service3, &session);
+    IGattDeviceService3_Release(service3);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (FAILED(hr)) return;
+    check_interface(session, &IID_IClosable);
+    hr = IGattSession_get_CanMaintainConnection(session, &value);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IGattSession_get_MaintainConnection(session, &value);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(!value, "unexpected maintain connection\n");
+    hr = IGattSession_get_SessionStatus(session, &status);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (SUCCEEDED(hr))
+        ok(status == GattSessionStatus_Active || status == GattSessionStatus_Closed, "got %u\n", status);
+    hr = IGattSession_get_DeviceId(session, &device_id);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IBluetoothDeviceId_get_Id(device_id, &id);
+        ok(hr == S_OK, "got %#lx\n", hr);
+        ok(!WindowsIsStringEmpty(id), "empty device id\n");
+        WindowsDeleteString(id);
+        hr = IBluetoothDeviceId_get_IsLowEnergyDevice(device_id, &value);
+        ok(hr == S_OK && value, "got %#lx, value %u\n", hr, value);
+        hr = IBluetoothDeviceId_get_IsClassicDevice(device_id, &value);
+        ok(hr == S_OK && !value, "got %#lx, value %u\n", hr, value);
+        IBluetoothDeviceId_Release(device_id);
+    }
+    IGattSession_Release(session);
+}
