+    unsigned int i;
+    TRACE( "(%p)\n", iface );
+    EnterCriticalSection(&impl->cs);
+    ref = InterlockedDecrement(&impl->ref);
+    if (ref == 1 && impl->running) SetEvent(impl->stop);
+    LeaveCriticalSection(&impl->cs);
+    if (!ref)
+    {
+        TRACE( "destroying session %p\n", impl );
+        for (i = 0; i < impl->count; i++)
+        {
+            ITypedEventHandler_IInspectable_IInspectable_Release(impl->handlers[i].handler);
+            if (impl->handlers[i].agile) IAgileReference_Release(impl->handlers[i].agile);
+        }
+        free(impl->handlers);
+        IBluetoothLEDevice_Release(impl->parent);
+        session_release_connection( impl );
+        CloseHandle(impl->device);
+        CloseHandle(impl->stop);
+        DeleteCriticalSection(&impl->cs);
+        free(impl);
