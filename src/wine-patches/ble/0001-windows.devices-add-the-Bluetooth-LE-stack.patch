+/* Read a single boolean property of a BlueZ object (adapter or device). */
+static NTSTATUS bluez_dbus_get_bool_prop( void *connection, const char *path, const char *interface,
+                                          const char *prop, BOOL *value )
+{
+    DBusMessage *request, *reply = NULL;
+    DBusMessageIter args, variant;
+    DBusError error;
+    dbus_bool_t b;
+    NTSTATUS status;
+
+    if (!(request = p_dbus_message_new_method_call( BLUEZ_DEST, path,
+                                                    DBUS_INTERFACE_PROPERTIES, "Get" )))
+        return STATUS_NO_MEMORY;
+    p_dbus_message_iter_init_append( request, &args );
+    if (!p_dbus_message_iter_append_basic( &args, DBUS_TYPE_STRING, &interface ) ||
+        !p_dbus_message_iter_append_basic( &args, DBUS_TYPE_STRING, &prop ))
+    {
+        p_dbus_message_unref( request );
+        return STATUS_NO_MEMORY;
+    }
+
+    p_dbus_error_init( &error );
+    status = bluez_dbus_send_and_wait_for_reply_timeout( connection, request, &reply, &error, BLUEZ_PROP_TIMEOUT_MS );
+    if (status)
+    {
+        p_dbus_error_free( &error );
+        return status;
+    }
+    if (!reply)
+    {
+        status = bluez_dbus_error_to_ntstatus( &error );
+        p_dbus_error_free( &error );
+        return status;
+    }
+
+    status = STATUS_INTERNAL_ERROR;
+    if (p_dbus_message_iter_init( reply, &args ) && p_dbus_message_iter_get_arg_type( &args ) == DBUS_TYPE_VARIANT)
+    {
+        p_dbus_message_iter_recurse( &args, &variant );
+        if (p_dbus_message_iter_get_arg_type( &variant ) == DBUS_TYPE_BOOLEAN)
+        {
+            p_dbus_message_iter_get_basic( &variant, &b );
+            *value = !!b;
+            status = STATUS_SUCCESS;
+        }
+    }
+    p_dbus_message_unref( reply );
+    return status;
+}
