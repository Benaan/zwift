+HRESULT bluetooth_connect_address( UINT64 addr )
+{
+    BLUETOOTH_FIND_RADIO_PARAMS radio_params = {sizeof(radio_params)};
+    HBLUETOOTH_RADIO_FIND find;
+    HANDLE radio;
+    DWORD bytes, error = ERROR_DEVICE_NOT_CONNECTED;
+    BOOL connected = FALSE;
+    TRACE( "(%#I64x)\n", addr );
+    connect_begin( addr );
+    if ((find = BluetoothFindFirstRadio( &radio_params, &radio )))
+    {
+        do
+        {
+            connected = DeviceIoControl( radio, IOCTL_WINEBTH_RADIO_CONNECT_LE_DEVICE, &addr, sizeof(addr),
+                                         NULL, 0, &bytes, NULL );
+            if (!connected) error = GetLastError();
+            CloseHandle( radio );
+            if (connected) break;
+        } while (BluetoothFindNextRadio( find, &radio ));
+        BluetoothFindRadioClose( find );
+    }
+    connect_end( addr );
+    return connected || error == ERROR_OPERATION_IN_PROGRESS ? S_OK : HRESULT_FROM_WIN32(error);
+}
