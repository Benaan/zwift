diff --git a/dlls/winebth.sys/winebth.c b/dlls/winebth.sys/winebth.c
index 21bcdaa0b04..a8cc869adce 100644
--- a/dlls/winebth.sys/winebth.c
+++ b/dlls/winebth.sys/winebth.c
@@ -66,6 +66,191 @@ static DEVICE_OBJECT *bus_fdo, *bus_pdo, *device_auth;
     static CRITICAL_SECTION cs = { &cs##_debug, -1, 0, 0, 0, 0 };
 
 DECLARE_CRITICAL_SECTION( device_list_cs );
+DECLARE_CRITICAL_SECTION( discovery_cs );
+DECLARE_CRITICAL_SECTION( notification_cs );
+
+struct notification_subscription
+{
+    struct list entry;
+    FILE_OBJECT *file;
+    winebluetooth_device_t object;
+    unsigned int users;
+    UINT64 generation;
+    UINT32 cccd; /* Active GattClientCharacteristicConfigurationDescriptorValue. */
+};
+static LONG64 connection_generation;
+static struct list notification_subscriptions = LIST_INIT(notification_subscriptions);
+
+/* BlueZ subscriptions belong to the D-Bus connection. Share them across Wine
+ * clients, and release only this file's subscriptions on cleanup. */
+static NTSTATUS bluetooth_notification_operation( FILE_OBJECT *file, winebluetooth_device_t object,
+                                                 struct winebth_gatt_params *params, UINT64 generation )
+{
+    struct notification_subscription *entry, *owned = NULL;
+    unsigned int users = 0;
+    BOOL active = FALSE, matching_mode = FALSE;
+    NTSTATUS status = STATUS_SUCCESS;
+    EnterCriticalSection(&notification_cs);
+    LIST_FOR_EACH_ENTRY(entry, &notification_subscriptions, struct notification_subscription, entry)
+        if (entry->object.handle == object.handle)
+        {
+            users += entry->users;
+            active |= entry->generation == generation;
+            matching_mode |= entry->generation == generation && entry->cccd == params->cccd;
+            if (entry->file == file) owned = entry;
+        }
+    /* POLL runs every 20 ms per subscribed characteristic; only log the
+     * subscription-changing operations to keep the trace readable. */
+    if (params->operation != WINEBTH_GATT_POLL)
+        TRACE( "notification op %u object %#Ix cccd %u gen %I64u: users %u active %d matching %d owned %p\n",
+               params->operation, object.handle, params->cccd, generation, users, active, matching_mode,
+               (void *)(owned ? owned->object.handle : 0) );
+    if (params->operation == WINEBTH_GATT_POLL)
+    {
+        /* Re-establish this connection's subscription once, shared by all files.
+         * Keep ownership across a temporary link loss without incrementing users. */
+        if (owned && !active)
+        {
+            struct winebth_gatt_params start = {.operation = WINEBTH_GATT_START_NOTIFY, .cccd = owned->cccd};
+            TRACE( "re-establishing lost notification subscription for object %#Ix (cccd %u)\n",
+                   object.handle, owned->cccd );
+            status = winebluetooth_gatt_operation(object.handle, &start);
+            if (!status) LIST_FOR_EACH_ENTRY(entry, &notification_subscriptions, struct notification_subscription, entry)
+                if (entry->object.handle == object.handle) entry->generation = generation;
+        }
+    }
+    else if (params->operation == WINEBTH_GATT_START_NOTIFY)
+    {
+        if (!owned && !(owned = calloc(1, sizeof(*owned)))) status = STATUS_NO_MEMORY;
+        else
+        {
+            /* Reissue the backend request when the requested configuration differs,
+             * so switching Notify/Indicate is not reported as a no-op. */
+            TRACE( "START_NOTIFY object %#Ix cccd %u: %s backend request\n", object.handle, params->cccd,
+                   matching_mode ? "reusing existing, skipping" : "issuing" );
+            if (!matching_mode) status = winebluetooth_gatt_operation(object.handle, params);
+            if (!status)
+            {
+                LIST_FOR_EACH_ENTRY(entry, &notification_subscriptions, struct notification_subscription, entry)
+                    if (entry->object.handle == object.handle)
+                    {
+                        entry->generation = generation;
+                        entry->cccd = params->cccd;
+                    }
+                owned->generation = generation;
+                owned->cccd = params->cccd;
+                if (!owned->users)
+                {
+                    owned->file = file;
+                    owned->object = object;
+                    winebluetooth_device_dup(object);
+                    list_add_tail(&notification_subscriptions, &owned->entry);
+                }
+                owned->users++;
+            }
+            else if (!owned->users) free(owned);
+        }
+    }
+    else if (owned)
+    {
+        TRACE( "STOP_NOTIFY object %#Ix: users %u, %s backend request\n", object.handle, users,
+               users == 1 ? "issuing" : "shared, skipping" );
+        if (users == 1) status = winebluetooth_gatt_operation(object.handle, params);
+        /* A vanished, unreachable or not-yet-ready peripheral has already stopped
+         * delivering notifications; stopping the local subscription is enough. */
+        if (status == STATUS_DEVICE_NOT_CONNECTED || status == STATUS_INVALID_PARAMETER ||
+            status == STATUS_DEVICE_NOT_READY || status == STATUS_DEVICE_DOES_NOT_EXIST ||
+            status == STATUS_NOT_FOUND) status = STATUS_SUCCESS;
+        if (!status && !--owned->users)
+        {
+            list_remove(&owned->entry);
+            winebluetooth_device_free(owned->object);
+            free(owned);
+        }
+    }
+    LeaveCriticalSection(&notification_cs);
+    return status;
+}
+
+static void bluetooth_notification_cleanup( FILE_OBJECT *file )
+{
+    struct notification_subscription *entry, *next, *other;
+    struct winebth_gatt_params params = {.operation = WINEBTH_GATT_STOP_NOTIFY};
+    EnterCriticalSection(&notification_cs);
+    LIST_FOR_EACH_ENTRY_SAFE(entry, next, &notification_subscriptions, struct notification_subscription, entry)
+    {
+        BOOL shared = FALSE;
+        if (entry->file != file) continue;
+        list_remove(&entry->entry);
+        LIST_FOR_EACH_ENTRY(other, &notification_subscriptions, struct notification_subscription, entry)
+            if (other->object.handle == entry->object.handle) { shared = TRUE; break; }
+        if (!shared) winebluetooth_gatt_operation(entry->object.handle, &params);
+        winebluetooth_device_free(entry->object);
+        free(entry);
+    }
+    LeaveCriticalSection(&notification_cs);
+}
+
+/* Keep blocking D-Bus calls off the device-manager request thread. The work
+ * item retains the device object, and the interned path survives PnP removal. */
+struct bluetooth_operation_work
+{
+    PIO_WORKITEM work;
+    IRP *irp;
+    winebluetooth_device_t object;
+    BOOL connect;
+    LARGE_INTEGER queue_time;
+};
+
+static void WINAPI bluetooth_operation_worker( DEVICE_OBJECT *device, void *context )
+{
+    struct bluetooth_operation_work *work = context;
+    IRP *irp = work->irp;
+    struct winebth_gatt_params *params = work->connect ? NULL : irp->AssociatedIrp.SystemBuffer;
+    LARGE_INTEGER start_time, end_time, freq;
+    NTSTATUS status;
+
+    QueryPerformanceFrequency( &freq );
+    QueryPerformanceCounter( &start_time );
+    status = irp->Cancel ? STATUS_CANCELLED : winebluetooth_gatt_operation( work->object.handle, params );
+    QueryPerformanceCounter( &end_time );
+
+    if (work->connect)
+        TRACE( "IRP %p connect: status %#lx, queued->start %.3f ms, bluez call %.3f ms\n",
+               irp, status,
+               (double)(start_time.QuadPart - work->queue_time.QuadPart) * 1000.0 / (double)freq.QuadPart,
+               (double)(end_time.QuadPart - start_time.QuadPart) * 1000.0 / (double)freq.QuadPart );
+    else
