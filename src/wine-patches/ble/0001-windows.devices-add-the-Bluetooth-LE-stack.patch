 #define IOCTL_WINEBTH_RADIO_REMOVE_DEVICE      CTL_CODE(FILE_DEVICE_BLUETOOTH, 0xab, METHOD_BUFFERED, FILE_ANY_ACCESS)
+/* Read the next LE advertisement update after sequence. Zero sequence queries the current cursor. */
+#define IOCTL_WINEBTH_RADIO_GET_ADVERTISEMENT CTL_CODE(FILE_DEVICE_BLUETOOTH, 0xac, METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define IOCTL_WINEBTH_RADIO_START_LE_DISCOVERY CTL_CODE(FILE_DEVICE_BLUETOOTH, 0xad, METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define IOCTL_WINEBTH_RADIO_CONNECT_LE_DEVICE CTL_CODE(FILE_DEVICE_BLUETOOTH, 0xae, METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define IOCTL_WINEBTH_LE_GATT_OPERATION CTL_CODE(FILE_DEVICE_BLUETOOTH, 0xc2, METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define IOCTL_WINEBTH_LE_GET_STATE CTL_CODE(FILE_DEVICE_BLUETOOTH, 0xc3, METHOD_BUFFERED, FILE_ANY_ACCESS)
+/* Initiate pairing with the remote device the handle refers to. */
+#define IOCTL_WINEBTH_DEVICE_PAIR CTL_CODE(FILE_DEVICE_BLUETOOTH, 0xc4, METHOD_BUFFERED, FILE_ANY_ACCESS)
+/* Send a response for a pending authentication request on the remote device the handle refers to. */
+#define IOCTL_WINEBTH_DEVICE_SEND_AUTH_RESPONSE CTL_CODE(FILE_DEVICE_BLUETOOTH, 0xc5, METHOD_BUFFERED, FILE_ANY_ACCESS)
+/* Drop the bond for the device the handle refers to (BlueZ Adapter1.RemoveDevice). */
+#define IOCTL_WINEBTH_DEVICE_UNPAIR CTL_CODE(FILE_DEVICE_BLUETOOTH, 0xc6, METHOD_BUFFERED, FILE_ANY_ACCESS)
+/* Return the paired state (as a BOOL) for the device the handle refers to. */
+#define IOCTL_WINEBTH_DEVICE_GET_PAIRED CTL_CODE(FILE_DEVICE_BLUETOOTH, 0xc7, METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define IOCTL_WINEBTH_RADIO_GET_LE_ROLES CTL_CODE(FILE_DEVICE_BLUETOOTH, 0xaf, METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define IOCTL_WINEBTH_RADIO_GET_POWERED CTL_CODE(FILE_DEVICE_BLUETOOTH, 0xb0, METHOD_BUFFERED, FILE_ANY_ACCESS)
+/* Hold/release a connection reference on the device the handle refers to. The
+ * driver drops the BlueZ link once the last reference is released, unless
+ * MaintainConnection is set, so the peripheral starts advertising again. */
+#define IOCTL_WINEBTH_DEVICE_ACQUIRE CTL_CODE(FILE_DEVICE_BLUETOOTH, 0xb1, METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define IOCTL_WINEBTH_DEVICE_RELEASE CTL_CODE(FILE_DEVICE_BLUETOOTH, 0xb2, METHOD_BUFFERED, FILE_ANY_ACCESS)
+/* Pin/unpin the connection for the device the handle refers to
