+static DWORD WINAPI characteristic_worker( void *arg )
+{
+    struct characteristic *impl = arg;
+    struct winebth_gatt_params params = {.operation = WINEBTH_GATT_POLL};
+    HRESULT init = RoInitialize(RO_INIT_MULTITHREADED);
+    BOOL done = FALSE;
+    while (!done && WaitForSingleObject(impl->stop, 20) == WAIT_TIMEOUT)
+    {
+        unsigned int batch;
+        for (batch = 0; batch < 64; batch++)
+        {
+            struct value_handler *snapshot = NULL;
+            struct value_event *event;
+            unsigned int count, i;
+            UINT64 previous;
+            HRESULT hr;
+            BOOL subscribed;
+            EnterCriticalSection(&impl->operation_cs);
+            /* Always poll from the authoritative cursor. Enabling notifications
+             * reseeds it, so a worker started earlier must observe that seed
+             * instead of continuing from its own stale cursor. */
+            params.sequence = impl->sequence;
+            params.generation = impl->generation;
+            previous = params.sequence;
+            subscribed = !!impl->cccd;
+            hr = characteristic_operation(impl, &params);
+            if (SUCCEEDED(hr))
+            {
+                impl->sequence = params.sequence;
+                impl->generation = params.generation;
+            }
+            LeaveCriticalSection(&impl->operation_cs);
+            if (FAILED(hr))
+            {
+                if (hr == HRESULT_FROM_WIN32(ERROR_DEVICE_NOT_CONNECTED) ||
+                    hr == HRESULT_FROM_WIN32(ERROR_NOT_READY) ||
+                    hr == HRESULT_FROM_WIN32(ERROR_OPERATION_IN_PROGRESS))
+                {
+                    /* A new connection must start at the current cursor, never replay old input. */
+                    EnterCriticalSection(&impl->operation_cs);
+                    impl->sequence = 0;
+                    impl->generation = 0;
+                    LeaveCriticalSection(&impl->operation_cs);
+                    WaitForSingleObject(impl->stop, 200);
+                }
+                else done = TRUE;
+                break;
+            }
+            if (params.sequence == previous) break;
+            if (!subscribed || !params.timestamp) continue;
+            if (!(event = calloc(1, sizeof(*event)))) continue;
+            event->IGattValueChangedEventArgs_iface.lpVtbl = &value_event_vtbl;
+            event->ref = 1;
+            event->time.UniversalTime = params.timestamp;
+            if (FAILED(bluetooth_buffer_create(params.value, params.size, &event->buffer)))
+            {
+                free(event);
+                continue;
+            }
+            EnterCriticalSection(&impl->cs);
+            count = impl->handler_count;
+            if (count && (snapshot = malloc(count * sizeof(*snapshot))))
+            {
+                memcpy(snapshot, impl->handlers, count * sizeof(*snapshot));
+                for (i = 0; i < count; i++)
+                {
+                    ITypedEventHandler_GattCharacteristic_GattValueChangedEventArgs_AddRef(snapshot[i].handler);
+                    if (snapshot[i].agile) IAgileReference_AddRef(snapshot[i].agile);
+                }
+            }
+            LeaveCriticalSection(&impl->cs);
+            if (snapshot)
+            {
+                TRACE( "delivering value handle %#x size %u to %u handler(s)\n",
+                       impl->props.AttributeHandle, params.size, count );
+                for (i = 0; i < count; i++)
+                {
+                    ITypedEventHandler_GattCharacteristic_GattValueChangedEventArgs *handler = snapshot[i].handler;
+                    void *resolved = NULL;
+
+                    /* Resolve in this apartment so a non-agile handler is invoked through a proxy. */
+                    if (snapshot[i].agile &&
+                        SUCCEEDED(IAgileReference_Resolve(snapshot[i].agile,
+                            &IID_ITypedEventHandler_GattCharacteristic_GattValueChangedEventArgs, &resolved)))
+                        handler = (ITypedEventHandler_GattCharacteristic_GattValueChangedEventArgs *)resolved;
+
+                    ITypedEventHandler_GattCharacteristic_GattValueChangedEventArgs_Invoke(handler,
+                        &impl->IGattCharacteristic_iface, &event->IGattValueChangedEventArgs_iface);
+                    if (resolved) IUnknown_Release((IUnknown *)resolved);
+                    ITypedEventHandler_GattCharacteristic_GattValueChangedEventArgs_Release(snapshot[i].handler);
+                    if (snapshot[i].agile) IAgileReference_Release(snapshot[i].agile);
+                }
+                free(snapshot);
+            }
+            IGattValueChangedEventArgs_Release(&event->IGattValueChangedEventArgs_iface);
+            if (WaitForSingleObject(impl->stop, 0) != WAIT_TIMEOUT) break;
+        }
+    }
+    EnterCriticalSection(&impl->cs);
+    impl->running = FALSE;
+    LeaveCriticalSection(&impl->cs);
+    if (SUCCEEDED(init)) RoUninitialize();
+    IGattCharacteristic_Release(&impl->IGattCharacteristic_iface);
+    return 0;
+}
+static HRESULT WINAPI characteristic_add_ValueChanged( IGattCharacteristic *iface,
+        ITypedEventHandler_GattCharacteristic_GattValueChangedEventArgs *handler, EventRegistrationToken *token )
+{
+    struct characteristic *impl = impl_from_characteristic(iface);
+    IAgileReference *agile = NULL;
+    struct value_handler *tmp;
+    struct winebth_gatt_params params = {.operation = WINEBTH_GATT_POLL};
+    HANDLE thread;
+    HRESULT hr = S_OK;
+    TRACE( "iface %p handler %p\n", iface, handler );
+    if (!handler || !token) return E_POINTER;
+    token->value = 0;
+    /* Best effort: marshal the handler so the poll worker can invoke a non-agile one. */
+    if (FAILED(RoGetAgileReference( AGILEREFERENCE_DELAYEDMARSHAL,
+                                    &IID_ITypedEventHandler_GattCharacteristic_GattValueChangedEventArgs,
+                                    (IUnknown *)handler, &agile )))
+        agile = NULL;
+    EnterCriticalSection(&impl->cs);
+    if (!(tmp = realloc(impl->handlers, (impl->handler_count + 1) * sizeof(*tmp))))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    impl->handlers = tmp;
+    if (!impl->running)
+    {
+        BOOL have_cccd;
+        /* Notifications already enabled (e.g. via WriteClientCharacteristicConfigurationDescriptorAsync)
+         * have seeded the authoritative cursor just before the CCCD write, so keep it instead of
+         * querying again here and skipping a value that arrived in the meantime. */
+        EnterCriticalSection(&impl->operation_cs);
+        have_cccd = !!impl->cccd;
+        if (!have_cccd && FAILED(hr = characteristic_operation(impl, &params)))
+        {
+            LeaveCriticalSection(&impl->operation_cs);
+            goto done;
+        }
+        if (!have_cccd)
+        {
+            impl->sequence = params.sequence;
+            impl->generation = params.generation;
+        }
+        LeaveCriticalSection(&impl->operation_cs);
+        ResetEvent(impl->stop);
+        impl->running = TRUE;
+        IGattCharacteristic_AddRef(iface);
+        if (!(thread = CreateThread(NULL, 0, characteristic_worker, impl, 0, NULL)))
+        {
+            hr = HRESULT_FROM_WIN32(GetLastError());
+            impl->running = FALSE;
+            IGattCharacteristic_Release(iface);
+            goto done;
+        }
+        CloseHandle(thread);
+    }
+    /* Keep an existing worker alive if a subscriber is replaced during a callback. */
+    ResetEvent(impl->stop);
+    token->value = ++impl->next_token;
+    impl->handlers[impl->handler_count].handler = handler;
+    impl->handlers[impl->handler_count].agile = agile;
+    impl->handlers[impl->handler_count++].token = *token;
+    ITypedEventHandler_GattCharacteristic_GattValueChangedEventArgs_AddRef(handler);
+done:
+    LeaveCriticalSection(&impl->cs);
+    if (FAILED(hr) && agile) IAgileReference_Release(agile);
+    return hr;
+}
+static HRESULT WINAPI characteristic_remove_ValueChanged( IGattCharacteristic *iface, EventRegistrationToken token )
+{
+    struct characteristic *impl = impl_from_characteristic(iface);
+    ITypedEventHandler_GattCharacteristic_GattValueChangedEventArgs *handler = NULL;
+    IAgileReference *agile = NULL;
+    unsigned int i;
+    EnterCriticalSection(&impl->cs);
+    for (i = 0; i < impl->handler_count; i++)
+        if (impl->handlers[i].token.value == token.value)
+        {
+            handler = impl->handlers[i].handler;
+            agile = impl->handlers[i].agile;
+            memmove(&impl->handlers[i], &impl->handlers[i + 1], (--impl->handler_count - i) * sizeof(*impl->handlers));
+            break;
+        }
+    LeaveCriticalSection(&impl->cs);
+    if (handler) ITypedEventHandler_GattCharacteristic_GattValueChangedEventArgs_Release(handler);
+    if (agile) IAgileReference_Release(agile);
+    return S_OK;
+}
+
+static const IGattCharacteristicVtbl characteristic_vtbl =
+{
+    characteristic_QueryInterface,
+    characteristic_AddRef,
+    characteristic_Release,
