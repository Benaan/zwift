+HRESULT gatt_characteristic_create( HANDLE device, IGattDeviceService *service, const BTH_LE_GATT_CHARACTERISTIC *props, IGattCharacteristic **out )
+{
+    struct characteristic *impl;
+    HRESULT hr;
+    *out = NULL;
+    if (!(impl = calloc(1, sizeof(*impl)))) return E_OUTOFMEMORY;
+    if (!DuplicateHandle(GetCurrentProcess(), device, GetCurrentProcess(), &impl->device, 0, FALSE, DUPLICATE_SAME_ACCESS))
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        free(impl);
+        return hr;
+    }
+    if (!(impl->stop = CreateEventW(NULL, TRUE, FALSE, NULL)))
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        CloseHandle(impl->device);
+        free(impl);
+        return hr;
+    }
+    impl->IGattCharacteristic_iface.lpVtbl = &characteristic_vtbl;
+    impl->IGattCharacteristic2_iface.lpVtbl = &characteristic2_vtbl;
+    impl->IGattCharacteristic3_iface.lpVtbl = &characteristic3_vtbl;
+    impl->ref = 1;
+    impl->props = *props;
+    impl->service = service;
+    IGattDeviceService_AddRef(service);
+    InitializeCriticalSection(&impl->cs);
+    InitializeCriticalSection(&impl->operation_cs);
+    *out = &impl->IGattCharacteristic_iface;
+    return S_OK;
+}
