+/* Coalesce concurrent connects to the *same* address. Different API paths (the
+ * fire-and-forget connect worker, GATT service discovery and GattSession's
+ * maintain loop) can all request a connection at once; BlueZ answers all but one
+ * with org.bluez.Error.InProgress and may abort the real link. Connects to other
+ * addresses must not be blocked (a slow peripheral can take seconds). */
+#define MAX_CONNECTING_ADDRESSES 32
+static INIT_ONCE connect_once = INIT_ONCE_STATIC_INIT;
+static CRITICAL_SECTION connect_cs;
+static CONDITION_VARIABLE connect_cv;
+static UINT64 connecting_addresses[MAX_CONNECTING_ADDRESSES];
+static unsigned int connecting_count;
+
+static BOOL CALLBACK init_connect_cs( INIT_ONCE *once, void *param, void **context )
+{
+    InitializeCriticalSection( &connect_cs );
+    InitializeConditionVariable( &connect_cv );
+    return TRUE;
+}
+
+static void connect_begin( UINT64 addr )
+{
+    unsigned int i;
+    InitOnceExecuteOnce( &connect_once, init_connect_cs, NULL, NULL );
+    EnterCriticalSection( &connect_cs );
+    for (;;)
+    {
+        BOOL found = FALSE;
+        for (i = 0; i < connecting_count; i++)
+            if (connecting_addresses[i] == addr) { found = TRUE; break; }
+        if (!found) break;
+        SleepConditionVariableCS( &connect_cv, &connect_cs, INFINITE );
+    }
+    if (connecting_count < MAX_CONNECTING_ADDRESSES) connecting_addresses[connecting_count++] = addr;
+    LeaveCriticalSection( &connect_cs );
+}
+
+static void connect_end( UINT64 addr )
+{
+    unsigned int i;
+    EnterCriticalSection( &connect_cs );
+    for (i = 0; i < connecting_count; i++)
+        if (connecting_addresses[i] == addr)
+        {
+            connecting_addresses[i] = connecting_addresses[--connecting_count];
+            break;
+        }
+    WakeAllConditionVariable( &connect_cv );
+    LeaveCriticalSection( &connect_cs );
+}
