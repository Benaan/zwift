+        !p_dbus_message_iter_open_container( &args, DBUS_TYPE_VARIANT, DBUS_TYPE_BOOLEAN_AS_STRING, &variant ) ||
+        !p_dbus_message_iter_append_basic( &variant, DBUS_TYPE_BOOLEAN, &b ) ||
