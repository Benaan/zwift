+static HRESULT advertisement_parse( const BYTE *data, UINT32 size, IBluetoothLEAdvertisement **out )
+{
+    struct advertisement *impl;
+    HRESULT hr = advertisement_create( out );
+    UINT32 pos = 0;
+    if (FAILED(hr)) return hr;
+    impl = advertisement_from_iface(*out);
+    while (pos < size && SUCCEEDED(hr))
+    {
+        IBluetoothLEAdvertisementDataSection *section;
+        UINT32 len = data[pos++], i, width = 0;
+        BYTE type;
+        const BYTE *bytes;
+        if (!len) break;
+        if (len > size - pos) { hr = E_INVALIDARG; break; }
+        type = data[pos];
+        bytes = data + pos + 1;
+        pos += len;
+        len--;
+        hr = advertisement_section_create( type, bytes, len, &section );
+        if (FAILED(hr)) break;
+        hr = IVector_BluetoothLEAdvertisementDataSection_Append( impl->sections, section );
+        IBluetoothLEAdvertisementDataSection_Release( section );
+        if (FAILED(hr)) break;
+        if (type == 0x01 && len)
+        {
+            if (impl->flags) IReference_BluetoothLEAdvertisementFlags_Release( impl->flags );
+            impl->flags = NULL;
+            hr = advertisement_flags_create( bytes[0], &impl->flags );
+        }
+        else if (type == 0x08 || type == 0x09)
+        {
+            WCHAR name[254];
+            int count = MultiByteToWideChar( CP_UTF8, 0, (const char *)bytes, len, name, ARRAY_SIZE(name) );
+            WindowsDeleteString( impl->name );
+            impl->name = NULL;
+            hr = WindowsCreateString( name, count, &impl->name );
+        }
+        else if (type == 0xff && len >= 2)
+        {
+            IBluetoothLEManufacturerData *manufacturer;
+            IBuffer *buffer;
+            hr = advertisement_section_create( type, bytes + 2, len - 2, &section );
+            if (FAILED(hr)) break;
+            hr = IBluetoothLEAdvertisementDataSection_get_Data( section, &buffer );
+            IBluetoothLEAdvertisementDataSection_Release( section );
+            if (FAILED(hr)) break;
+            hr = manufacturer_data_create( bytes[0] | (bytes[1] << 8), buffer, &manufacturer );
+            IBuffer_Release( buffer );
+            if (FAILED(hr)) break;
+            hr = IVector_BluetoothLEManufacturerData_Append( impl->manufacturers, manufacturer );
+            IBluetoothLEManufacturerData_Release( manufacturer );
+        }
+        if (type == 0x02 || type == 0x03) width = 2;
+        if (type == 0x04 || type == 0x05) width = 4;
+        if (type == 0x06 || type == 0x07) width = 16;
+        for (i = 0; width && i + width <= len && SUCCEEDED(hr); i += width)
+        {
+            GUID uuid = {0, 0, 0x1000, {0x80, 0, 0, 0x80, 0x5f, 0x9b, 0x34, 0xfb}};
+            const BYTE *p = bytes + i;
+            UINT32 j, index;
+            boolean found;
+            if (width == 16)
+            {
+                for (j = 0; j < 8; j++) uuid.Data4[j] = p[7 - j];
+                uuid.Data3 = p[8] | (p[9] << 8);
+                uuid.Data2 = p[10] | (p[11] << 8);
+                p += 12;
+            }
+            uuid.Data1 = p[0] | (p[1] << 8);
+            if (width != 2) uuid.Data1 |= ((UINT32)p[2] << 16) | ((UINT32)p[3] << 24);
+            hr = IVector_GUID_IndexOf( impl->uuids, uuid, &index, &found );
+            if (SUCCEEDED(hr) && !found) hr = IVector_GUID_Append( impl->uuids, uuid );
+        }
+    }
+    if (FAILED(hr)) { IBluetoothLEAdvertisement_Release( *out ); *out = NULL; }
+    return hr;
+}
