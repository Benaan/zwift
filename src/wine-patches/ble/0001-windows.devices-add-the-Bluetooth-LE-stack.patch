+static BOOL advertisement_matches( IBluetoothLEAdvertisement *adv, IBluetoothLEAdvertisementFilter *filter )
+{
+    IBluetoothLEAdvertisement *expected = NULL;
+    IVector_GUID *uuids = NULL, *actual = NULL;
+    IVector_BluetoothLEAdvertisementBytePattern *patterns = NULL;
+    IVector_BluetoothLEAdvertisementDataSection *sections = NULL;
+    IVector_BluetoothLEManufacturerData *manufacturers = NULL;
+    IReference_BluetoothLEAdvertisementFlags *required_flags = NULL, *actual_flags = NULL;
+    HSTRING name = NULL, actual_name = NULL;
+    UINT32 count, i, index;
+    BOOL result = FALSE;
+    boolean found;
+    GUID uuid;
+    if (!filter) return TRUE;
+    if (FAILED(IBluetoothLEAdvertisementFilter_get_Advertisement( filter, &expected )) || !expected) goto done;
+    if (FAILED(IBluetoothLEAdvertisement_get_Flags( expected, &required_flags ))) goto done;
+    if (required_flags)
+    {
+        BluetoothLEAdvertisementFlags required, flags;
+        if (FAILED(IReference_BluetoothLEAdvertisementFlags_get_Value( required_flags, &required )) ||
+            FAILED(IBluetoothLEAdvertisement_get_Flags( adv, &actual_flags )) || !actual_flags ||
+            FAILED(IReference_BluetoothLEAdvertisementFlags_get_Value( actual_flags, &flags )) ||
+            (flags & required) != required) goto done;
+    }
+    if (FAILED(IBluetoothLEAdvertisement_get_LocalName( expected, &name ))) goto done;
+    if (!WindowsIsStringEmpty(name))
+    {
+        INT32 comparison;
+        if (FAILED(IBluetoothLEAdvertisement_get_LocalName( adv, &actual_name )) ||
+            FAILED(WindowsCompareStringOrdinal( name, actual_name, &comparison )) || comparison) goto done;
+    }
+    if (FAILED(IBluetoothLEAdvertisement_get_ServiceUuids( expected, &uuids )) ||
+        FAILED(IBluetoothLEAdvertisement_get_ServiceUuids( adv, &actual )) ||
+        FAILED(IVector_GUID_get_Size( uuids, &count ))) goto done;
+    if (count)
+    {
+        BOOL any_match = FALSE;
+        for (i = 0; i < count; i++)
+        {
+            if (FAILED(IVector_GUID_GetAt( uuids, i, &uuid ))) goto done;
+            if (SUCCEEDED(IVector_GUID_IndexOf( actual, uuid, &index, &found )) && found)
+            {
+                any_match = TRUE;
+                break;
+            }
+        }
+        if (!any_match) goto done;
+    }
+    if (FAILED(IBluetoothLEAdvertisement_get_DataSections( expected, &sections )) ||
+        FAILED(IVector_BluetoothLEAdvertisementDataSection_get_Size( sections, &count ))) goto done;
+    for (i = 0; i < count; i++)
+    {
+        IBluetoothLEAdvertisementDataSection *section;
+        IBuffer *buffer = NULL;
+        BYTE type;
+        BOOL matches = FALSE;
+        if (FAILED(IVector_BluetoothLEAdvertisementDataSection_GetAt( sections, i, &section ))) goto done;
+        if (SUCCEEDED(IBluetoothLEAdvertisementDataSection_get_DataType( section, &type )) &&
+            SUCCEEDED(IBluetoothLEAdvertisementDataSection_get_Data( section, &buffer )))
+            matches = advertisement_has_pattern( adv, type, 0, buffer );
+        if (buffer) IBuffer_Release( buffer );
+        IBluetoothLEAdvertisementDataSection_Release( section );
+        if (!matches) goto done;
+    }
+    if (FAILED(IBluetoothLEAdvertisement_get_ManufacturerData( expected, &manufacturers )) ||
+        FAILED(IVector_BluetoothLEManufacturerData_get_Size( manufacturers, &count ))) goto done;
+    for (i = 0; i < count; i++)
+    {
+        IBluetoothLEManufacturerData *entry;
+        IVectorView_BluetoothLEManufacturerData *candidates = NULL;
+        IBuffer *pattern = NULL;
+        UINT16 company;
+        UINT32 j, size;
+        BOOL matches = FALSE;
+        if (FAILED(IVector_BluetoothLEManufacturerData_GetAt( manufacturers, i, &entry ))) goto done;
+        if (SUCCEEDED(IBluetoothLEManufacturerData_get_CompanyId( entry, &company )) &&
+            SUCCEEDED(IBluetoothLEManufacturerData_get_Data( entry, &pattern )) &&
+            SUCCEEDED(IBluetoothLEAdvertisement_GetManufacturerDataByCompanyId( adv, company, &candidates )) &&
+            SUCCEEDED(IVectorView_BluetoothLEManufacturerData_get_Size( candidates, &size )))
+            for (j = 0; j < size && !matches; j++)
+            {
+                IBluetoothLEManufacturerData *candidate;
+                IBuffer *buffer;
+                if (FAILED(IVectorView_BluetoothLEManufacturerData_GetAt( candidates, j, &candidate ))) break;
+                if (SUCCEEDED(IBluetoothLEManufacturerData_get_Data( candidate, &buffer )))
+                {
+                    matches = buffer_matches( buffer, pattern, 0 );
+                    if (buffer) IBuffer_Release( buffer );
+                }
+                IBluetoothLEManufacturerData_Release( candidate );
+            }
+        if (candidates) IVectorView_BluetoothLEManufacturerData_Release( candidates );
+        if (pattern) IBuffer_Release( pattern );
+        IBluetoothLEManufacturerData_Release( entry );
+        if (!matches) goto done;
+    }
+    if (FAILED(IBluetoothLEAdvertisementFilter_get_BytePatterns( filter, &patterns )) ||
+        FAILED(IVector_BluetoothLEAdvertisementBytePattern_get_Size( patterns, &count ))) goto done;
+    for (i = 0; i < count; i++)
+    {
+        IBluetoothLEAdvertisementBytePattern *pattern;
+        IBuffer *buffer = NULL;
+        BYTE type;
+        INT16 offset;
+        BOOL matches = FALSE;
+        if (FAILED(IVector_BluetoothLEAdvertisementBytePattern_GetAt( patterns, i, &pattern ))) goto done;
+        if (SUCCEEDED(IBluetoothLEAdvertisementBytePattern_get_DataType( pattern, &type )) &&
+            SUCCEEDED(IBluetoothLEAdvertisementBytePattern_get_Offset( pattern, &offset )) &&
+            SUCCEEDED(IBluetoothLEAdvertisementBytePattern_get_Data( pattern, &buffer )))
+            matches = advertisement_has_pattern( adv, type, offset, buffer );
+        if (buffer) IBuffer_Release( buffer );
+        IBluetoothLEAdvertisementBytePattern_Release( pattern );
+        if (!matches) goto done;
+    }
+    result = TRUE;
+done:
+    WindowsDeleteString( name );
+    WindowsDeleteString( actual_name );
+    if (uuids) IVector_GUID_Release( uuids );
+    if (actual) IVector_GUID_Release( actual );
+    if (expected) IBluetoothLEAdvertisement_Release( expected );
+    if (patterns) IVector_BluetoothLEAdvertisementBytePattern_Release( patterns );
+    if (sections) IVector_BluetoothLEAdvertisementDataSection_Release( sections );
+    if (manufacturers) IVector_BluetoothLEManufacturerData_Release( manufacturers );
+    if (required_flags) IReference_BluetoothLEAdvertisementFlags_Release( required_flags );
+    if (actual_flags) IReference_BluetoothLEAdvertisementFlags_Release( actual_flags );
+    return result;
+}
