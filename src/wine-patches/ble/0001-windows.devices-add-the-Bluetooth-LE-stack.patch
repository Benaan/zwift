+static void pairing_send_auth_response( HANDLE device, BLUETOOTH_AUTHENTICATION_METHOD method, UINT32 passkey,
+                                        BOOL negative )
+{
+    struct winebth_radio_send_auth_response_params params = {0};
+    DWORD bytes;
+
+    params.method = method;
+    params.numeric_value_or_passkey = passkey;
+    params.negative = negative ? 1 : 0;
+    DeviceIoControl( device, IOCTL_WINEBTH_DEVICE_SEND_AUTH_RESPONSE, &params, sizeof(params),
+                     &params, sizeof(params), &bytes, NULL );
+}
+
+/* Offer an authentication request to the in-flight custom pairing's PairingRequested handlers.
+ * Returns TRUE if an attempt was made (answered or rejected), FALSE to auto-confirm. */
+static BOOL custom_pairing_raise_requested( struct device_custom_pairing *pairing, DevicePairingKinds kinds,
+                                            HANDLE device, BLUETOOTH_AUTHENTICATION_METHOD method, UINT32 passkey )
+{
+    ITypedEventHandler_DeviceInformationCustomPairing_DevicePairingRequestedEventArgs **handlers = NULL;
+    struct custom_pairing_handler *entry;
+    IDevicePairingRequestedEventArgs *args = NULL;
+    DevicePairingKinds kind;
+    unsigned int count = 0, i;
+    BOOL matched;
+
+    switch (method)
+    {
+    case BLUETOOTH_AUTHENTICATION_METHOD_NUMERIC_COMPARISON: kind = DevicePairingKinds_ConfirmPinMatch; break;
+    case BLUETOOTH_AUTHENTICATION_METHOD_PASSKEY_NOTIFICATION: kind = DevicePairingKinds_DisplayPin; break;
+    case BLUETOOTH_AUTHENTICATION_METHOD_PASSKEY: kind = DevicePairingKinds_ProvidePin; break;
+    default: kind = DevicePairingKinds_None; break;
+    }
+
+    if (!pairing) return FALSE;
+
+    EnterCriticalSection( &pairing->cs );
+    if (list_empty( &pairing->handlers ))
+    {
+        LeaveCriticalSection( &pairing->cs );
+        return FALSE;
+    }
+
+    matched = kind != DevicePairingKinds_None && (kinds & kind);
+    if (!matched)
+    {
+        LeaveCriticalSection( &pairing->cs );
+        /* The application did not offer this ceremony: reject it. */
+        pairing_send_auth_response( device, method, passkey, TRUE );
+        return TRUE;
+    }
+
+    LIST_FOR_EACH_ENTRY( entry, &pairing->handlers, struct custom_pairing_handler, entry ) count++;
+    if (!(handlers = calloc( count, sizeof(*handlers) )))
+    {
+        LeaveCriticalSection( &pairing->cs );
+        /* Cannot build the snapshot: reject rather than confirm a ceremony the app
+         * did not get to see. */
+        pairing_send_auth_response( device, method, passkey, TRUE );
+        return TRUE;
+    }
+    i = 0;
+    LIST_FOR_EACH_ENTRY( entry, &pairing->handlers, struct custom_pairing_handler, entry )
+        ITypedEventHandler_DeviceInformationCustomPairing_DevicePairingRequestedEventArgs_AddRef(
+                handlers[i++] = entry->handler );
+    LeaveCriticalSection( &pairing->cs );
+
+    /* Invoke and release outside the lock: the handlers are the application's code. */
+    if (SUCCEEDED(device_pairing_requested_args_create( pairing->device, kind, device, method, passkey, &args )))
+    {
+        for (i = 0; i < count; i++)
+        {
+            ITypedEventHandler_DeviceInformationCustomPairing_DevicePairingRequestedEventArgs_Invoke(
+                    handlers[i], &pairing->IDeviceInformationCustomPairing_iface, args );
+            ITypedEventHandler_DeviceInformationCustomPairing_DevicePairingRequestedEventArgs_Release( handlers[i] );
+        }
+        if (!((struct device_pairing_requested_args *)args)->accepted)
+            pairing_send_auth_response( device, method, passkey, TRUE );
+        IDevicePairingRequestedEventArgs_Release( args );
+    }
+    else
+    {
+        for (i = 0; i < count; i++)
+            ITypedEventHandler_DeviceInformationCustomPairing_DevicePairingRequestedEventArgs_Release( handlers[i] );
+    }
+    free( handlers );
+    return TRUE;
+}
