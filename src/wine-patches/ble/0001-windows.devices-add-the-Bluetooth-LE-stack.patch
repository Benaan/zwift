+    if (IsEqualGUID( iid, impl->iids.iterable ))
+    {
+        IInspectable_AddRef( (IInspectable *)(*out = &impl->IIterable_GUID_iface) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI vector_view_AddRef( IVectorView_GUID *iface )
+{
+    struct vector_view *impl = impl_from_IVectorView_GUID( iface );
