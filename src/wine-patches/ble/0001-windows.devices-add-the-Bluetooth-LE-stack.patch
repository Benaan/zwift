+ * new watcher until the device happens to advertise again - which for quiet or already
+ * connected devices may be never. Re-publish every known LE device with a fresh sequence
+ * whenever a scan starts, mirroring what the Windows stack hands a new watcher. */
+static void bluetooth_radio_reseed_advertisements( struct bluetooth_radio *radio )
+{
+    struct bluetooth_remote_device *device;
+    LARGE_INTEGER now;
