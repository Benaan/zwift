+
+static ULONG WINAPI pattern_Release( IBluetoothLEAdvertisementBytePattern *iface )
+{
+    struct pattern *impl = pattern_impl(iface);
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        if (impl->data) IBuffer_Release( impl->data );
+        DeleteCriticalSection( &impl->cs );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI pattern_GetIids( IBluetoothLEAdvertisementBytePattern *iface, ULONG *count, IID **iids )
