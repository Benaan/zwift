+static void test_gatt_service_close( IGattDeviceService *service )
+{
+    IGattDeviceService3 *service3;
+    IGattSession *session = NULL, *session2 = NULL;
+    IClosable *closable;
+    GattSessionStatus status;
+    HSTRING str = NULL;
+    boolean maintain;
+    HRESULT hr;
+
+    hr = IGattDeviceService_QueryInterface(service, &IID_IClosable, (void **)&closable);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (FAILED(hr)) return;
+
+    hr = IGattDeviceService_QueryInterface(service, &IID_IGattDeviceService3, (void **)&service3);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (FAILED(hr))
+    {
+        IClosable_Release(closable);
+        return;
+    }
+
+    hr = IGattDeviceService3_get_Session(service3, &session);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IGattSession_put_MaintainConnection(session, TRUE);
+        ok(hr == S_OK, "put_MaintainConnection returned %#lx\n", hr);
+    }
+
+    /* Close the service while still holding references to it and to the
+     * session it returned. The session and its reconnect worker must be shut
+     * down immediately instead of waiting for the service's final Release. */
+    hr = IClosable_Close(closable);
+    ok(hr == S_OK, "Close returned %#lx\n", hr);
+    hr = IClosable_Close(closable);
+    ok(hr == S_OK, "second Close returned %#lx\n", hr);
+
+    if (session)
+    {
+        hr = IGattSession_get_MaintainConnection(session, &maintain);
+        ok(hr == RO_E_CLOSED, "retained session still open: %#lx\n", hr);
+        hr = IGattSession_get_SessionStatus(session, &status);
+        ok(hr == RO_E_CLOSED, "retained session still open: %#lx\n", hr);
+        IGattSession_Release(session);
+    }
+
+    hr = IGattDeviceService3_get_Session(service3, &session2);
+    ok(hr == RO_E_CLOSED, "closed service returned a session: %#lx\n", hr);
+    ok(!session2, "got session %p for a closed service\n", session2);
+    if (session2) IGattSession_Release(session2);
+
+    hr = IGattDeviceService_get_DeviceId(service, &str);
+    ok(hr == RO_E_CLOSED, "closed service returned DeviceId: %#lx\n", hr);
+    WindowsDeleteString(str);
+
+    IGattDeviceService3_Release(service3);
+    IClosable_Release(closable);
+}
