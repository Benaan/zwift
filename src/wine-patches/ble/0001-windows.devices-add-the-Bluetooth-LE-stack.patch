+static HRESULT WINAPI vector_InsertAt( IVector_GUID *iface, UINT32 index, GUID value )
+{
+    struct vector *impl = impl_from_IVector_GUID( iface );
+    GUID *tmp = impl->elements;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, index %u, value %s.\n", iface, index, debugstr_guid(&value) );
+
+    EnterCriticalSection( &impl->cs );
+    if (index > impl->size) hr = E_BOUNDS;
+    else
+    {
+        if (impl->size == impl->capacity)
+        {
+            impl->capacity = max( 32, impl->capacity * 3 / 2 );
+            if (!(impl->elements = realloc( impl->elements, impl->capacity * sizeof(*impl->elements) )))
+            {
+                impl->capacity = impl->size;
+                impl->elements = tmp;
+                hr = E_OUTOFMEMORY;
+            }
+        }
+
+        if (SUCCEEDED(hr))
+        {
+            memmove( impl->elements + index + 1, impl->elements + index, (impl->size++ - index) * sizeof(*impl->elements) );
+            impl->elements[index] = value;
+        }
+    }
+    LeaveCriticalSection( &impl->cs );
