+static HRESULT session_from_id_async( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    IGattSession *session;
+    HSTRING id;
+    HRESULT hr;
+
+    if (!called_async) return STATUS_PENDING;
+    if (FAILED(hr = IBluetoothDeviceId_get_Id((IBluetoothDeviceId *)param, &id))) return hr;
+    hr = bluetooth_session_from_id(id, &session);
