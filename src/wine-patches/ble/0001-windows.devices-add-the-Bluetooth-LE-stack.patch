+static BOOL buffer_matches( IBuffer *buffer, IBuffer *pattern, INT16 offset )
+{
+    IBufferByteAccess *a = NULL, *b = NULL;
+    BYTE *bytes, *match;
+    UINT32 size, length;
+    BOOL result = FALSE;
+    if (!buffer || !pattern || offset < 0) return FALSE;
+    if (FAILED(IBuffer_get_Length( buffer, &size )) || FAILED(IBuffer_get_Length( pattern, &length ))) return FALSE;
+    if ((UINT32)offset > size || length > size - offset) return FALSE;
+    if (SUCCEEDED(IBuffer_QueryInterface( buffer, &IID_IBufferByteAccess, (void **)&a )) &&
+        SUCCEEDED(IBuffer_QueryInterface( pattern, &IID_IBufferByteAccess, (void **)&b )) &&
+        SUCCEEDED(IBufferByteAccess_Buffer( a, &bytes )) && SUCCEEDED(IBufferByteAccess_Buffer( b, &match )))
+        result = !length || !memcmp( bytes + offset, match, length );
+    if (a) IBufferByteAccess_Release( a );
+    if (b) IBufferByteAccess_Release( b );
+    return result;
+}
