+    IActivationFactory_Release(factory);
+    if (FAILED(hr)) goto release_statics;
+    hr = IBufferFactory_Create(buffer_factory, 32, &buffer);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    IBufferFactory_Release(buffer_factory);
+    if (FAILED(hr)) goto release_statics;
+    memcpy(buffer_get_data(buffer), advertisement, sizeof(advertisement));
+    hr = IBuffer_put_Length(buffer, sizeof(advertisement));
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+
+    hr = IDataReaderStatics_FromBuffer(statics, buffer, &reader);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    if (FAILED(hr)) { IBuffer_Release(buffer); goto release_statics; }
+    hr = IDataReaderStatics_FromBuffer(statics, buffer, &second);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    if (FAILED(hr)) { IDataReader_Release(reader); IBuffer_Release(buffer); goto release_statics; }
+    /* Readers must retain the buffer after the caller releases it. */
+    IBuffer_Release(buffer);
+    check_interface(reader, &IID_IAgileObject, TRUE);
+    hr = IDataReader_QueryInterface(reader, &IID_IClosable, (void **)&closable);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IClosable_QueryInterface(closable, &IID_IUnknown, (void **)&identity);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    ok(identity == (IUnknown *)reader, "Unexpected identity %p, reader %p.\n", identity, reader);
+    IUnknown_Release(identity);
+
+    hr = IDataReader_get_UnconsumedBufferLength(reader, &length);
+    ok(hr == S_OK && length == sizeof(advertisement), "got hr %#lx, length %u.\n", hr, length);
+    hr = IDataReader_ReadBytes(reader, 2, bytes);
+    ok(hr == S_OK && !memcmp(bytes, advertisement, 2), "got hr %#lx, incorrect bytes.\n", hr);
+    hr = IDataReader_get_UnconsumedBufferLength(reader, &length);
+    ok(hr == S_OK && length == 4, "got hr %#lx, length %u.\n", hr, length);
+    memset(bytes, 0xcc, sizeof(bytes));
+    hr = IDataReader_ReadBytes(reader, sizeof(bytes), bytes);
+    ok(hr == E_BOUNDS, "got hr %#lx.\n", hr);
+    ok(bytes[0] == 0xcc && bytes[5] == 0xcc, "Failed read changed output.\n");
+    hr = IDataReader_get_UnconsumedBufferLength(reader, &length);
+    ok(hr == S_OK && length == 4, "Failed read advanced cursor, hr %#lx, length %u.\n", hr, length);
+    hr = IDataReader_ReadByte(reader, &byte);
+    ok(hr == S_OK && byte == advertisement[2], "got hr %#lx, byte %#x.\n", hr, byte);
+    hr = IDataReader_ReadBytes(reader, 3, bytes);
+    ok(hr == S_OK && !memcmp(bytes, advertisement + 3, 3), "got hr %#lx, incorrect bytes.\n", hr);
+    hr = IDataReader_get_UnconsumedBufferLength(reader, &length);
+    ok(hr == S_OK && !length, "got hr %#lx, length %u.\n", hr, length);
+    hr = IDataReader_ReadBytes(reader, 0, bytes);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IDataReader_ReadByte(reader, &byte);
+    ok(hr == E_BOUNDS, "got hr %#lx.\n", hr);
+
+    /* This is the whole-buffer sequence a typical advertisement callback uses. */
+    hr = IDataReader_get_UnconsumedBufferLength(second, &length);
+    ok(hr == S_OK && length == sizeof(advertisement), "Readers share a cursor, hr %#lx, length %u.\n", hr, length);
+    hr = IDataReader_ReadBytes(second, sizeof(bytes), bytes);
+    ok(hr == S_OK && !memcmp(bytes, advertisement, sizeof(bytes)), "got hr %#lx, incorrect bytes.\n", hr);
+    hr = IDataReader_DetachBuffer(second, &detached);
+    ok(hr == S_OK && detached == buffer, "got hr %#lx, buffer %p.\n", hr, detached);
+    if (detached) IBuffer_Release(detached);
+    hr = IDataReader_get_UnconsumedBufferLength(second, &length);
+    ok(hr == S_OK && !length, "got hr %#lx, length %u.\n", hr, length);
+    IDataReader_Release(second);
+
+    hr = IClosable_Close(closable);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IDataReader_get_UnconsumedBufferLength(reader, &length);
+    ok(hr == RO_E_CLOSED, "got hr %#lx.\n", hr);
+    hr = IDataReader_ReadByte(reader, &byte);
+    ok(hr == RO_E_CLOSED, "got hr %#lx.\n", hr);
+    hr = IClosable_Close(closable);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    IClosable_Release(closable);
+    ref = IDataReader_Release(reader);
+    ok(!ref, "got ref %lu.\n", ref);
+
+release_statics:
+    IDataReaderStatics_Release(statics);
+done:
+    RoUninitialize();
+}
+
+static void test_serialization(void)
+{
+    static const WCHAR *data_writer_name = L"Windows.Storage.Streams.DataWriter";
+    static const WCHAR *data_reader_name = L"Windows.Storage.Streams.DataReader";
+    static const WCHAR text[] = L"h\u00e9llo";
+    static const GUID guid = {0x00112233, 0x4455, 0x6677, {0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff}};
+    static const BYTE guid_le[16] = {0x33, 0x22, 0x11, 0x00, 0x55, 0x44, 0x77, 0x66, 0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff};
+    static const BYTE guid_be[16] = {0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff};
+    static const BYTE text_utf8[6] = {'h', 0xc3, 0xa9, 'l', 'l', 'o'};
+    static const BYTE text_utf16le[10] = {'h', 0, 0xe9, 0, 'l', 0, 'l', 0, 'o', 0};
+    static const BYTE text_utf16be[10] = {0, 'h', 0, 0xe9, 0, 'l', 0, 'l', 0, 'o'};
+    IDataReaderStatics *reader_statics;
+    IActivationFactory *factory;
+    IDataWriter *writer;
+    IDataReader *reader;
+    IInspectable *inspectable;
+    IBuffer *buffer;
+    HSTRING string;
+    UINT32 length, count;
+    GUID read_guid;
+    HRESULT hr;
+
+    hr = get_activation_factory(data_writer_name, &factory);
+    if (FAILED(hr)) return;
+    hr = IActivationFactory_ActivateInstance(factory, &inspectable);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IInspectable_QueryInterface(inspectable, &IID_IDataWriter, (void **)&writer);
+    IInspectable_Release(inspectable);
+    IActivationFactory_Release(factory);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    if (FAILED(hr)) return;
+
+    hr = IDataWriter_put_ByteOrder(writer, ByteOrder_LittleEndian);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IDataWriter_WriteGuid(writer, guid);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IDataWriter_DetachBuffer(writer, &buffer);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IBuffer_get_Length(buffer, &length);
+    ok(hr == S_OK && length == sizeof(guid_le), "got hr %#lx, length %u.\n", hr, length);
+    ok(!memcmp(buffer_get_data(buffer), guid_le, sizeof(guid_le)), "unexpected little-endian GUID bytes.\n");
+    IBuffer_Release(buffer);
+
+    hr = IDataWriter_put_ByteOrder(writer, ByteOrder_BigEndian);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IDataWriter_WriteGuid(writer, guid);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IDataWriter_DetachBuffer(writer, &buffer);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    ok(!memcmp(buffer_get_data(buffer), guid_be, sizeof(guid_be)), "unexpected big-endian GUID bytes.\n");
+    IBuffer_Release(buffer);
+
+    WindowsCreateString(text, ARRAY_SIZE(text) - 1, &string);
+
+    hr = IDataWriter_put_UnicodeEncoding(writer, UnicodeEncoding_Utf8);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IDataWriter_MeasureString(writer, string, &count);
+    ok(hr == S_OK && count == sizeof(text_utf8), "utf8 measure got hr %#lx, count %u.\n", hr, count);
+    hr = IDataWriter_WriteString(writer, string, &count);
+    ok(hr == S_OK && count == sizeof(text_utf8), "utf8 write got hr %#lx, count %u.\n", hr, count);
+    hr = IDataWriter_DetachBuffer(writer, &buffer);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IBuffer_get_Length(buffer, &length);
+    ok(hr == S_OK && length == sizeof(text_utf8), "got hr %#lx, length %u.\n", hr, length);
+    ok(!memcmp(buffer_get_data(buffer), text_utf8, sizeof(text_utf8)), "unexpected utf8 bytes.\n");
+    IBuffer_Release(buffer);
+
+    hr = IDataWriter_put_UnicodeEncoding(writer, UnicodeEncoding_Utf16LE);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IDataWriter_MeasureString(writer, string, &count);
+    ok(hr == S_OK && count == sizeof(text_utf16le), "utf16le measure got hr %#lx, count %u.\n", hr, count);
+    hr = IDataWriter_WriteString(writer, string, &count);
+    ok(hr == S_OK && count == sizeof(text_utf16le), "utf16le write got hr %#lx, count %u.\n", hr, count);
+    hr = IDataWriter_DetachBuffer(writer, &buffer);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    ok(!memcmp(buffer_get_data(buffer), text_utf16le, sizeof(text_utf16le)), "unexpected utf16le bytes.\n");
+    IBuffer_Release(buffer);
+
+    hr = IDataWriter_put_UnicodeEncoding(writer, UnicodeEncoding_Utf16BE);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IDataWriter_MeasureString(writer, string, &count);
+    ok(hr == S_OK && count == sizeof(text_utf16be), "utf16be measure got hr %#lx, count %u.\n", hr, count);
+    hr = IDataWriter_WriteString(writer, string, &count);
+    ok(hr == S_OK && count == sizeof(text_utf16be), "utf16be write got hr %#lx, count %u.\n", hr, count);
+    hr = IDataWriter_DetachBuffer(writer, &buffer);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    ok(!memcmp(buffer_get_data(buffer), text_utf16be, sizeof(text_utf16be)), "unexpected utf16be bytes.\n");
+    IBuffer_Release(buffer);
+
+    WindowsDeleteString(string);
+    IDataWriter_Release(writer);
+
+    /* Round-trip the big-endian GUID and the zero-length utf8 read through a reader. */
+    hr = get_activation_factory(data_reader_name, &factory);
+    if (FAILED(hr)) return;
+    hr = IActivationFactory_QueryInterface(factory, &IID_IDataReaderStatics, (void **)&reader_statics);
+    IActivationFactory_Release(factory);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    if (FAILED(hr)) return;
+
+    hr = get_activation_factory(data_writer_name, &factory);
+    if (FAILED(hr)) goto done;
+    hr = IActivationFactory_ActivateInstance(factory, &inspectable);
+    IActivationFactory_Release(factory);
+    if (FAILED(hr)) goto done;
+    hr = IInspectable_QueryInterface(inspectable, &IID_IDataWriter, (void **)&writer);
+    IInspectable_Release(inspectable);
+    if (FAILED(hr)) goto done;
+    IDataWriter_put_ByteOrder(writer, ByteOrder_BigEndian);
+    IDataWriter_WriteGuid(writer, guid);
+    hr = IDataWriter_DetachBuffer(writer, &buffer);
+    IDataWriter_Release(writer);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+
+    hr = IDataReaderStatics_FromBuffer(reader_statics, buffer, &reader);
+    IBuffer_Release(buffer);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IDataReader_put_ByteOrder(reader, ByteOrder_BigEndian);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        hr = IDataReader_ReadGuid(reader, &read_guid);
+        ok(hr == S_OK && IsEqualGUID(&read_guid, &guid), "got hr %#lx, guid %s.\n", hr, debugstr_guid(&read_guid));
+
+        /* Reading zero utf8 code units yields an empty string. */
+        hr = IDataReader_put_UnicodeEncoding(reader, UnicodeEncoding_Utf8);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        string = (void *)0xdeadbeef;
+        hr = IDataReader_ReadString(reader, 0, &string);
+        ok(hr == S_OK && string && WindowsIsStringEmpty(string), "got hr %#lx, string %p.\n", hr, string);
+        if (SUCCEEDED(hr)) WindowsDeleteString(string);
+        IDataReader_Release(reader);
+    }
+
+done:
+    IDataReaderStatics_Release(reader_statics);
+}
+
 START_TEST(wintypes)
 {
     IsWow64Process(GetCurrentProcess(), &is_wow64);
@@ -1877,4 +2124,6 @@ START_TEST(wintypes)
     test_RoResolveNamespace();
     test_IPropertySet();
     test_DataWriter();
+    test_DataReader();
+    test_serialization();
 }
