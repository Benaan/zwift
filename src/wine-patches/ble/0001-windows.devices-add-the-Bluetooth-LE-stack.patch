+static void *bluez_notification_thread( void *arg )
+{
+    struct bluez_notification *notification = arg;
+    struct bluez_watcher_ctx *ctx = notification->ctx;
+    BYTE buffer[512];
+    const char *exit_reason = "unknown";
+
+    TRACE( "AcquireNotify reader thread started for %s (fd %d)\n",
+           debugstr_a( notification->characteristic->str ), notification->fd );
+
+    for (;;)
+    {
+        struct pollfd fds[2] =
+        {
+            { .fd = notification->fd, .events = POLLIN },
+            { .fd = notification->stop_pipe[0], .events = POLLIN },
+        };
+        ssize_t size;
+
+        if (poll( fds, 2, -1 ) <= 0) { exit_reason = "poll failed"; break; }
+        if (fds[1].revents) { exit_reason = "stopped"; break; }
+        if (!(fds[0].revents & (POLLIN | POLLHUP | POLLERR))) continue;
+
+        if ((size = read( notification->fd, buffer, sizeof(buffer) )) <= 0)
+        {
+            TRACE( "AcquireNotify read on %s returned %zd (revents %#x)\n",
+                   debugstr_a( notification->characteristic->str ), size, fds[0].revents );
+            exit_reason = (size == 0) ? "fd EOF" : "fd read error";
+            break;
+        }
+        {
+            char hex[3 * 64 + 1] = {0};
+            int n;
+            for (n = 0; n < size && n < 64; n++) snprintf( hex + 3 * n, 4, "%02x ", buffer[n] );
+            TRACE( "AcquireNotify read %zd bytes on %s: %s\n", size,
+                   debugstr_a( notification->characteristic->str ), hex );
+        }
+
+        {
+            struct winebluetooth_watcher_event_gatt_characteristic_value_changed changed = {0};
+            union winebluetooth_watcher_event_data data;
+            struct unix_name *characteristic;
+
+            if (!(characteristic = unix_name_get_or_create( notification->characteristic->str ))) continue;
+            if (!bluez_gatt_characteristic_value_new_from_bytes( buffer, size, &changed.value ))
+            {
+                unix_name_free( characteristic );
+                continue;
+            }
+            changed.characteristic.handle = (UINT_PTR)characteristic;
+            data.gatt_characteristic_value_changed = changed;
+            if (!bluez_event_list_queue_new_event( &ctx->event_list,
+                                                   BLUETOOTH_WATCHER_EVENT_TYPE_GATT_CHARACTERISTIC_VALUE_CHANGED,
+                                                   data ))
+            {
+                WARN( "Failed to queue value event for %s\n",
+                      debugstr_a( notification->characteristic->str ) );
+                bluez_gatt_characteristic_value_free( (void *)changed.value.handle );
+                unix_name_free( characteristic );
+            }
+            else
+                TRACE( "Queued value event for %s: %zd bytes\n",
+                       debugstr_a( notification->characteristic->str ), size );
+        }
+    }
+    TRACE( "AcquireNotify reader thread exiting for %s: %s\n",
+           debugstr_a( notification->characteristic->str ), exit_reason );
+    return NULL;
+}
+
+static void bluez_notification_stop( struct bluez_notification *notification )
+{
+    if (!notification) return;
+    TRACE( "Stopping AcquireNotify reader for %s (fd %d)\n",
+           debugstr_a( notification->characteristic ? notification->characteristic->str : NULL ),
+           notification->fd );
+    notification->stop = TRUE;
+    if (notification->stop_pipe[1] != -1) { char c = 0; write( notification->stop_pipe[1], &c, 1 ); }
+    pthread_join( notification->thread, NULL );
+    if (notification->fd != -1) close( notification->fd );
+    if (notification->stop_pipe[0] != -1) close( notification->stop_pipe[0] );
+    if (notification->stop_pipe[1] != -1) close( notification->stop_pipe[1] );
+    unix_name_free( notification->characteristic );
+    free( notification );
+}
+
+static void bluez_watcher_stop_notifications( void *watcher_ctx )
+{
+    struct bluez_watcher_ctx *ctx = watcher_ctx;
+    struct bluez_notification *notification, *next;
+
+    if (!ctx) return;
+    LIST_FOR_EACH_ENTRY_SAFE( notification, next, &ctx->notifications, struct bluez_notification, entry )
+    {
+        list_remove( &notification->entry );
+        bluez_notification_stop( notification );
+    }
+}
