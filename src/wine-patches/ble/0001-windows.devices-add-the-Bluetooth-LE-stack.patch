diff --git a/dlls/bluetoothapis/gatt.c b/dlls/bluetoothapis/gatt.c
index 225d95a5749..7915c1d1568 100644
--- a/dlls/bluetoothapis/gatt.c
+++ b/dlls/bluetoothapis/gatt.c
@@ -214,3 +214,76 @@ HRESULT WINAPI BluetoothGATTGetCharacteristicValue( HANDLE device, BTH_LE_GATT_C
     free( params );
     return ret;
 }
+
+HRESULT WINAPI BluetoothGATTSetCharacteristicValue( HANDLE device, BTH_LE_GATT_CHARACTERISTIC *characteristic,
+        BTH_LE_GATT_CHARACTERISTIC_VALUE *value, BTH_LE_GATT_RELIABLE_WRITE_CONTEXT context, ULONG flags )
+{
+    struct winebth_gatt_params *params;
+    OVERLAPPED ovl = {0};
+    DWORD bytes, err;
+
+    if (!device || device == INVALID_HANDLE_VALUE) return E_HANDLE;
+    if (!characteristic || !value) return E_INVALIDARG;
+    if (context || (flags & ~BLUETOOTH_GATT_FLAG_WRITE_WITHOUT_RESPONSE)) return E_NOTIMPL;
+    if (value->DataSize > sizeof(params->value)) return E_INVALIDARG;
+
+    /* The backend completes writes from a worker thread, so the input buffer must stay alive until
+     * the operation finishes and must be submitted through an event for overlapped handles. */
+    if (!(params = calloc( 1, sizeof(*params) )))
+        return HRESULT_FROM_WIN32( ERROR_NO_SYSTEM_RESOURCES );
+
+    if (flags & BLUETOOTH_GATT_FLAG_WRITE_WITHOUT_RESPONSE)
+    {
+        if (!characteristic->IsWritableWithoutResponse)
+        {
+            free( params );
+            return E_BLUETOOTH_ATT_WRITE_NOT_PERMITTED;
+        }
+        params->operation = WINEBTH_GATT_WRITE_COMMAND;
+    }
+    else
+    {
+        if (!characteristic->IsWritable)
+        {
+            free( params );
+            return E_BLUETOOTH_ATT_WRITE_NOT_PERMITTED;
+        }
+        params->operation = WINEBTH_GATT_WRITE;
+    }
+    params->service_handle = characteristic->ServiceHandle;
+    params->characteristic_handle = characteristic->AttributeHandle;
+    params->size = value->DataSize;
+    memcpy( params->value, value->Data, params->size );
+
+    if (!(ovl.hEvent = CreateEventW( NULL, TRUE, FALSE, NULL )))
+    {
+        free( params );
+        return HRESULT_FROM_WIN32( GetLastError() );
+    }
+    err = ERROR_SUCCESS;
+    if (!DeviceIoControl( device, IOCTL_WINEBTH_LE_GATT_OPERATION, params, sizeof(*params),
+                          params, sizeof(*params), &bytes, &ovl ))
+    {
+        err = GetLastError();
+        if (err == ERROR_IO_PENDING)
+        {
+            err = ERROR_SUCCESS;
+            if (!GetOverlappedResult( device, &ovl, &bytes, TRUE ))
+                err = GetLastError();
+        }
+    }
+    CloseHandle( ovl.hEvent );
+    free( params );
+
+    /* A write without response is dispatched as an ATT command. BlueZ acknowledges the
+     * WriteValue call once the command has been handed to the kernel, which is before the
+     * controller has transmitted it, so an unsuccessful result here only reports failures
+     * this layer can observe (bus, driver or the characteristic being unwritable).
+     * Confirming the on-air outcome would require waiting for the next ValuesChanged
+     * notification, which not every command-writable characteristic sends. */
+    if (!err && (flags & BLUETOOTH_GATT_FLAG_WRITE_WITHOUT_RESPONSE))
+        TRACE( "write command on characteristic %#x: only the local completion of the write "
+               "is reported, not the on-air result\n", characteristic->AttributeHandle );
+
+    return err ? HRESULT_FROM_WIN32( err ) : S_OK;
+}
diff --git a/dlls/bluetoothapis/tests/gatt.c b/dlls/bluetoothapis/tests/gatt.c
index 58c0f426383..403fe73466b 100644
--- a/dlls/bluetoothapis/tests/gatt.c
+++ b/dlls/bluetoothapis/tests/gatt.c
@@ -450,8 +450,49 @@ static void test_BluetoothGATTGetCharacteristic( void )
     test_for_all_le_devices( __LINE__, test_device_BluetoothGATTGetCharacteristics, NULL );
 }
 
+static void test_BluetoothGATTSetCharacteristicValue( void )
+{
+    BTH_LE_GATT_CHARACTERISTIC characteristic = {0};
+    BTH_LE_GATT_CHARACTERISTIC_VALUE value = {0};
+    HANDLE event;
+    HRESULT hr;
+
+    characteristic.IsWritable = TRUE;
+    characteristic.IsWritableWithoutResponse = TRUE;
+    hr = BluetoothGATTSetCharacteristicValue(NULL, &characteristic, &value, 0, 0);
+    ok(FAILED(hr), "unexpected success %#lx\n", hr);
+    hr = BluetoothGATTSetCharacteristicValue(INVALID_HANDLE_VALUE, &characteristic, &value, 0, 0);
+    ok(FAILED(hr), "unexpected success %#lx\n", hr);
+
+    /* A non-device handle must never report a successful write. No radio is required. */
+    event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    ok(!!event, "CreateEvent failed %lu\n", GetLastError());
+    if (!event) return;
+    hr = BluetoothGATTSetCharacteristicValue(event, &characteristic, &value, 0, 0);
+    ok(FAILED(hr), "unexpected successful write request %#lx\n", hr);
+    hr = BluetoothGATTSetCharacteristicValue(event, &characteristic, &value, 0,
+                                            BLUETOOTH_GATT_FLAG_WRITE_WITHOUT_RESPONSE);
+    ok(FAILED(hr), "unexpected successful write command %#lx\n", hr);
+
+    /* A write whose flag is not backed by the characteristic's properties must be
+     * rejected before any I/O is attempted, regardless of the handle. */
+    characteristic.IsWritable = TRUE;
+    characteristic.IsWritableWithoutResponse = FALSE;
+    hr = BluetoothGATTSetCharacteristicValue(event, &characteristic, &value, 0,
+                                            BLUETOOTH_GATT_FLAG_WRITE_WITHOUT_RESPONSE);
+    ok(hr == E_BLUETOOTH_ATT_WRITE_NOT_PERMITTED, "write command on a request-only characteristic %#lx\n", hr);
+
+    characteristic.IsWritable = FALSE;
+    characteristic.IsWritableWithoutResponse = TRUE;
+    hr = BluetoothGATTSetCharacteristicValue(event, &characteristic, &value, 0, 0);
+    ok(hr == E_BLUETOOTH_ATT_WRITE_NOT_PERMITTED, "write request on a command-only characteristic %#lx\n", hr);
+
+    CloseHandle(event);
+}
+
 START_TEST( gatt )
 {
+    test_BluetoothGATTSetCharacteristicValue();
     test_BluetoothGATTGetServices();
     test_BluetoothGATTGetCharacteristic();
 }
