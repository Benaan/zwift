+/* Fire-and-forget connect: lets Windows-style callers trigger an
+ * LE connection off the dispatch thread, while FromBluetoothAddressAsync
+ * returns the device object synchronously. The work item runs in a short
+ * detached thread; the connect IRP is itself queued by winebth.sys, so
+ * nothing on this thread blocks the device-manager dispatcher. */
+struct connect_worker_ctx
+{
+    UINT64 addr;
+};
+
+static DWORD WINAPI connect_worker( void *arg )
+{
+    struct connect_worker_ctx *ctx = arg;
+    UINT64 addr = ctx->addr;
+    ULONGLONG start_tick = GetTickCount64();
+    LARGE_INTEGER start_time, end_time, freq;
+    HRESULT hr, init;
+
+    free( ctx );
+
+    init = RoInitialize( RO_INIT_MULTITHREADED );
+
+    QueryPerformanceFrequency( &freq );
+    QueryPerformanceCounter( &start_time );
+
+    TRACE( "async connect for %#I64x starting on tid %04lx\n", addr, GetCurrentThreadId() );
+    hr = bluetooth_connect_address( addr );
+    QueryPerformanceCounter( &end_time );
+
+    TRACE( "async connect for %#I64x completed hr %#lx, bluez call %.3f ms (kernel %I64u ms)\n",
+           addr, hr,
+           (double)(end_time.QuadPart - start_time.QuadPart) * 1000.0 / (double)freq.QuadPart,
+           (ULONGLONG)(GetTickCount64() - start_tick) );
+
+    if (SUCCEEDED( init )) RoUninitialize();
+    return 0;
+}
+
+static void bluetooth_connect_address_async( UINT64 addr )
+{
+    struct connect_worker_ctx *ctx;
+    HANDLE thread;
+
+    TRACE( "(%#I64x)\n", addr );
+    if (!(ctx = malloc( sizeof(*ctx) )))
+    {
+        ERR( "Failed to allocate connect worker context for %#I64x\n", addr );
+        return;
+    }
+    ctx->addr = addr;
+    if (!(thread = CreateThread( NULL, 0, connect_worker, ctx, 0, NULL )))
+    {
+        ERR( "Failed to spawn connect worker for %#I64x: %lu\n", addr, GetLastError() );
+        free( ctx );
+        return;
+    }
+    CloseHandle( thread );
+}
