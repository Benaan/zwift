+HRESULT device_information_create( const DEV_OBJECT *obj, IDeviceInformation **info )
+{
+    struct device_information *impl;
+    HRESULT hr;
+
+    TRACE( "obj %s, info %p\n", debugstr_DEV_OBJECT( obj ), info );
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IDeviceInformation_iface.lpVtbl = &device_information_vtbl;
+    impl->IDeviceInformation2_iface.lpVtbl = &device_information2_vtbl;
+    impl->ref = 1;
+    if (FAILED(hr = create_device_properties( obj->pProperties, obj->cPropertyCount, &impl->properties )))
+    {
+        free( impl );
+        return hr;
+    }
+
+    if (FAILED(hr = WindowsCreateString( obj->pszObjectId, wcslen( obj->pszObjectId ), &impl->id )))
+    {
+        IMap_HSTRING_IInspectable_Release( impl->properties );
+        free( impl );
+        return hr;
+    }
+
+    *info = &impl->IDeviceInformation_iface;
+    TRACE( "created DeviceInformation %p\n", impl );
+    return S_OK;
+}
+
+/* An update owns a snapshot of the changed properties, not the watcher's temporary DEV_OBJECT. */
+struct device_information_update
+{
+    IDeviceInformationUpdate IDeviceInformationUpdate_iface;
+    LONG ref;
+    IDeviceInformation *information;
+};
+
+static struct device_information_update *impl_from_update( IDeviceInformationUpdate *iface )
+{
+    return CONTAINING_RECORD(iface, struct device_information_update, IDeviceInformationUpdate_iface);
+}
+static HRESULT WINAPI update_QueryInterface( IDeviceInformationUpdate *iface, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!IsEqualGUID(iid, &IID_IUnknown) && !IsEqualGUID(iid, &IID_IInspectable) &&
+        !IsEqualGUID(iid, &IID_IAgileObject) && !IsEqualGUID(iid, &IID_IDeviceInformationUpdate)) return E_NOINTERFACE;
+    *out = iface;
+    IDeviceInformationUpdate_AddRef(iface);
+    return S_OK;
+}
+static ULONG WINAPI update_AddRef( IDeviceInformationUpdate *iface )
+{
+    return InterlockedIncrement(&impl_from_update(iface)->ref);
+}
+static ULONG WINAPI update_Release( IDeviceInformationUpdate *iface )
+{
+    struct device_information_update *impl = impl_from_update(iface);
+    ULONG ref = InterlockedDecrement(&impl->ref);
+    if (!ref)
+    {
+        IDeviceInformation_Release(impl->information);
+        free(impl);
+    }
+    return ref;
+}
+static HRESULT WINAPI update_GetIids( IDeviceInformationUpdate *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 0;
+    if (!(*iids = CoTaskMemAlloc(sizeof(**iids)))) return E_OUTOFMEMORY;
+    **iids = IID_IDeviceInformationUpdate;
+    *count = 1;
+    return S_OK;
+}
+static HRESULT WINAPI update_GetRuntimeClassName( IDeviceInformationUpdate *iface, HSTRING *out )
+{
+    const WCHAR *name = RuntimeClass_Windows_Devices_Enumeration_DeviceInformationUpdate;
+    return WindowsCreateString(name, wcslen(name), out);
+}
+static HRESULT WINAPI update_GetTrustLevel( IDeviceInformationUpdate *iface, TrustLevel *out )
+{
+    if (!out) return E_POINTER;
+    *out = BaseTrust;
+    return S_OK;
+}
+static HRESULT WINAPI update_get_Id( IDeviceInformationUpdate *iface, HSTRING *out )
+{
+    if (!out) return E_POINTER;
+    return IDeviceInformation_get_Id(impl_from_update(iface)->information, out);
+}
+static HRESULT WINAPI update_get_Properties( IDeviceInformationUpdate *iface, IMapView_HSTRING_IInspectable **out )
+{
+    if (!out) return E_POINTER;
+    return IDeviceInformation_get_Properties(impl_from_update(iface)->information, out);
+}
+static const IDeviceInformationUpdateVtbl update_vtbl =
+{
+    update_QueryInterface, update_AddRef, update_Release, update_GetIids,
+    update_GetRuntimeClassName, update_GetTrustLevel, update_get_Id, update_get_Properties
+};
+
+HRESULT device_information_update_create( const DEV_OBJECT *obj, IDeviceInformationUpdate **out )
+{
+    struct device_information_update *impl;
+    HRESULT hr;
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(impl = calloc(1, sizeof(*impl)))) return E_OUTOFMEMORY;
+    impl->IDeviceInformationUpdate_iface.lpVtbl = &update_vtbl;
+    impl->ref = 1;
+    if (FAILED(hr = device_information_create(obj, &impl->information)))
+    {
+        free(impl);
+        return hr;
+    }
+    *out = &impl->IDeviceInformationUpdate_iface;
     return S_OK;
 }
