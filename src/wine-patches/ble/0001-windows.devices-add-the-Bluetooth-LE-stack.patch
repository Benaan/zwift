+static BOOL advertisement_has_pattern( IBluetoothLEAdvertisement *adv, BYTE type, INT16 offset, IBuffer *pattern )
+{
+    IVectorView_BluetoothLEAdvertisementDataSection *sections;
+    IBluetoothLEAdvertisementDataSection *section;
+    IBuffer *buffer;
+    UINT32 i, count;
+    BOOL found = FALSE;
+    if (FAILED(IBluetoothLEAdvertisement_GetSectionsByType( adv, type, &sections ))) return FALSE;
+    if (SUCCEEDED(IVectorView_BluetoothLEAdvertisementDataSection_get_Size( sections, &count )))
+        for (i = 0; i < count && !found; i++)
+        {
+            if (FAILED(IVectorView_BluetoothLEAdvertisementDataSection_GetAt( sections, i, &section ))) break;
+            if (SUCCEEDED(IBluetoothLEAdvertisementDataSection_get_Data( section, &buffer )))
+            {
+                found = buffer_matches( buffer, pattern, offset );
+                if (buffer) IBuffer_Release( buffer );
+            }
+            IBluetoothLEAdvertisementDataSection_Release( section );
+        }
+    IVectorView_BluetoothLEAdvertisementDataSection_Release( sections );
+    return found;
+}
