+struct iterator
+{
+    IIterator_GUID IIterator_GUID_iface;
+    const GUID *iid;
+    LONG ref;
+
+    IVectorView_GUID *view;
+    UINT32 index;
+    UINT32 size;
+};
+
+static inline struct iterator *impl_from_IIterator_GUID( IIterator_GUID *iface )
+{
+    return CONTAINING_RECORD( iface, struct iterator, IIterator_GUID_iface );
+}
+
+static HRESULT WINAPI iterator_QueryInterface( IIterator_GUID *iface, REFIID iid, void **out )
+{
+    struct iterator *impl = impl_from_IIterator_GUID( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, impl->iid ))
+    {
+        IInspectable_AddRef( (IInspectable *)(*out = &impl->IIterator_GUID_iface) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI iterator_AddRef( IIterator_GUID *iface )
+{
+    struct iterator *impl = impl_from_IIterator_GUID( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p increasing refcount to %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI iterator_Release( IIterator_GUID *iface )
+{
+    struct iterator *impl = impl_from_IIterator_GUID( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        IVectorView_GUID_Release( impl->view );
+        free( impl );
+    }
+
+    return ref;
+}
+
+static HRESULT WINAPI iterator_GetIids( IIterator_GUID *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI iterator_GetRuntimeClassName( IIterator_GUID *iface, HSTRING *class_name )
+{
+    FIXME( "iface %p, class_name %p stub!\n", iface, class_name );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI iterator_GetTrustLevel( IIterator_GUID *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI iterator_get_Current( IIterator_GUID *iface, GUID *value )
+{
+    struct iterator *impl = impl_from_IIterator_GUID( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return IVectorView_GUID_GetAt( impl->view, impl->index, value );
+}
+
+static HRESULT WINAPI iterator_get_HasCurrent( IIterator_GUID *iface, boolean *value )
+{
+    struct iterator *impl = impl_from_IIterator_GUID( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    *value = impl->index < impl->size;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_MoveNext( IIterator_GUID *iface, boolean *value )
+{
+    struct iterator *impl = impl_from_IIterator_GUID( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (impl->index < impl->size) impl->index++;
+    return IIterator_GUID_get_HasCurrent( iface, value );
+}
+
+static HRESULT WINAPI iterator_GetMany( IIterator_GUID *iface, UINT32 items_size,
+                                        GUID *items, UINT *count )
+{
+    struct iterator *impl = impl_from_IIterator_GUID( iface );
+    TRACE( "iface %p, items_size %u, items %p, count %p.\n", iface, items_size, items, count );
+    if (impl->index == impl->size) { *count = 0; return S_OK; }
+    if (FAILED(IVectorView_GUID_GetMany( impl->view, impl->index, items_size, items, count ))) return E_BOUNDS;
+    impl->index += *count;
+    return S_OK;
+}
+
+static const IIterator_GUIDVtbl iterator_vtbl =
+{
+    iterator_QueryInterface,
+    iterator_AddRef,
+    iterator_Release,
+    /* IInspectable methods */
+    iterator_GetIids,
+    iterator_GetRuntimeClassName,
+    iterator_GetTrustLevel,
+    /* IIterator<IInspectable*> methods */
+    iterator_get_Current,
+    iterator_get_HasCurrent,
+    iterator_MoveNext,
+    iterator_GetMany,
+};
