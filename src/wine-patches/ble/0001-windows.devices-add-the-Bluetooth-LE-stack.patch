diff --git a/dlls/winebth.sys/tests/winebth.c b/dlls/winebth.sys/tests/winebth.c
new file mode 100644
index 00000000000..4aa1550635c
--- /dev/null
+++ b/dlls/winebth.sys/tests/winebth.c
@@ -0,0 +1,204 @@
+/*
+ * Wine Bluetooth driver tests
+ *
+ * This library is free software; you can redistribute it and/or
