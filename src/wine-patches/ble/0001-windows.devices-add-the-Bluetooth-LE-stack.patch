+}
+static ULONG WINAPI characteristic_Release( IGattCharacteristic *iface )
+{
+    struct characteristic *impl = impl_from_characteristic(iface);
+    ULONG ref;
+    TRACE( "(%p)\n", iface );
+    EnterCriticalSection(&impl->cs);
+    ref = InterlockedDecrement(&impl->ref);
+    if (ref == 1) SetEvent( impl->stop );
+    LeaveCriticalSection(&impl->cs);
+    if (!ref)
+    {
+        struct winebth_gatt_params params = {.operation = WINEBTH_GATT_STOP_NOTIFY};
+        unsigned int i;
+        TRACE( "destroying characteristic %#x (cccd %u)\n", impl->props.AttributeHandle, impl->cccd );
+        if (impl->cccd) characteristic_operation( impl, &params );
+        for (i = 0; i < impl->handler_count; i++)
+        {
+            ITypedEventHandler_GattCharacteristic_GattValueChangedEventArgs_Release( impl->handlers[i].handler );
+            if (impl->handlers[i].agile) IAgileReference_Release( impl->handlers[i].agile );
+        }
+        free(impl->handlers);
+        IGattDeviceService_Release(impl->service);
+        CloseHandle(impl->device);
+        CloseHandle(impl->stop);
+        DeleteCriticalSection(&impl->cs);
+        DeleteCriticalSection(&impl->operation_cs);
+        free(impl);
+    }
+    return ref;
+}
