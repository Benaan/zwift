+    NtQuerySystemTime( &now );
+    EnterCriticalSection( &device_list_cs );
+    LIST_FOR_EACH_ENTRY( device, &radio->remote_devices, struct bluetooth_remote_device, entry )
+    {
+        EnterCriticalSection( &device->props_cs );
