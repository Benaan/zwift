+/* Read a characteristic's Client Characteristic Configuration descriptor (0x2902) from BlueZ
+ * and decode the GattClientCharacteristicConfigurationDescriptorValue into params->cccd.
+ * Unlike the cached driver state this is a real ATT operation, so on a link that is not
+ * encrypted the descriptor read fails with an authentication error and propagates it - which
+ * is exactly the bond probe the Windows client performs. */
+static NTSTATUS bluez_gatt_read_cccd( void *connection, const char *char_path,
+                                      struct winebth_gatt_params *params )
+{
+    DBusMessageIter args, dict, array;
+    DBusMessage *request, *reply = NULL;
+    DBusError error;
+    NTSTATUS status;
+    unsigned int i = 0;
+    BYTE value[2] = {0};
+    char desc_path[512];
+
+    if (!bluez_cccd_cache_lookup( char_path, desc_path, sizeof(desc_path) ))
+    {
+        TRACE( "No CCCD descriptor known for %s\n", debugstr_a( char_path ) );
+        return STATUS_NOT_FOUND;
+    }
+
+    request = p_dbus_message_new_method_call( BLUEZ_DEST, desc_path, BLUEZ_INTERFACE_GATT_DESCRIPTOR,
+                                              "ReadValue" );
+    if (!request) return STATUS_NO_MEMORY;
+    p_dbus_message_iter_init_append( request, &args );
+    if (!p_dbus_message_iter_open_container( &args, DBUS_TYPE_ARRAY, "{sv}", &dict ) ||
+        !p_dbus_message_iter_close_container( &args, &dict ))
+    {
+        p_dbus_message_unref( request );
+        return STATUS_NO_MEMORY;
+    }
+
+    p_dbus_error_init( &error );
+    /* The helper takes ownership of the request, so it is not unreffed here. */
+    status = bluez_dbus_send_and_wait_for_reply( connection, request, &reply, &error );
+    if (p_dbus_error_is_set( &error ))
+    {
+        WARN( "ReadValue on CCCD %s failed: %s: %s\n", debugstr_a( desc_path ),
+              debugstr_a( error.name ), debugstr_a( error.message ) );
+        status = bluez_gatt_error_to_status( &error );
+        p_dbus_error_free( &error );
+        if (reply) p_dbus_message_unref( reply );
+        return status;
+    }
+    if (!status && reply)
+    {
+        status = STATUS_INTERNAL_ERROR;
+        if (p_dbus_message_iter_init( reply, &args ) &&
+            p_dbus_message_iter_get_arg_type( &args ) == DBUS_TYPE_ARRAY)
+        {
+            p_dbus_message_iter_recurse( &args, &array );
+            while (i < ARRAY_SIZE( value ) && p_dbus_message_iter_get_arg_type( &array ) == DBUS_TYPE_BYTE)
+            {
+                p_dbus_message_iter_get_basic( &array, &value[i++] );
+                p_dbus_message_iter_next( &array );
+            }
+            if (i == ARRAY_SIZE( value ))
+            {
+                params->cccd = value[0] | (value[1] << 8);
+                status = STATUS_SUCCESS;
+                TRACE( "CCCD of %s is %u\n", debugstr_a( char_path ), params->cccd );
+            }
+        }
+    }
+    if (reply) p_dbus_message_unref( reply );
+    return status;
+}
