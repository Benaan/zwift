+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <ntstatus.h>
+#define WIN32_NO_STATUS
+#include <windows.h>
+#include <winioctl.h>
+#include <winternl.h>
+#include <initguid.h>
+#include <setupapi.h>
+
+#include <bthsdpdef.h>
+#include <bthdef.h>
+#include <bluetoothapis.h>
+#include <bthledef.h>
+
+#include "wine/test.h"
+#include "wine/winebth.h"
+
+/* The driver registers its control device under this name in DriverEntry. */
+#define BTH_AUTH_DEVICE_NAME L"\\Device\\WINEBTHAUTH"
+
+/* Opening a handle is enough to reach the dispatch routines; the driver loads
+ * its BlueZ backend in DriverEntry, so it is either fully present or absent. */
+static HANDLE open_device( const WCHAR *path )
+{
+    UNICODE_STRING string;
+    OBJECT_ATTRIBUTES attr;
+    IO_STATUS_BLOCK iosb;
+    NTSTATUS status;
+    HANDLE handle;
+
+    RtlInitUnicodeString( &string, path );
+    InitializeObjectAttributes( &attr, &string, 0, NULL, NULL );
+    status = NtOpenFile( &handle, GENERIC_READ | GENERIC_WRITE, &attr, &iosb,
+                         FILE_SHARE_READ | FILE_SHARE_WRITE, 0 );
+    if (status) return INVALID_HANDLE_VALUE;
+    return handle;
+}
+
+static NTSTATUS ioctl_status( HANDLE device, ULONG code, void *in, ULONG in_size,
+                              void *out, ULONG out_size, IO_STATUS_BLOCK *iosb )
+{
+    return NtDeviceIoControlFile( device, NULL, NULL, NULL, iosb, code,
+                                  in, in_size, out, out_size );
+}
+
+static void test_control_device(void)
+{
+    IO_STATUS_BLOCK iosb;
+    NTSTATUS status;
+    HANDLE device;
+
+    device = open_device( BTH_AUTH_DEVICE_NAME );
+    if (device == INVALID_HANDLE_VALUE)
+    {
+        /* DriverEntry fails when the BlueZ backend cannot be initialised, in
+         * which case the driver never publishes any device. */
+        win_skip( "winebth.sys is not loaded, no BlueZ backend available\n" );
+        return;
+    }
+
+    /* Only IOCTL_WINEBTH_AUTH_REGISTER is handled on this device. Any other
+     * code falls through and completes the IRP with the status it arrived
+     * with, leaving the IOSB untouched. */
+    iosb.Status = 0xdeadbeef;
+    iosb.Information = 0xdeadbeef;
+    status = ioctl_status( device, 0xdeadbeef, NULL, 0, NULL, 0, &iosb );
+    ok( !status, "unknown IOCTL on the control device returned %#lx\n", status );
+    ok( iosb.Status == 0xdeadbeef, "got status %#lx\n", iosb.Status );
+    ok( iosb.Information == 0xdeadbeef, "got size %#Ix\n", iosb.Information );
+
+    CloseHandle( device );
+}
+
+static void test_radio_ioctls( HANDLE device )
+{
+    struct winebth_radio_set_flag_params flag = {0};
+    IO_STATUS_BLOCK iosb;
+    NTSTATUS status;
+    UINT32 value;
+
+    /* The output size is validated before the adapter is consulted, so these
+     * hold whether or not the radio reports the property. */
+    status = ioctl_status( device, IOCTL_WINEBTH_RADIO_GET_POWERED, NULL, 0, NULL, 0, &iosb );
+    ok( status == STATUS_BUFFER_TOO_SMALL, "GET_POWERED with no buffer returned %#lx\n", status );
+
+    value = 0xdeadbeef;
+    status = ioctl_status( device, IOCTL_WINEBTH_RADIO_GET_POWERED, NULL, 0, &value, sizeof(value) - 1, &iosb );
+    ok( status == STATUS_BUFFER_TOO_SMALL, "GET_POWERED with a short buffer returned %#lx\n", status );
+    ok( value == 0xdeadbeef, "GET_POWERED wrote on failure, got %#x\n", value );
+
+    status = ioctl_status( device, IOCTL_WINEBTH_RADIO_GET_LE_ROLES, NULL, 0, NULL, 0, &iosb );
+    ok( status == STATUS_BUFFER_TOO_SMALL, "GET_LE_ROLES with no buffer returned %#lx\n", status );
+
+    value = 0xdeadbeef;
+    status = ioctl_status( device, IOCTL_WINEBTH_RADIO_GET_LE_ROLES, NULL, 0, &value, sizeof(value) - 1, &iosb );
+    ok( status == STATUS_BUFFER_TOO_SMALL, "GET_LE_ROLES with a short buffer returned %#lx\n", status );
+    ok( value == 0xdeadbeef, "GET_LE_ROLES wrote on failure, got %#x\n", value );
+
+    /* SET_FLAG needs a complete parameter block. */
+    status = ioctl_status( device, IOCTL_WINEBTH_RADIO_SET_FLAG, NULL, 0, NULL, 0, &iosb );
+    ok( status == STATUS_INVALID_PARAMETER, "SET_FLAG with no input returned %#lx\n", status );
+
+    flag.flag = 0;
+    flag.enable = 1;
+    status = ioctl_status( device, IOCTL_WINEBTH_RADIO_SET_FLAG, &flag, sizeof(flag) - 1, NULL, 0, &iosb );
+    ok( status == STATUS_BUFFER_TOO_SMALL, "SET_FLAG with a short input returned %#lx\n", status );
+
+    /* A complete request reaches the backend, which rejects an unknown flag. */
+    status = ioctl_status( device, IOCTL_WINEBTH_RADIO_SET_FLAG, &flag, sizeof(flag), NULL, 0, &iosb );
+    ok( status == STATUS_INVALID_PARAMETER || status == STATUS_NOT_SUPPORTED,
+        "SET_FLAG with an unknown flag returned %#lx\n", status );
+
+    /* The adapter is allowed not to report these properties at all. */
+    memset( &value, 0xbe, sizeof(value) );
+    iosb.Information = 0;
+    status = ioctl_status( device, IOCTL_WINEBTH_RADIO_GET_POWERED, NULL, 0, &value, sizeof(value), &iosb );
+    ok( !status || status == STATUS_NOT_SUPPORTED || status == STATUS_DEVICE_NOT_CONNECTED,
+        "GET_POWERED returned %#lx\n", status );
+    if (!status)
+    {
+        ok( value <= 1, "GET_POWERED reported %#x\n", value );
+        ok( iosb.Information == sizeof(UINT32), "GET_POWERED returned size %#Ix\n", iosb.Information );
+    }
+
+    memset( &value, 0xbe, sizeof(value) );
+    iosb.Information = 0;
+    status = ioctl_status( device, IOCTL_WINEBTH_RADIO_GET_LE_ROLES, NULL, 0, &value, sizeof(value), &iosb );
+    ok( !status || status == STATUS_NOT_SUPPORTED || status == STATUS_DEVICE_NOT_CONNECTED,
+        "GET_LE_ROLES returned %#lx\n", status );
+    if (!status)
+    {
+        ok( !(value & ~(WINEBTH_LE_ROLE_CENTRAL | WINEBTH_LE_ROLE_PERIPHERAL)),
+            "GET_LE_ROLES reported unknown roles %#x\n", value );
+        ok( iosb.Information == sizeof(UINT32), "GET_LE_ROLES returned size %#Ix\n", iosb.Information );
+    }
+}
+
+static void test_radio_device(void)
+{
+    SP_DEVICE_INTERFACE_DETAIL_DATA_W *detail;
+    SP_DEVICE_INTERFACE_DATA iface = {sizeof(iface)};
+    DWORD size, index = 0, count = 0;
+    HDEVINFO set;
+    HANDLE device;
+
+    /* Radio PDOs are created from the host adapters and register
+     * GUID_BLUETOOTH_RADIO_INTERFACE when they start. */
+    set = SetupDiGetClassDevsW( &GUID_BLUETOOTH_RADIO_INTERFACE, NULL, NULL,
+                                DIGCF_DEVICEINTERFACE | DIGCF_PRESENT );
+    if (set == INVALID_HANDLE_VALUE)
+    {
+        win_skip( "no Bluetooth radio interface class\n" );
+        return;
+    }
+
+    while (SetupDiEnumDeviceInterfaces( set, NULL, &GUID_BLUETOOTH_RADIO_INTERFACE, index++, &iface ))
+    {
+        count++;
+        size = 0;
+        SetupDiGetDeviceInterfaceDetailW( set, &iface, NULL, 0, &size, NULL );
+        if (!size) continue;
+        if (!(detail = HeapAlloc( GetProcessHeap(), 0, size ))) continue;
+
+        detail->cbSize = sizeof(*detail);
+        if (SetupDiGetDeviceInterfaceDetailW( set, &iface, detail, size, NULL, NULL ))
+        {
+            device = CreateFileW( detail->DevicePath, GENERIC_READ | GENERIC_WRITE,
+                                  FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL );
+            if (device != INVALID_HANDLE_VALUE)
+            {
+                test_radio_ioctls( device );
+                CloseHandle( device );
+            }
+        }
+        HeapFree( GetProcessHeap(), 0, detail );
+    }
+
+    SetupDiDestroyDeviceInfoList( set );
+
+    if (!count) win_skip( "no Bluetooth radio present\n" );
+}
+
+START_TEST(winebth)
+{
+    test_control_device();
+    test_radio_device();
+}
