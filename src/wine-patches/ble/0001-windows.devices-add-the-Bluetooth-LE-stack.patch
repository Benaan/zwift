     impl = calloc(1, sizeof(*impl));
     if (!impl)
+    {
+        apartment_release(apt);
         return E_OUTOFMEMORY;
+    }
+
+    /* An agile object does not need marshaling, so do not initialize RPC remoting
+     * for it. Doing so from the thread that is registering a WinRT event handler
