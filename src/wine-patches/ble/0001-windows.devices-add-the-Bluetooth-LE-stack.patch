+HRESULT advertisement_section_create( BYTE type, const BYTE *data, UINT32 size, IBluetoothLEAdvertisementDataSection **out )
+{
+    IBufferFactory *factory;
+    IBufferByteAccess *access;
+    HSTRING name;
+    BYTE *bytes;
+    HRESULT hr;
+    struct section *impl;
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->iface.lpVtbl = &section_vtbl;
+    impl->ref = 1;
+    InitializeCriticalSection( &impl->cs );
+    impl->type = type;
+    hr = WindowsCreateString( RuntimeClass_Windows_Storage_Streams_Buffer,
+                              wcslen(RuntimeClass_Windows_Storage_Streams_Buffer), &name );
+    if (SUCCEEDED(hr))
+    {
+        hr = RoGetActivationFactory( name, &IID_IBufferFactory, (void **)&factory );
+        WindowsDeleteString( name );
+        if (SUCCEEDED(hr))
+        {
+            hr = IBufferFactory_Create( factory, size, &impl->data );
+            IBufferFactory_Release( factory );
+        }
+    }
+    if (SUCCEEDED(hr)) hr = IBuffer_QueryInterface( impl->data, &IID_IBufferByteAccess, (void **)&access );
+    if (SUCCEEDED(hr))
+    {
+        hr = IBufferByteAccess_Buffer( access, &bytes );
+        if (SUCCEEDED(hr) && size) memcpy( bytes, data, size );
+        IBufferByteAccess_Release( access );
+        if (SUCCEEDED(hr)) hr = IBuffer_put_Length( impl->data, size );
+    }
+    if (FAILED(hr)) { section_Release( &impl->iface ); return hr; }
+    *out = &impl->iface;
+    return S_OK;
+}
