+static unsigned int bluez_uuid_bytes( const GUID *uuid, BYTE *bytes )
+{
+    static const GUID base = {0, 0, 0x1000, {0x80, 0, 0, 0x80, 0x5f, 0x9b, 0x34, 0xfb}};
+    unsigned int i;
+    if (uuid->Data2 == base.Data2 && uuid->Data3 == base.Data3 && !memcmp( uuid->Data4, base.Data4, 8 ))
+    {
+        for (i = 0; i < 4; i++) bytes[i] = uuid->Data1 >> (8 * i);
+        return uuid->Data1 <= 0xffff ? 2 : 4;
+    }
+    for (i = 0; i < 8; i++) bytes[i] = uuid->Data4[7 - i];
+    bytes[8] = uuid->Data3;
+    bytes[9] = uuid->Data3 >> 8;
+    bytes[10] = uuid->Data2;
+    bytes[11] = uuid->Data2 >> 8;
+    for (i = 0; i < 4; i++) bytes[12 + i] = uuid->Data1 >> (8 * i);
+    return 16;
+}
