+    list_add_tail( &pairing_operations, &op->entry );
+    LeaveCriticalSection( &pairing_cs );
+
+    if (DeviceIoControl( device, IOCTL_WINEBTH_DEVICE_PAIR, NULL, 0, NULL, 0, &bytes, NULL )) hr = S_OK;
+    else hr = HRESULT_FROM_WIN32( GetLastError() );
+
+    EnterCriticalSection( &pairing_cs );
+    list_remove( &op->entry );
+    LeaveCriticalSection( &pairing_cs );
+    free( op );
+    CloseHandle( device );
+    return hr;
+}
+
+static HRESULT pair_async_callback( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    struct pair_async_ctx *ctx = impl_from_IInspectable( (IInspectable *)param );
+    DevicePairingResultStatus status = DevicePairingResultStatus_Failed;
+    IDevicePairingResult *pairing_result = NULL;
+    HRESULT hr;
+
+    if (!called_async) return STATUS_PENDING;
+
+    if (SUCCEEDED(pair_async_ctx_pair( ctx ))) status = DevicePairingResultStatus_Paired;
+    hr = device_pairing_result_create( status, ctx->protection, &pairing_result );
+    result->vt = VT_UNKNOWN;
+    result->punkVal = (IUnknown *)pairing_result;
+    return hr;
+}
+
+static HRESULT unpair_async_callback( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    struct pair_async_ctx *ctx = impl_from_IInspectable( (IInspectable *)param );
+    DeviceUnpairingResultStatus status = DeviceUnpairingResultStatus_Failed;
+    IDeviceUnpairingResult *unpairing_result = NULL;
+    DWORD bytes;
+    HANDLE device;
+    HRESULT hr;
+
+    if (!called_async) return STATUS_PENDING;
+
+    /* Drop the bond by removing the BlueZ Device1 object. The Windows client calls this to
+     * clear a stale/ghost bond ("paired but not bonded") before pairing again. */
+    if (ctx && ctx->id &&
+        (device = CreateFileW( ctx->id, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                               NULL, OPEN_EXISTING, 0, NULL )) != INVALID_HANDLE_VALUE)
+    {
+        if (DeviceIoControl( device, IOCTL_WINEBTH_DEVICE_UNPAIR, NULL, 0, NULL, 0, &bytes, NULL ))
+            status = DeviceUnpairingResultStatus_Unpaired;
+        CloseHandle( device );
+    }
+    else
+        status = DeviceUnpairingResultStatus_AlreadyUnpaired;
+
+    hr = device_unpairing_result_create( status, &unpairing_result );
+    result->vt = VT_UNKNOWN;
+    result->punkVal = (IUnknown *)unpairing_result;
+    return hr;
+}
