+    characteristic_ReadValueAsync,
+    characteristic_ReadValueWithCacheModeAsync,
+    characteristic_WriteValueAsync,
+    characteristic_WriteValueWithOptionAsync,
+    characteristic_ReadClientCharacteristicConfigurationDescriptorAsync,
+    characteristic_WriteClientCharacteristicConfigurationDescriptorAsync,
+    characteristic_add_ValueChanged,
