+ */
+
+#include "private.h"
+#include "robuffer.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wintypes);
+
+struct data_reader
+{
+    IDataReader IDataReader_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+    CRITICAL_SECTION cs;
+    IBuffer *buffer;
+    UINT32 position, length;
+    BOOL closed;
+    ByteOrder byte_order;
+    UnicodeEncoding unicode_encoding;
+    InputStreamOptions input_stream_options;
+};
+
+static struct data_reader *impl_from_IDataReader(IDataReader *iface)
+{
+    return CONTAINING_RECORD(iface, struct data_reader, IDataReader_iface);
+}
+
+static HRESULT WINAPI reader_QueryInterface(IDataReader *iface, REFIID iid, void **out)
+{
+    struct data_reader *impl = impl_from_IDataReader(iface);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IDataReader))
+        *out = iface;
+    else if (IsEqualGUID(iid, &IID_IClosable))
+        *out = &impl->IClosable_iface;
+    else
+    {
+        WARN("Unsupported interface %s.\n", debugstr_guid(iid));
+        return E_NOINTERFACE;
+    }
+    IDataReader_AddRef(iface);
+    return S_OK;
+}
+
+static ULONG WINAPI reader_AddRef(IDataReader *iface)
+{
+    return InterlockedIncrement(&impl_from_IDataReader(iface)->ref);
+}
+
+static ULONG WINAPI reader_Release(IDataReader *iface)
+{
+    struct data_reader *impl = impl_from_IDataReader(iface);
+    ULONG ref = InterlockedDecrement(&impl->ref);
+
+    if (!ref)
+    {
+        if (impl->buffer) IBuffer_Release(impl->buffer);
+        DeleteCriticalSection(&impl->cs);
+        free(impl);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI reader_GetIids(IDataReader *iface, ULONG *count, IID **iids)
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 0;
+    if (!(*iids = CoTaskMemAlloc(2 * sizeof(**iids)))) return E_OUTOFMEMORY;
+    (*iids)[0] = IID_IDataReader;
+    (*iids)[1] = IID_IClosable;
+    *count = 2;
+    return S_OK;
+}
+
+static HRESULT WINAPI reader_GetRuntimeClassName(IDataReader *iface, HSTRING *name)
+{
+    static const WCHAR class_name[] = L"Windows.Storage.Streams.DataReader";
+    if (!name) return E_POINTER;
+    return WindowsCreateString(class_name, ARRAY_SIZE(class_name) - 1, name);
+}
+
+static HRESULT WINAPI reader_GetTrustLevel(IDataReader *iface, TrustLevel *level)
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI reader_get_UnconsumedBufferLength(IDataReader *iface, UINT32 *value)
+{
+    struct data_reader *impl = impl_from_IDataReader(iface);
+    HRESULT hr = S_OK;
+
+    if (!value) return E_POINTER;
+    EnterCriticalSection(&impl->cs);
+    if (impl->closed) hr = RO_E_CLOSED;
+    else *value = impl->length - impl->position;
+    LeaveCriticalSection(&impl->cs);
+    return hr;
+}
+
+static HRESULT WINAPI reader_ReadBytes(IDataReader *iface, UINT32 size, BYTE *value)
+{
+    struct data_reader *impl = impl_from_IDataReader(iface);
+    IBufferByteAccess *access;
+    BYTE *data;
+    UINT32 length;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, size %u, value %p.\n", iface, size, value);
+
+    if (size && !value) return E_POINTER;
+    EnterCriticalSection(&impl->cs);
+    if (impl->closed) hr = RO_E_CLOSED;
+    else if (size > impl->length - impl->position) hr = E_BOUNDS;
+    else if (size)
+    {
+        /* The caller can still change the original buffer's Length. */
+        if (SUCCEEDED(hr = IBuffer_get_Length(impl->buffer, &length)))
+        {
+            if (impl->position > length || size > length - impl->position) hr = E_BOUNDS;
+            else if (SUCCEEDED(hr = IBuffer_QueryInterface(impl->buffer, &IID_IBufferByteAccess, (void **)&access)))
+            {
+                if (SUCCEEDED(hr = IBufferByteAccess_Buffer(access, &data)))
+                {
+                    memcpy(value, data + impl->position, size);
+                    impl->position += size;
+                }
+                IBufferByteAccess_Release(access);
+            }
+        }
+    }
+    LeaveCriticalSection(&impl->cs);
+    return hr;
+}
+
+static HRESULT WINAPI reader_ReadByte(IDataReader *iface, BYTE *value)
+{
+    return reader_ReadBytes(iface, 1, value);
+}
+
+static void reader_byteswap( void *data, UINT32 size )
+{
+    BYTE *bytes = data, tmp;
+    UINT32 i;
+
+    for (i = 0; i < size / 2; i++)
+    {
+        tmp = bytes[i];
+        bytes[i] = bytes[size - 1 - i];
+        bytes[size - 1 - i] = tmp;
+    }
+}
+
+static HRESULT reader_read_value( IDataReader *iface, void *value, UINT32 size )
+{
+    struct data_reader *impl = impl_from_IDataReader(iface);
+    BOOL big_endian;
+    HRESULT hr;
+
+    EnterCriticalSection(&impl->cs);
+    big_endian = impl->byte_order == ByteOrder_BigEndian;
+    LeaveCriticalSection(&impl->cs);
+
+    if (FAILED(hr = reader_ReadBytes(iface, size, value))) return hr;
+    if (big_endian && size > 1) reader_byteswap(value, size);
+    return S_OK;
+}
+
+static HRESULT WINAPI reader_get_UnicodeEncoding(IDataReader *iface, UnicodeEncoding *value)
+{
+    struct data_reader *impl = impl_from_IDataReader(iface);
+
+    if (!value) return E_POINTER;
+    EnterCriticalSection(&impl->cs);
+    *value = impl->unicode_encoding;
+    LeaveCriticalSection(&impl->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI reader_put_UnicodeEncoding(IDataReader *iface, UnicodeEncoding value)
+{
+    struct data_reader *impl = impl_from_IDataReader(iface);
+
+    if (value > UnicodeEncoding_Utf16BE) return E_INVALIDARG;
+    EnterCriticalSection(&impl->cs);
+    impl->unicode_encoding = value;
+    LeaveCriticalSection(&impl->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI reader_get_ByteOrder(IDataReader *iface, ByteOrder *value)
+{
+    struct data_reader *impl = impl_from_IDataReader(iface);
+
+    if (!value) return E_POINTER;
+    EnterCriticalSection(&impl->cs);
+    *value = impl->byte_order;
+    LeaveCriticalSection(&impl->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI reader_put_ByteOrder(IDataReader *iface, ByteOrder value)
+{
+    struct data_reader *impl = impl_from_IDataReader(iface);
+
+    if (value > ByteOrder_BigEndian) return E_INVALIDARG;
+    EnterCriticalSection(&impl->cs);
+    impl->byte_order = value;
+    LeaveCriticalSection(&impl->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI reader_get_InputStreamOptions(IDataReader *iface, InputStreamOptions *value)
+{
+    struct data_reader *impl = impl_from_IDataReader(iface);
+
+    if (!value) return E_POINTER;
+    EnterCriticalSection(&impl->cs);
+    *value = impl->input_stream_options;
+    LeaveCriticalSection(&impl->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI reader_put_InputStreamOptions(IDataReader *iface, InputStreamOptions value)
+{
+    struct data_reader *impl = impl_from_IDataReader(iface);
+
+    EnterCriticalSection(&impl->cs);
+    impl->input_stream_options = value;
+    LeaveCriticalSection(&impl->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI reader_ReadBuffer(IDataReader *iface, UINT32 length, IBuffer **buffer)
+{
+    IBufferFactory *factory;
+    IBufferByteAccess *access;
+    BYTE *data, *dest;
+    HRESULT hr;
+
+    if (!buffer) return E_POINTER;
+    *buffer = NULL;
+    if (!(data = malloc(length ? length : 1))) return E_OUTOFMEMORY;
+
+    if (FAILED(hr = reader_ReadBytes(iface, length, data))) goto done;
+
+    if (FAILED(hr = IActivationFactory_QueryInterface(buffer_activation_factory, &IID_IBufferFactory,
+                                                      (void **)&factory))) goto done;
+    hr = IBufferFactory_Create(factory, length, buffer);
+    IBufferFactory_Release(factory);
+    if (FAILED(hr)) goto done;
+    if (FAILED(hr = IBuffer_QueryInterface(*buffer, &IID_IBufferByteAccess, (void **)&access))) goto done;
+    if (SUCCEEDED(hr = IBufferByteAccess_Buffer(access, &dest)))
+    {
+        if (length) memcpy(dest, data, length);
+        hr = IBuffer_put_Length(*buffer, length);
+    }
+    IBufferByteAccess_Release(access);
+    if (FAILED(hr)) { IBuffer_Release(*buffer); *buffer = NULL; }
+
+done:
+    free(data);
+    return hr;
+}
+
+static HRESULT WINAPI reader_ReadBoolean(IDataReader *iface, boolean *value)
+{
+    BYTE byte;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    if (FAILED(hr = reader_ReadBytes(iface, 1, &byte))) return hr;
+    *value = byte != 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI reader_ReadGuid(IDataReader *iface, GUID *value)
+{
+    struct data_reader *impl = impl_from_IDataReader(iface);
+    ByteOrder order;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    if (FAILED(hr = reader_ReadBytes(iface, sizeof(*value), (BYTE *)value))) return hr;
+    EnterCriticalSection(&impl->cs);
+    order = impl->byte_order;
+    LeaveCriticalSection(&impl->cs);
+    /* Mirror data_writer_WriteGuid: only the integer fields follow the byte order. */
+    if (order == ByteOrder_BigEndian)
+    {
+        reader_byteswap((BYTE *)value, sizeof(value->Data1));
+        reader_byteswap((BYTE *)value + offsetof(GUID, Data2), sizeof(value->Data2));
+        reader_byteswap((BYTE *)value + offsetof(GUID, Data3), sizeof(value->Data3));
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI reader_ReadInt16(IDataReader *iface, INT16 *value)
+{
+    if (!value) return E_POINTER;
+    return reader_read_value(iface, value, sizeof(*value));
+}
+
+static HRESULT WINAPI reader_ReadInt32(IDataReader *iface, INT32 *value)
+{
+    if (!value) return E_POINTER;
+    return reader_read_value(iface, value, sizeof(*value));
+}
+
+static HRESULT WINAPI reader_ReadInt64(IDataReader *iface, INT64 *value)
+{
+    if (!value) return E_POINTER;
+    return reader_read_value(iface, value, sizeof(*value));
+}
+
+static HRESULT WINAPI reader_ReadUInt16(IDataReader *iface, UINT16 *value)
+{
+    if (!value) return E_POINTER;
+    return reader_read_value(iface, value, sizeof(*value));
+}
+
+static HRESULT WINAPI reader_ReadUInt32(IDataReader *iface, UINT32 *value)
+{
+    if (!value) return E_POINTER;
+    return reader_read_value(iface, value, sizeof(*value));
+}
+
+static HRESULT WINAPI reader_ReadUInt64(IDataReader *iface, UINT64 *value)
+{
+    if (!value) return E_POINTER;
+    return reader_read_value(iface, value, sizeof(*value));
+}
+
+static HRESULT WINAPI reader_ReadSingle(IDataReader *iface, FLOAT *value)
+{
+    if (!value) return E_POINTER;
+    return reader_read_value(iface, value, sizeof(*value));
+}
+
+static HRESULT WINAPI reader_ReadDouble(IDataReader *iface, DOUBLE *value)
+{
+    if (!value) return E_POINTER;
+    return reader_read_value(iface, value, sizeof(*value));
+}
+
+static HRESULT WINAPI reader_ReadString(IDataReader *iface, UINT32 count, HSTRING *value)
+{
+    struct data_reader *impl = impl_from_IDataReader(iface);
+    UnicodeEncoding encoding;
+    UINT32 byte_count, i;
+    BYTE *bytes;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    EnterCriticalSection(&impl->cs);
+    encoding = impl->unicode_encoding;
+    LeaveCriticalSection(&impl->cs);
+
+    if (encoding != UnicodeEncoding_Utf8 && count > 0x7fffffffu) return E_INVALIDARG;
+    byte_count = encoding == UnicodeEncoding_Utf8 ? count : count * 2;
+
+    /* Reading zero code units is an empty string in every encoding. */
+    if (!byte_count) return WindowsCreateString( L"", 0, value );
+
+    if (!(bytes = malloc(byte_count))) return E_OUTOFMEMORY;
+    if (FAILED(hr = reader_ReadBytes(iface, byte_count, bytes))) { free(bytes); return hr; }
+
+    if (encoding == UnicodeEncoding_Utf8)
+    {
+        int wide_len;
+        WCHAR *wide;
+
+        if ((wide_len = MultiByteToWideChar(CP_UTF8, 0, (char *)bytes, byte_count, NULL, 0)))
+        {
+            if (!(wide = malloc((wide_len + 1) * sizeof(WCHAR)))) { free(bytes); return E_OUTOFMEMORY; }
+            MultiByteToWideChar(CP_UTF8, 0, (char *)bytes, byte_count, wide, wide_len);
+            hr = WindowsCreateString(wide, wide_len, value);
+            free(wide);
+        }
+        else hr = HRESULT_FROM_WIN32(GetLastError());
+    }
+    else
+    {
+        if (encoding == UnicodeEncoding_Utf16BE)
+            for (i = 0; i < count; i++)
+            {
+                BYTE tmp = bytes[i * 2];
+                bytes[i * 2] = bytes[i * 2 + 1];
+                bytes[i * 2 + 1] = tmp;
+            }
+        hr = WindowsCreateString((WCHAR *)bytes, count, value);
+    }
+    free(bytes);
+    return hr;
+}
+
+static HRESULT WINAPI reader_ReadDateTime(IDataReader *iface, DateTime *value)
+{
+    if (!value) return E_POINTER;
