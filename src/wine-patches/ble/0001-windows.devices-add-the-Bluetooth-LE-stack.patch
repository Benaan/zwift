+/* Bluetooth radio objects.
+ *
+ * This library is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License, version 2.1 or later.
+ */
+#include "private.h"
+#include "bthsdpdef.h"
+#include "bthledef.h"
+#include "bluetoothapis.h"
+#include "winioctl.h"
+#include "wine/winebth.h"
+#include "roapi.h"
+#include "combaseapi.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(radios);
+
+struct handler_entry
+{
+    ITypedEventHandler_Radio_IInspectable *handler;
+    EventRegistrationToken token;
+    IAgileReference *agile; /* Marshals the handler to the invoking apartment, if available. */
+};
+struct radio
+{
+    IRadio IRadio_iface;
+    LONG ref;
+    HANDLE handle, stop;
+    CRITICAL_SECTION cs;
+    BOOL running;
+    struct handler_entry *handlers;
+    unsigned int count;
+    LONGLONG next_token;
+    RadioState state;
+};
+static struct radio *impl_from_IRadio( IRadio *iface )
+{
+    return CONTAINING_RECORD(iface, struct radio, IRadio_iface);
+}
+static HRESULT WINAPI radio_QueryInterface( IRadio *iface, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IRadio))
+    {
+        *out = iface;
+        IRadio_AddRef(iface);
+        return S_OK;
+    }
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI radio_AddRef( IRadio *iface )
+{
+    return InterlockedIncrement(&impl_from_IRadio(iface)->ref);
+}
+static ULONG WINAPI radio_Release( IRadio *iface )
+{
+    struct radio *impl = impl_from_IRadio(iface);
+    ULONG ref;
+    unsigned int i;
+    EnterCriticalSection(&impl->cs);
+    ref = InterlockedDecrement(&impl->ref);
+    if (ref == 1 && impl->running) SetEvent(impl->stop);
+    LeaveCriticalSection(&impl->cs);
+    if (!ref)
+    {
+        for (i = 0; i < impl->count; i++)
+        {
+            ITypedEventHandler_Radio_IInspectable_Release(impl->handlers[i].handler);
+            if (impl->handlers[i].agile) IAgileReference_Release(impl->handlers[i].agile);
+        }
+        free(impl->handlers);
+        CloseHandle(impl->stop);
+        CloseHandle(impl->handle);
+        DeleteCriticalSection(&impl->cs);
+        free(impl);
+    }
+    return ref;
+}
+static HRESULT WINAPI radio_GetIids( IRadio *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 0;
+    if (!(*iids = CoTaskMemAlloc(sizeof(**iids)))) return E_OUTOFMEMORY;
+    **iids = IID_IRadio;
+    *count = 1;
+    return S_OK;
+}
+static HRESULT WINAPI radio_GetRuntimeClassName( IRadio *iface, HSTRING *out )
+{
+    const WCHAR *name = RuntimeClass_Windows_Devices_Radios_Radio;
+    if (!out) return E_POINTER;
+    return WindowsCreateString(name, wcslen(name), out);
+}
+static HRESULT WINAPI radio_GetTrustLevel( IRadio *iface, TrustLevel *out )
+{
+    if (!out) return E_POINTER;
+    *out = BaseTrust;
+    return S_OK;
+}
+static HRESULT WINAPI radio_get_State( IRadio *iface, RadioState *out )
+{
+    struct radio *impl = impl_from_IRadio(iface);
+    UINT32 powered;
+    DWORD bytes, error;
+    if (!out) return E_POINTER;
+    *out = RadioState_Unknown;
+    if (!DeviceIoControl(impl->handle, IOCTL_WINEBTH_RADIO_GET_POWERED, NULL, 0,
+                         &powered, sizeof(powered), &bytes, NULL))
+    {
+        error = GetLastError();
+        if (error == ERROR_NOT_SUPPORTED || error == ERROR_DEVICE_NOT_CONNECTED) return S_OK;
+        return HRESULT_FROM_WIN32(error);
+    }
+    *out = powered ? RadioState_On : RadioState_Off;
+    return S_OK;
+}
+static HRESULT WINAPI radio_get_Name( IRadio *iface, HSTRING *out )
+{
+    BLUETOOTH_RADIO_INFO info = {.dwSize = sizeof(info)};
+    DWORD error;
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if ((error = BluetoothGetRadioInfo(impl_from_IRadio(iface)->handle, &info))) return HRESULT_FROM_WIN32(error);
+    return WindowsCreateString(info.szName, wcslen(info.szName), out);
+}
+static HRESULT WINAPI radio_get_Kind( IRadio *iface, RadioKind *out )
+{
+    if (!out) return E_POINTER;
+    *out = RadioKind_Bluetooth;
+    return S_OK;
+}
+static HRESULT WINAPI radio_SetStateAsync( IRadio *iface, RadioState state, IAsyncOperation_RadioAccessStatus **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (state != RadioState_On && state != RadioState_Off) return E_INVALIDARG;
+    FIXME("Radio power control is not implemented.\n");
+    return E_NOTIMPL;
+}
+static DWORD WINAPI radio_worker( void *arg )
+{
+    struct radio *impl = arg;
+    HRESULT init = RoInitialize(RO_INIT_MULTITHREADED);
+    while (WaitForSingleObject(impl->stop, 250) == WAIT_TIMEOUT)
+    {
+        struct handler_entry *snapshot = NULL;
+        unsigned int count = 0, i;
+        RadioState state;
+        if (FAILED(radio_get_State(&impl->IRadio_iface, &state))) continue;
+        EnterCriticalSection(&impl->cs);
+        if (state != impl->state)
+        {
+            impl->state = state;
+            if (impl->count && (snapshot = malloc(impl->count * sizeof(*snapshot))))
+            {
+                count = impl->count;
+                memcpy(snapshot, impl->handlers, count * sizeof(*snapshot));
+                for (i = 0; i < count; i++)
+                {
+                    ITypedEventHandler_Radio_IInspectable_AddRef(snapshot[i].handler);
+                    if (snapshot[i].agile) IAgileReference_AddRef(snapshot[i].agile);
+                }
+            }
+        }
+        LeaveCriticalSection(&impl->cs);
+        for (i = 0; i < count; i++)
+        {
+            ITypedEventHandler_Radio_IInspectable *handler = snapshot[i].handler;
+            void *resolved = NULL;
+
+            /* Resolve in this apartment so a non-agile handler is invoked through a proxy. */
+            if (snapshot[i].agile &&
+                SUCCEEDED(IAgileReference_Resolve(snapshot[i].agile, &IID_ITypedEventHandler_Radio_IInspectable, &resolved)))
+                handler = (ITypedEventHandler_Radio_IInspectable *)resolved;
+
+            ITypedEventHandler_Radio_IInspectable_Invoke(handler, &impl->IRadio_iface, NULL);
+
+            if (resolved) IUnknown_Release((IUnknown *)resolved);
+            ITypedEventHandler_Radio_IInspectable_Release(snapshot[i].handler);
+            if (snapshot[i].agile) IAgileReference_Release(snapshot[i].agile);
+        }
+        free(snapshot);
+    }
+    if (SUCCEEDED(init)) RoUninitialize();
+    EnterCriticalSection(&impl->cs);
+    impl->running = FALSE;
+    LeaveCriticalSection(&impl->cs);
+    IRadio_Release(&impl->IRadio_iface);
+    return 0;
+}
+static HRESULT WINAPI radio_add_StateChanged( IRadio *iface, ITypedEventHandler_Radio_IInspectable *handler,
+                                              EventRegistrationToken *token )
+{
+    struct radio *impl = impl_from_IRadio(iface);
+    IAgileReference *agile = NULL;
+    struct handler_entry *tmp;
+    HANDLE thread;
+    HRESULT hr = S_OK;
+    if (!handler || !token) return E_POINTER;
+    token->value = 0;
+    /* Best effort: marshal the handler so the state worker can invoke a non-agile one. */
+    if (FAILED(RoGetAgileReference( AGILEREFERENCE_DELAYEDMARSHAL, &IID_ITypedEventHandler_Radio_IInspectable,
+                                    (IUnknown *)handler, &agile )))
+        agile = NULL;
+    EnterCriticalSection(&impl->cs);
+    if (!(tmp = realloc(impl->handlers, (impl->count + 1) * sizeof(*tmp)))) hr = E_OUTOFMEMORY;
+    else
+    {
+        impl->handlers = tmp;
+        if (!impl->running)
+        {
+            radio_get_State(iface, &impl->state);
+            impl->running = TRUE;
+            IRadio_AddRef(iface);
+            if ((thread = CreateThread(NULL, 0, radio_worker, impl, 0, NULL))) CloseHandle(thread);
+            else
+            {
+                hr = HRESULT_FROM_WIN32(GetLastError());
+                impl->running = FALSE;
+                IRadio_Release(iface);
+            }
+        }
+        if (SUCCEEDED(hr))
+        {
+            token->value = ++impl->next_token;
+            impl->handlers[impl->count].token = *token;
+            impl->handlers[impl->count].handler = handler;
+            impl->handlers[impl->count].agile = agile;
+            impl->count++;
+            ITypedEventHandler_Radio_IInspectable_AddRef(handler);
+        }
+    }
+    LeaveCriticalSection(&impl->cs);
+    if (FAILED(hr) && agile) IAgileReference_Release(agile);
+    return hr;
+}
+static HRESULT WINAPI radio_remove_StateChanged( IRadio *iface, EventRegistrationToken token )
+{
+    struct radio *impl = impl_from_IRadio(iface);
+    ITypedEventHandler_Radio_IInspectable *handler = NULL;
+    IAgileReference *agile = NULL;
+    unsigned int i;
+    EnterCriticalSection(&impl->cs);
+    for (i = 0; i < impl->count; i++) if (impl->handlers[i].token.value == token.value)
+    {
+        handler = impl->handlers[i].handler;
+        agile = impl->handlers[i].agile;
+        memmove(&impl->handlers[i], &impl->handlers[i + 1], (--impl->count - i) * sizeof(*impl->handlers));
+        break;
+    }
+    LeaveCriticalSection(&impl->cs);
+    if (handler) ITypedEventHandler_Radio_IInspectable_Release(handler);
+    if (agile) IAgileReference_Release(agile);
+    return S_OK;
+}
+static const IRadioVtbl radio_vtbl =
+{
+    radio_QueryInterface, radio_AddRef, radio_Release,
+    radio_GetIids, radio_GetRuntimeClassName, radio_GetTrustLevel,
+    radio_SetStateAsync, radio_add_StateChanged, radio_remove_StateChanged,
+    radio_get_State, radio_get_Name, radio_get_Kind
+};
+HRESULT bluetooth_radio_create( HANDLE handle, IRadio **out )
+{
+    struct radio *impl;
+    HRESULT hr;
+    *out = NULL;
+    if (!(impl = calloc(1, sizeof(*impl)))) return E_OUTOFMEMORY;
+    if (!DuplicateHandle(GetCurrentProcess(), handle, GetCurrentProcess(), &impl->handle, 0, FALSE, DUPLICATE_SAME_ACCESS))
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        free(impl);
+        return hr;
+    }
+    if (!(impl->stop = CreateEventW(NULL, TRUE, FALSE, NULL)))
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        CloseHandle(impl->handle);
+        free(impl);
+        return hr;
+    }
+    InitializeCriticalSection(&impl->cs);
+    impl->IRadio_iface.lpVtbl = &radio_vtbl;
+    impl->ref = 1;
+    *out = &impl->IRadio_iface;
+    return S_OK;
+}
