+static NTSTATUS bluez_gatt_acquire_notify( void *connection, void *watcher_ctx, const char *path,
+                                           struct winebth_gatt_params *params )
+{
+    struct bluez_watcher_ctx *ctx = watcher_ctx;
+    struct bluez_notification *notification;
+    DBusMessage *request, *reply = NULL;
+    DBusMessageIter args, options;
+    DBusError error;
+    NTSTATUS status;
+    int fd = -1;
+    dbus_uint16_t mtu = 0;
+
+    /* Drop any previous subscription for this characteristic (e.g. across a reconnect). */
+    bluez_gatt_release_notify( watcher_ctx, path );
+
+    request = p_dbus_message_new_method_call( BLUEZ_DEST, path, BLUEZ_INTERFACE_GATT_CHARACTERISTICS, "AcquireNotify" );
+    if (!request) return STATUS_NO_MEMORY;
+    p_dbus_message_iter_init_append( request, &args );
+    if (!p_dbus_message_iter_open_container( &args, DBUS_TYPE_ARRAY, "{sv}", &options ) ||
+        !p_dbus_message_iter_close_container( &args, &options ))
+    {
+        p_dbus_message_unref( request );
+        return STATUS_NO_MEMORY;
+    }
+
+    TRACE( "Sending AcquireNotify to %s (cccd %u).\n", debugstr_a( path ), params->cccd );
+    p_dbus_error_init( &error );
+    status = bluez_dbus_send_and_wait_for_reply( connection, request, &reply, &error );
+    TRACE( "AcquireNotify on %s returned %#x.\n", debugstr_a( path ), status );
+    if (p_dbus_error_is_set( &error ))
+    {
+        WARN( "AcquireNotify on %s failed: %s: %s\n", debugstr_a( path ),
+              debugstr_a( error.name ), debugstr_a( error.message ) );
+        status = bluez_gatt_error_to_status( &error );
+        /* Subscribing to an encrypted characteristic fails until the device is bonded;
+         * pair on demand, as the Windows stack would have done, and let the app retry. */
+        if (status == STATUS_BTH_ATT_INSUFFICIENT_AUTHENTICATION ||
+            status == STATUS_BTH_ATT_INSUFFICIENT_AUTHORIZATION)
+        {
+            char device[512];
+            device_path_from_object( path, device, sizeof(device) );
+            TRACE( "AcquireNotify needs security, pairing %s\n", debugstr_a( device ) );
+            bluez_device_auto_pair_dispatch( connection, watcher_ctx, device );
+        }
+        p_dbus_error_free( &error );
+    }
+    if (!status)
+    {
+        if (!reply || !p_dbus_message_iter_init( reply, &args ) ||
+            p_dbus_message_iter_get_arg_type( &args ) != DBUS_TYPE_UNIX_FD)
+            status = STATUS_INTERNAL_ERROR;
+        else
+        {
+            /* libdbus returns a caller-owned duplicate of the descriptor (it is not closed
+             * when the message is freed) and preserves close-on-exec, so take it directly. */
+            p_dbus_message_iter_get_basic( &args, &fd );
+            if (fd < 0) status = STATUS_INTERNAL_ERROR;
+            else if (p_dbus_message_iter_next( &args ) &&
+                     p_dbus_message_iter_get_arg_type( &args ) == DBUS_TYPE_UINT16)
+                p_dbus_message_iter_get_basic( &args, &mtu );
+        }
+    }
+    if (reply) p_dbus_message_unref( reply );
+    if (status)
+    {
+        if (fd >= 0) close( fd );
+        return status;
+    }
+
+    if (!(notification = calloc( 1, sizeof(*notification) ))) { close( fd ); return STATUS_NO_MEMORY; }
+    notification->fd = fd;
+    notification->stop_pipe[0] = notification->stop_pipe[1] = -1;
+    notification->ctx = ctx;
+    notification->characteristic = unix_name_get_or_create( path );
+    if (!notification->characteristic || pipe( notification->stop_pipe ))
+    {
+        if (notification->characteristic) unix_name_free( notification->characteristic );
+        close( fd );
+        free( notification );
+        return STATUS_NO_MEMORY;
+    }
+    list_add_tail( &ctx->notifications, &notification->entry );
+    if (pthread_create( &notification->thread, NULL, bluez_notification_thread, notification ))
+    {
+        list_remove( &notification->entry );
+        close( notification->stop_pipe[0] );
+        close( notification->stop_pipe[1] );
+        unix_name_free( notification->characteristic );
+        close( fd );
+        free( notification );
+        return STATUS_INTERNAL_ERROR;
+    }
+
+    params->size = mtu;
+    TRACE( "AcquireNotify subscription active for %s: fd %d, mtu %u, cccd %u\n",
+           debugstr_a( path ), fd, mtu, params->cccd );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS bluez_gatt_release_notify( void *watcher_ctx, const char *path )
+{
+    struct bluez_watcher_ctx *ctx = watcher_ctx;
+    struct bluez_notification *notification, *next;
+
+    if (!ctx) return STATUS_SUCCESS;
+    LIST_FOR_EACH_ENTRY_SAFE( notification, next, &ctx->notifications, struct bluez_notification, entry )
+    {
+        if (strcmp( notification->characteristic->str, path )) continue;
+        TRACE( "Releasing AcquireNotify subscription for %s\n", debugstr_a( path ) );
+        list_remove( &notification->entry );
+        bluez_notification_stop( notification );
+        break;
+    }
+    return STATUS_SUCCESS;
+}
