+#define IOCTL_WINEBTH_DEVICE_SET_MAINTAIN CTL_CODE(FILE_DEVICE_BLUETOOTH, 0xb3, METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define WINEBTH_LE_ROLE_CENTRAL 1
+#define WINEBTH_LE_ROLE_PERIPHERAL 2
+
+struct winebth_le_state
+{
+    UINT32 connected;
+    UINT32 services_resolved;
+    char name[248];
+    /* Bumped whenever the GATT service database changes, even while
+     * services_resolved stays set. */
+    UINT32 service_generation;
+    /* Bumped for every new advertisement, so callers can tell a reachable
+     * device from one that merely has an entry cached. */
+    UINT64 advertisement_sequence;
+};
+
+enum winebth_gatt_operation
+{
+    WINEBTH_GATT_READ,
+    WINEBTH_GATT_WRITE,
+    WINEBTH_GATT_WRITE_COMMAND,
+    WINEBTH_GATT_START_NOTIFY,
+    WINEBTH_GATT_STOP_NOTIFY,
+    WINEBTH_GATT_POLL,
+    WINEBTH_GATT_GET_MTU,
+    /* Read the active GattClientCharacteristicConfigurationDescriptorValue into params->cccd. */
+    WINEBTH_GATT_READ_CCCD,
