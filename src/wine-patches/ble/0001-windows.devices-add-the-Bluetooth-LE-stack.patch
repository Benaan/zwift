+static HRESULT WINAPI characteristic3_WriteValueWithResultAndOptionAsync( IGattCharacteristic3 *iface, IBuffer *buffer,
+                                                                         GattWriteOption option, IAsyncOperation_GattWriteResult **out )
+{
+    if (!buffer) return E_POINTER;
+    if (option != GattWriteOption_WriteWithResponse && option != GattWriteOption_WriteWithoutResponse) return E_INVALIDARG;
+    return characteristic_async(&impl_from_IGattCharacteristic3(iface)->IGattCharacteristic_iface,
+             option == GattWriteOption_WriteWithResponse ? WINEBTH_GATT_WRITE : WINEBTH_GATT_WRITE_COMMAND,
+             buffer, 0, TRUE, &IID_IAsyncOperation_GattWriteResult, (void **)out);
+}
