+static void test_gatt_characteristics( IGattDeviceService *service )
+{
+    IVectorView_GattCharacteristic *chars;
+    IGattDeviceService2 *service2;
+    UINT32 count, i;
+    HRESULT hr;
+
+    hr = IGattDeviceService_QueryInterface(service, &IID_IGattDeviceService2, (void **)&service2);
+    if (hr == E_NOINTERFACE) { win_skip("IGattDeviceService2 unavailable.\n"); return; }
+    ok(hr == S_OK, "Got %#lx.\n", hr);
+    if (FAILED(hr)) return;
+    hr = IGattDeviceService2_GetAllCharacteristics(service2, &chars);
+    ok(hr == S_OK, "GetAllCharacteristics returned %#lx.\n", hr);
+    IGattDeviceService2_Release(service2);
+    if (FAILED(hr)) return;
+    hr = IVectorView_GattCharacteristic_get_Size(chars, &count);
+    ok(hr == S_OK, "Got %#lx.\n", hr);
+    for (i = 0; i < count; i++)
+    {
+        IVectorView_GattCharacteristic *matching;
+        IGattCharacteristic *characteristic;
+        IGattCharacteristic2 *characteristic2;
+        IGattDeviceService *parent;
+        GattCharacteristicProperties props;
+        GattProtectionLevel protection;
+        UINT16 handle, parent_handle, expected_handle;
+        UINT32 matches;
+        GUID uuid;
+
+        hr = IVectorView_GattCharacteristic_GetAt(chars, i, &characteristic);
+        ok(hr == S_OK, "GetAt returned %#lx.\n", hr);
+        if (FAILED(hr)) continue;
+        hr = IGattCharacteristic_get_Uuid(characteristic, &uuid);
+        ok(hr == S_OK, "get_Uuid returned %#lx.\n", hr);
+        hr = IGattCharacteristic_get_AttributeHandle(characteristic, &handle);
+        ok(hr == S_OK && handle, "get_AttributeHandle returned %#lx, handle %u.\n", hr, handle);
+        hr = IGattCharacteristic_get_CharacteristicProperties(characteristic, &props);
+        ok(hr == S_OK, "get_CharacteristicProperties returned %#lx.\n", hr);
+        hr = IGattCharacteristic_get_ProtectionLevel(characteristic, &protection);
+        ok(hr == S_OK, "get_ProtectionLevel returned %#lx.\n", hr);
+        hr = IGattDeviceService_GetCharacteristics(service, uuid, &matching);
+        ok(hr == S_OK, "GetCharacteristics returned %#lx.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            IVectorView_GattCharacteristic_get_Size(matching, &matches);
+            ok(matches > 0, "UUID lookup returned no characteristics.\n");
+            IVectorView_GattCharacteristic_Release(matching);
+        }
+        hr = IGattCharacteristic_QueryInterface(characteristic, &IID_IGattCharacteristic2, (void **)&characteristic2);
+        ok(hr == S_OK, "QueryInterface returned %#lx.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            hr = IGattCharacteristic2_get_Service(characteristic2, &parent);
+            ok(hr == S_OK, "get_Service returned %#lx.\n", hr);
+            if (SUCCEEDED(hr))
+            {
+                IGattDeviceService_get_AttributeHandle(parent, &parent_handle);
+                IGattDeviceService_get_AttributeHandle(service, &expected_handle);
+                ok(parent_handle == expected_handle, "Wrong parent %u, expected %u.\n", parent_handle, expected_handle);
+                IGattDeviceService_Release(parent);
+            }
+            IGattCharacteristic2_Release(characteristic2);
+        }
+        IGattCharacteristic_Release(characteristic);
+    }
+    IVectorView_GattCharacteristic_Release(chars);
+}
