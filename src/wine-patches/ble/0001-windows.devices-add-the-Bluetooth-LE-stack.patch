+static void watcher_invoke( struct adv_watcher *impl, struct list *list, IInspectable *args, BOOL received )
+{
+    struct watcher_handler *entry, *snapshot = NULL;
+    UINT32 count = 0, i = 0;
+
+    EnterCriticalSection( &impl->cs );
+    LIST_FOR_EACH_ENTRY( entry, list, struct watcher_handler, entry ) count++;
+    if (count) snapshot = calloc( count, sizeof(*snapshot) );
+    if (snapshot)
+        LIST_FOR_EACH_ENTRY( entry, list, struct watcher_handler, entry )
+        {
+            snapshot[i] = *entry;
+            IUnknown_AddRef( snapshot[i].handler );
+            if (snapshot[i].agile) IAgileReference_AddRef( snapshot[i].agile );
+            i++;
+        }
+    LeaveCriticalSection( &impl->cs );
+    if (!snapshot) return;
+
+    for (i = 0; i < count; i++)
+    {
+        /* Resolve the handler in this apartment so a non-agile one is invoked
+         * through a proxy on its own apartment instead of directly. */
+        ITypedEventHandler_IInspectable_IInspectable *handler =
+            (ITypedEventHandler_IInspectable_IInspectable *)snapshot[i].handler;
+        void *resolved = NULL;
+        BOOL invoke;
+
+        if (snapshot[i].agile &&
+            SUCCEEDED(IAgileReference_Resolve( snapshot[i].agile, snapshot[i].iid, &resolved )))
+            handler = (ITypedEventHandler_IInspectable_IInspectable *)resolved;
+
+        EnterCriticalSection( &impl->cs );
+        invoke = !received || impl->status == BluetoothLEAdvertisementWatcherStatus_Started;
+        LeaveCriticalSection( &impl->cs );
+        if (invoke)
+            ITypedEventHandler_IInspectable_IInspectable_Invoke( handler,
+                            (IInspectable *)&impl->IBluetoothLEAdvertisementWatcher_iface, args );
+
+        if (resolved) IUnknown_Release( (IUnknown *)resolved );
+        IUnknown_Release( snapshot[i].handler );
+        if (snapshot[i].agile) IAgileReference_Release( snapshot[i].agile );
+    }
+    free( snapshot );
+}
