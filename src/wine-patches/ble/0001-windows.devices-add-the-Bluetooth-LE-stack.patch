+    IVectorView_GattCharacteristic *view = NULL;
+    IGattCharacteristicsResult *result;
+    GUID uuid, *filter = NULL;
+    HRESULT hr;
+    if (!called_async) return STATUS_PENDING;
+    if (param)
+    {
+        if (FAILED(hr = IPropertyValue_GetGuid((IPropertyValue *)param, &uuid))) return hr;
+        filter = &uuid;
+    }
+    hr = service_characteristics(impl, filter, &view);
+    hr = gatt_chars_result_create(hr, view, &result);
+    if (view) IVectorView_GattCharacteristic_Release(view);
+    if (FAILED(hr)) return hr;
+    out->vt = VT_UNKNOWN;
+    out->punkVal = (IUnknown *)result;
