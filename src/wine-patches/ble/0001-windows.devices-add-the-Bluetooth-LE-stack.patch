+/* Sessions can be created before any services have been discovered. */
+HRESULT bluetooth_session_from_id( HSTRING id, IGattSession **out )
+{
+    char buffer[sizeof(SP_DEVICE_INTERFACE_DETAIL_DATA_W) + MAX_PATH * sizeof(WCHAR)];
+    SP_DEVICE_INTERFACE_DETAIL_DATA_W *detail = (void *)buffer;
+    SP_DEVICE_INTERFACE_DATA iface = {.cbSize = sizeof(iface)};
+    SP_DEVINFO_DATA data = {.cbSize = sizeof(data)};
+    IBluetoothLEDevice *device;
+    struct ble_device *impl;
+    DEVPROPTYPE type;
+    WCHAR address[13];
+    HDEVINFO devinfo;
+    UINT64 addr;
+    HRESULT hr;
+
+    *out = NULL;
+    if ((devinfo = SetupDiCreateDeviceInfoList(NULL, NULL)) == INVALID_HANDLE_VALUE)
+        return HRESULT_FROM_WIN32(GetLastError());
+    detail->cbSize = sizeof(*detail);
+    if (!SetupDiOpenDeviceInterfaceW(devinfo, WindowsGetStringRawBuffer(id, NULL), 0, &iface) ||
+        !SetupDiGetDeviceInterfaceDetailW(devinfo, &iface, detail, sizeof(buffer), NULL, &data) ||
+        !SetupDiGetDevicePropertyW(devinfo, &data, &DEVPKEY_Bluetooth_DeviceAddress, &type,
+                                  (BYTE *)address, sizeof(address), NULL, 0))
+        hr = HRESULT_FROM_WIN32(GetLastError());
+    else if (swscanf(address, L"%I64x", &addr) != 1) hr = E_INVALIDARG;
+    else if (SUCCEEDED(hr = ble_device_create(&device, detail->DevicePath, addr, FALSE)))
+    {
+        impl = impl_from_IBluetoothLEDevice(device);
+        hr = gatt_session_create(impl->device, device, 0, out);
+        IBluetoothLEDevice_Release(device);
+    }
+    SetupDiDestroyDeviceInfoList(devinfo);
+    return hr;
+}
