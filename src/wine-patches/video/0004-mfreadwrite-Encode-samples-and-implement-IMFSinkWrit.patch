+/* Wait until every queued sample was delivered to, and consumed by, the stream sinks.
+ * A stream sink requests a new sample after it processed the previous one, so a stream
+ * is idle once its queue is empty and it has an outstanding request. */
+static HRESULT sink_writer_wait_for_sink(struct sink_writer *writer)
+{
+    unsigned int i;
+    BOOL done;
+    HRESULT hr;
+
+    for (;;)
+    {
+        EnterCriticalSection(&writer->cs);
+        done = TRUE;
+        for (i = 0; i < writer->streams.count; ++i)
+        {
+            struct stream *stream = &writer->streams.items[i];
+
+            sink_writer_process_pending(writer, stream);
+            if (!list_empty(&stream->queue) || !stream->stats.dwNumOutstandingSinkSampleRequests)
+                done = FALSE;
+        }
+        hr = writer->status;
+        LeaveCriticalSection(&writer->cs);
+
+        if (done || FAILED(hr))
+            return hr;
+
+        if (WaitForSingleObject(writer->sink_event, SINK_WRITER_FINALIZE_TIMEOUT_MS) != WAIT_OBJECT_0)
+        {
+            WARN("Timed out waiting for the media sink to consume queued samples.\n");
+            return HRESULT_FROM_WIN32(ERROR_TIMEOUT);
+        }
+    }
+}
+
+static HRESULT sink_writer_finalize_sink(struct sink_writer *writer)
+{
+    IMFFinalizableMediaSink *sink;
+    HRESULT hr;
+
+    if (FAILED(IMFMediaSink_QueryInterface(writer->sink, &IID_IMFFinalizableMediaSink, (void **)&sink)))
+        return S_OK;
+
+    ResetEvent(writer->finalize_event);
+    writer->finalize_status = E_PENDING;
+    if (SUCCEEDED(hr = IMFFinalizableMediaSink_BeginFinalize(sink, &writer->finalize_callback, (IUnknown *)sink)))
+    {
+        if (WaitForSingleObject(writer->finalize_event, SINK_WRITER_FINALIZE_TIMEOUT_MS) == WAIT_OBJECT_0)
+            hr = writer->finalize_status;
+        else
+        {
+            WARN("Timed out waiting for the media sink to finalize.\n");
+            hr = HRESULT_FROM_WIN32(ERROR_TIMEOUT);
+        }
+    }
+
+    IMFFinalizableMediaSink_Release(sink);
+    return hr;
+}
+
 static HRESULT WINAPI sink_writer_Finalize(IMFSinkWriterEx *iface)
 {
-    FIXME("%p.\n", iface);
+    struct sink_writer *writer = impl_from_IMFSinkWriterEx(iface);
+    HRESULT hr = S_OK, tmp_hr;
+    unsigned int i;
 
-    return E_NOTIMPL;
+    TRACE("%p.\n", iface);
+
+    EnterCriticalSection(&writer->cs);
+
+    if (writer->state != SINK_WRITER_STATE_WRITING)
+    {
+        LeaveCriticalSection(&writer->cs);
+        return MF_E_INVALIDREQUEST;
+    }
+
+    /* No more samples are accepted from now on. */
+    writer->state = SINK_WRITER_STATE_FINALIZED;
+
+    for (i = 0; i < writer->streams.count; ++i)
+    {
+        struct stream *stream = &writer->streams.items[i];
+
+        if (FAILED(tmp_hr = stream_drain_transforms(stream)))
+        {
+            WARN("Failed to drain stream %u, hr %#lx.\n", i, tmp_hr);
+            if (SUCCEEDED(hr)) hr = tmp_hr;
+        }
+        sink_writer_process_pending(writer, stream);
+    }
+
+    LeaveCriticalSection(&writer->cs);
+
+    /* Waiting is done without holding the lock, sink events need it. */
+    if (FAILED(tmp_hr = sink_writer_wait_for_sink(writer)) && SUCCEEDED(hr))
+        hr = tmp_hr;
+
+    if (FAILED(tmp_hr = sink_writer_finalize_sink(writer)))
+    {
+        WARN("Failed to finalize the media sink, hr %#lx.\n", tmp_hr);
+        if (SUCCEEDED(hr)) hr = tmp_hr;
+    }
+
+    EnterCriticalSection(&writer->cs);
+
+    if (writer->clock)
+        IMFPresentationClock_Stop(writer->clock);
+
+    /* Shutting down the sink closes the output file and releases pending event callbacks. */
+    IMFMediaSink_Shutdown(writer->sink);
+
+    for (i = 0; i < writer->streams.count; ++i)
+        sink_writer_drop_pending_items(&writer->streams.items[i]);
+
+    LeaveCriticalSection(&writer->cs);
+
+    if (writer->callback)
+        IMFSinkWriterCallback_OnFinalize(writer->callback, hr);
+
+    TRACE("Finalized, hr %#lx.\n", hr);
+
+    return hr;
 }
 
