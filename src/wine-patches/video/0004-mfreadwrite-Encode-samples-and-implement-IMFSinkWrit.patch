+static unsigned int stream_get_transform_chain(struct stream *stream, IMFTransform **chain)
+{
+    unsigned int count = 0;
+
+    if (stream->converter)
+        chain[count++] = stream->converter;
+    if (stream->encoder)
+        chain[count++] = stream->encoder;
+
+    return count;
+}
+
+static HRESULT stream_allocate_output_sample(IMFTransform *transform, IMFSample **out)
+{
+    MFT_OUTPUT_STREAM_INFO info = {0};
+    IMFMediaBuffer *buffer;
+    IMFSample *sample;
+    HRESULT hr;
+
+    *out = NULL;
+
+    if (FAILED(hr = IMFTransform_GetOutputStreamInfo(transform, 0, &info)))
+        return hr;
+    if (info.dwFlags & (MFT_OUTPUT_STREAM_PROVIDES_SAMPLES | MFT_OUTPUT_STREAM_CAN_PROVIDE_SAMPLES))
+        return S_OK;
+
+    if (FAILED(hr = MFCreateSample(&sample)))
+        return hr;
+    if (FAILED(hr = MFCreateAlignedMemoryBuffer(max(info.cbSize, 1),
+            info.cbAlignment ? info.cbAlignment - 1 : 0, &buffer)))
+    {
+        IMFSample_Release(sample);
+        return hr;
+    }
+    hr = IMFSample_AddBuffer(sample, buffer);
+    IMFMediaBuffer_Release(buffer);
+    if (FAILED(hr))
+    {
+        IMFSample_Release(sample);
+        return hr;
+    }
+
+    *out = sample;
+    return S_OK;
+}
+
+static HRESULT stream_push_sample(struct stream *stream, IMFTransform **chain, unsigned int count,
+        unsigned int level, IMFSample *sample);
+
+/* Pull all available output from chain[level] and push it further down the chain. */
+static HRESULT stream_pull_output(struct stream *stream, IMFTransform **chain, unsigned int count,
+        unsigned int level)
+{
+    IMFTransform *transform = chain[level];
+    MFT_OUTPUT_DATA_BUFFER output;
+    unsigned int iterations;
+    IMFMediaType *type;
+    DWORD status;
+    HRESULT hr;
+
+    for (iterations = 0; iterations < 4096; ++iterations)
+    {
+        memset(&output, 0, sizeof(output));
+        if (FAILED(hr = stream_allocate_output_sample(transform, &output.pSample)))
+            return hr;
+
+        status = 0;
+        hr = IMFTransform_ProcessOutput(transform, 0, 1, &output, &status);
+        if (output.pEvents)
+            IMFCollection_Release(output.pEvents);
+
+        if (hr == MF_E_TRANSFORM_STREAM_CHANGE)
+        {
+            if (output.pSample)
+                IMFSample_Release(output.pSample);
+            if (FAILED(hr = IMFTransform_GetOutputAvailableType(transform, 0, 0, &type)))
+                return hr;
+            hr = IMFTransform_SetOutputType(transform, 0, type, 0);
+            IMFMediaType_Release(type);
+            if (FAILED(hr))
+                return hr;
+            continue;
+        }
+
+        if (FAILED(hr))
+        {
+            if (output.pSample)
+                IMFSample_Release(output.pSample);
+            return hr == MF_E_TRANSFORM_NEED_MORE_INPUT ? S_OK : hr;
+        }
+
+        if (!output.pSample)
+            continue;
+
+        hr = stream_push_sample(stream, chain, count, level + 1, output.pSample);
+        IMFSample_Release(output.pSample);
+        if (FAILED(hr))
+            return hr;
+    }
+
+    WARN("Transform %p keeps producing output, giving up.\n", transform);
+    return S_OK;
+}
+
+/* Feed a sample to chain[level]; at the end of the chain the sample is queued for the stream sink. */
+static HRESULT stream_push_sample(struct stream *stream, IMFTransform **chain, unsigned int count,
+        unsigned int level, IMFSample *sample)
+{
+    HRESULT hr;
+
+    if (level == count)
+        return stream_queue_sample(stream, sample);
+
+    hr = IMFTransform_ProcessInput(chain[level], 0, sample, 0);
+    if (hr == MF_E_NOTACCEPTING)
+    {
+        if (FAILED(hr = stream_pull_output(stream, chain, count, level)))
+            return hr;
+        hr = IMFTransform_ProcessInput(chain[level], 0, sample, 0);
+    }
+    if (FAILED(hr))
+    {
+        WARN("Failed to process input on transform %p, hr %#lx.\n", chain[level], hr);
+        return hr;
+    }
+
+    return stream_pull_output(stream, chain, count, level);
+}
+
+/* Drain every transform of the stream, in order, queueing everything they still hold. */
+static HRESULT stream_drain_transforms(struct stream *stream)
+{
+    IMFTransform *chain[2];
+    unsigned int count, level;
+    HRESULT hr;
+
+    count = stream_get_transform_chain(stream, chain);
+    for (level = 0; level < count; ++level)
+    {
+        IMFTransform_ProcessMessage(chain[level], MFT_MESSAGE_NOTIFY_END_OF_STREAM, 0);
+        IMFTransform_ProcessMessage(chain[level], MFT_MESSAGE_COMMAND_DRAIN, 0);
+        if (FAILED(hr = stream_pull_output(stream, chain, count, level)))
+            return hr;
+    }
+
+    return S_OK;
+}
+
+static HRESULT sink_writer_encode_sample(struct sink_writer *writer, struct stream *stream, IMFSample *sample)
+{
+    IMFTransform *chain[2];
+    unsigned int count;
+
+    count = stream_get_transform_chain(stream, chain);
+    return stream_push_sample(stream, chain, count, 0, sample);
+}
+
+/* Send queued samples to the stream sink for as long as it has outstanding requests. */
+static HRESULT sink_writer_process_pending(struct sink_writer *writer, struct stream *stream)
+{
+    struct pending_item *item;
+    HRESULT hr = S_OK;
+
+    while (SUCCEEDED(hr) && stream->stats.dwNumOutstandingSinkSampleRequests && !list_empty(&stream->queue))
+    {
+        item = LIST_ENTRY(list_head(&stream->queue), struct pending_item, entry);
+        if (!item->sample)
+        {
+            sink_writer_place_marker(writer, stream, item->marker_type, item->timestamp, item->user_context);
+            sink_writer_release_pending_item(item);
+            continue;
+        }
+        hr = sink_writer_process_sample(writer, stream);
+    }
+
+    return hr;
+}
